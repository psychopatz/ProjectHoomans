          },
          "expect": {
            "operation.status": "ok",
            "result.transferred": {
              "minCount": 1
            }
          }
        },
        {
          "action": "knowledge.inspect",
          "payload": {
            "actorID": "actor:bob"
          },
          "expect": {
            "operation.status": "ok",

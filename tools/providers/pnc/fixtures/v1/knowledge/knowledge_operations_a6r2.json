{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.knowledge.operations",
  "domain": "knowledge",
  "cases": [
    {
      "id": "knowledge.ops.discover_metrics_and_bootstrap",
      "description": "Verify knowledge.discover, knowledge.metrics, and knowledge.bootstrap against production Lua.",
      "tags": ["knowledge", "operations"],
      "scenario": {
        "player": {"characterUUID": "char-h4-a"},
        "npc": {
          "npcID": "npc-h4-grounded",
          "identitySeed": 90210,
          "identity": {"seed": 90210},
          "tacticalClass": "colonist",
          "relationship": {"familiarity": 80}
        }
      },
      "turns": [
        {
          "action": "knowledge.discover",
          "payload": {"topicID": "backstory.former_job"},
          "expect": {
            "operation.status": "ok",
            "result.ok": true
          }
        },
        {
          "action": "knowledge.metrics",
          "payload": {"syntheticNPCs": 0, "factsPerNPC": 1},
          "expect": {
            "operation.status": "ok",
            "result.npcCount": 1,
            "result.evidenceCount": 1,
            "result.knowledgeStorageBytes": {"min": 1},
            "result.serializedBytes": {"min": 1}
          }
        },
        {
          "action": "knowledge.bootstrap",
          "payload": {"requestID": "a6r2-bootstrap"},
          "expect": {
            "operation.status": "ok"
          }
        }
      ]
    }
  ]
}

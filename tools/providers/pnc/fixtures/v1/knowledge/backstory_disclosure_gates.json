            "observation.authoritativeMessages.0.text": "I worked as farmer before all this.",
            "contextAfter.knowledge.npcID": "npc-backstory-grounded"
          }
        }
      ],
      "domain": "knowledge"
    },
    {
      "id": "knowledge.backstory_disclosure_gates.withdrawn_personality_refuses_at_medium_familiarity",
      "description": "Withdrawn socialStyle refuses former_job at familiarity 40.",
      "tags": ["knowledge", "backstory", "personality", "refusal"],
      "scenario": {
        "npc": {
          "npcID": "npc-backstory-grounded",

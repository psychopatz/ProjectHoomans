      "tags": [
        "interaction",
        "identity",
        "wellbeing",
        "multi_turn"
      ],
      "turns": [
        {
          "text": "who are you",
          "expect": {
            "contextAfter.dialogue.pendingIdentityExchange.kind": "PLAYER_NAME"
          }
        },
        {
          "text": "im fine thanks",
          "expect": {
            "ir.subject": "WELLBEING",
            "decision.branch": "SELF_STATE_RECEIVED",
            "relationshipAfter.identityTrust": "unknown",
            "contextAfter.dialogue.pendingIdentityExchange.kind": "PLAYER_NAME"
          }
        }
      ],
      "domain": "interaction"
    },

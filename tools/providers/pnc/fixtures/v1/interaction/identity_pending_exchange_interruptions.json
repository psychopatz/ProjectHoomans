        },
        {
          "suggestionClick": {"candidateID": "identity.choice.real_name"},
          "expect": {
            "accepted": true,
            "messages.0.payload.text": {"contains": "Mara"},
            "relationshipAfter.identityTrust": "trusted",
            "contextAfter.dialogue.pendingIdentityExchange": {"absent": true}
          }
        }
      ],

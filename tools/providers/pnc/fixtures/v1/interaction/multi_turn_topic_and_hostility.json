{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.interaction.multi_turn_topic_and_hostility",
  "domain": "interaction",
  "cases": [
    {
      "id": "interaction.multi_turn_topic_and_hostility.npc_question_player_not_really",
      "tags": [
        "interaction",
        "multi_turn",
        "social"
      ],
      "description": "NPC greeting flow followed by player short disagreement",
      "turns": [
        {
          "text": "hello there",
          "expect": {
            "ir.intent": "GREET",
            "response.exists": true
          }
        },
        {
          "text": "not really",
          "expect": {
            "ir.intent": "DISAGREE",
            "ir.subject": "greeting",
            "ir.extensions.topic": "greeting",
            "ir.extensions.discourseFrame.topic": "greeting",
            "ir.extensions.discourseFrame.topicSource": "pending_interaction",
            "ir.extensions.discourseFrame.subjectSource": "pending_interaction",
            "ir.extensions.discourseFrame.replyTo.kind": "pending_interaction",
            "ir.extensions.discourseFrame.replyTo.flowID": "greeting",
            "ir.extensions.discourseFrame.contextualSupport": {
              "min": 0.01
            },
            "candidateDiagnostics.reason": "contextual_discourse_candidate",
            "decision.flow.topic": "greeting",
            "decision.branch": "SOCIAL_ACKNOWLEDGED",
            "response.templateID": "social.acknowledged"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.pending_question_contextual_skepticism",
      "tags": [
        "interaction",
        "multi_turn",
        "social",
        "disagree",
        "skeptical"
      ],
      "description": "NPC greeting flow followed by player short skeptical disagreement",
      "turns": [
        {
          "text": "hello there",
          "expect": {
            "ir.intent": "GREET"
          }
        },
        {
          "text": "yeah right",
          "expect": {
            "ir.intent": "DISAGREE",
            "ir.modifiers.skeptical": true,
            "ir.subject": "greeting",
            "ir.extensions.discourseFrame.replyTo.kind": "pending_interaction",
            "ir.extensions.discourseFrame.topic": "greeting"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.hostility_then_apology",
      "tags": [
        "interaction",
        "multi_turn",
        "hostility",
        "apology"
      ],
      "description": "Hostility followed by an apology and de-escalation",
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "ir.intent": "INSULT",
            "dispatchTransport": {
              "count": 0
            },
            "toolCalls": {
              "count": 0
            }
          }
        },
        {
          "text": "sorry",
          "expect": {
            "ir.intent": "APOLOGIZE",
            "decision.branch": "SOCIAL_ACKNOWLEDGED",
            "response.templateID": "social.apology.friendly"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.hostility_then_continued_challenge",
      "tags": [
        "interaction",
        "multi_turn",
        "hostility",
        "challenge"
      ],
      "description": "Hostility followed by a skeptical short utterance",
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "ir.intent": "INSULT",
            "dispatchTransport": {
              "count": 0
            }
          }
        },
        {
          "text": "yeah right",
          "expect": {
            "ir.intent": "DISAGREE",
            "decision.branch": "SOCIAL_ACKNOWLEDGED",
            "response.templateID": "social.acknowledged"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.topic_continuation",
      "tags": [
        "interaction",
        "multi_turn",
        "topic",
        "time",
        "date"
      ],
      "description": "Adjacent time and date queries across consecutive turns",
      "turns": [
        {
          "text": "what time is it",
          "expect": {
            "ir.subject": "TIME",
            "response.templateID": "semantic.question.time"
          }
        },
        {
          "text": "what day is it",
          "expect": {
            "ir.subject": "DATE",
            "response.templateID": "semantic.question.date"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.topic_change",
      "tags": [
        "interaction",
        "multi_turn",
        "topic",
        "wellbeing"
      ],
      "description": "Time question followed by wellbeing query",
      "turns": [
        {
          "text": "what time is it",
          "expect": {
            "ir.subject": "TIME",
            "response.templateID": "semantic.question.time"
          }
        },
        {
          "text": "how are you",
          "expect": {
            "ir.subject": "WELLBEING",
            "decision.branch": "QUESTION_RECEIVED"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.topic_interrupt_and_resume_discourse_state",
      "tags": [
        "interaction",
        "multi_turn",
        "topic",
        "interruption",
        "resumption"
      ],
      "scenario": {
        "npc": {
          "needs": {
            "hunger": 0.9
          }
        },
        "world": {
          "weather": "rain"
        }
      },
      "turns": [
        {
          "text": "do you need anything",
          "expect": {
            "ir.intent": "QUESTION"
          }
        },
        {
          "text": "how many",
          "expect": {
            "ir.intent": "QUESTION"
          }
        },
        {
          "text": "i will get some",
          "expect": {
            "accepted": true
          }
        },
        {
          "text": "what is the weather",
          "expect": {
            "contextAfter.dialogue.currentTopic": "weather",
            "contextAfter.dialogue.previousTopic": "needs",
            "ir.extensions.contextualFollowUp.status": "interrupted",
            "contextAfter.dialogue.pendingFollowUp.flowID": "needs"
          }
        },
        {
          "text": "okay",
          "expect": {
            "observation.flow.transition": "resume_match",
            "contextAfter.dialogue.currentTopic": "needs",
            "contextAfter.dialogue.previousTopic": "weather",
            "ir.extensions.contextualFollowUp.status": "matched"
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.referent_reuse_from_prior_semantic_turn",
      "tags": [
        "interaction",
        "multi_turn",
        "reference",
        "residence"
      ],
      "scenario": {
        "npc": {
          "residence": {
            "label": "Riverside Camp"
          }
        }
      },
      "turns": [
        {
          "text": "where is your home",
          "expect": {
            "accepted": true
          }
        },
        {
          "text": "what about it",
          "expect": {
            "ir.target.resolvedReference": "IT",
            "ir.target.concept": "NPC_RESIDENCE",
            "decision.response.selectionSource": "conversation_reference",
            "messages.0.payload.text": {
              "contains": "Riverside Camp"
            }
          }
        }
      ],
      "domain": "interaction"
    },
    {
      "id": "interaction.multi_turn_topic_and_hostility.hostility_repair_beat_transition",
      "tags": [
        "interaction",
        "multi_turn",
        "hostility",
        "apology",
        "beat"
      ],
      "turns": [
        {
          "text": "you are useless",
          "expect": {
            "ir.intent": "INSULT",
            "observation.director.contextAfter.active.id": "beat.argument_escalation"
          }
        },
        {
          "text": "sorry",
          "expect": {
            "ir.intent": "APOLOGIZE",
            "observation.director.exited.id": "beat.argument_escalation",
            "observation.director.entered.id": "beat.reconciliation",
            "observation.director.contextAfter.active.id": "beat.reconciliation"
          }
        }
      ],
      "domain": "interaction"
    }
  ]
}

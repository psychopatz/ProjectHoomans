      "id": "interaction.c0.required_sequence_needs_and_weather_interrupt",
      "description": "C0 required 7-turn contextual conversation advancing needs, quantity, proposal, weather interrupt, and resume.",
      "tags": ["interaction", "multi_turn", "needs", "weather"],
      "scenario": {
        "npc": {
          "healthState": "injured",
          "activeBehavior": "treatment",
          "needs": {},
          "conditionStats": {}
        }
      },
      "turns": [
        {
          "text": "Are you okay?",
          "expect": {
            "ir.subject": "WELLBEING"
          }
        },
        {
          "text": "What happened?",
          "expect": {
            "ir.subject": "WELLBEING"
          }
        },
        {
          "text": "Do you need anything?",
          "expect": {
            "ir.subject": "NEEDS",
            "decision.branch": "QUESTION_RECEIVED",
            "decision.response.templateID": "question.needs.offer.unknown",
            "contextAfter.dialogue.pendingFollowUp.requiredSlots": ["quantity"],
            "dispatchTransport": {"count": 0}
          }
        },
        {
          "text": "How many?",
          "expect": {
            "ir.subject": "QUANTITY",
            "decision.response.templateID": "question.needs.quantity.unknown",
            "contextAfter.dialogue.pendingFollowUp.kind": "PROPOSAL",
            "contextAfter.dialogue.pendingFollowUp.requiredSlots": ["offer"],
            "contextAfter.dialogue.lastFollowUp.status": "fulfilled",
            "dispatchTransport": {"count": 0},
            "toolCalls": {"count": 0},
            "llmCalls": 0
          }
        },
        {
          "text": "I'll get some",
          "expect": {
            "ir.intent": "PROMISE",
            "ir.subject": "NEEDS",
            "ir.action": {"absent": true},
            "decision.response.templateID": "question.needs.proposal.unknown",
            "decision.response.plan.dialogueAct": "PROMISE_ACKNOWLEDGEMENT",
            "contextAfter.dialogue.pendingFollowUp.kind": "PROPOSAL",
            "contextAfter.dialogue.pendingFollowUp.requiredSlots": ["confirmation"],
            "actionResult": {"absent": true}
          }
        },
        {
          "text": "What's the weather?",
          "expect": {
            "ir.subject": "WEATHER",
            "decision.response.templateID": "semantic.flow.weather.clear.default",
            "observation.flow.transition": "interrupt_start",
            "contextAfter.dialogue.currentTopic": "weather",
            "contextAfter.dialogue.pendingFollowUp.kind": "PROPOSAL"
          }
        },
        {
          "text": "Okay",
          "expect": {
            "decision.response.templateID": "question.needs.proposal.unknown",
            "observation.flow.transition": "resume_match"
          }
        }
      ]
    },

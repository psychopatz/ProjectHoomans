    {
      "id": "interaction.continuation_and_clarification_bounds.continuation_paraphrases_follow_previous_topic",
      "description": "Continuation paraphrases follow the previous gossip topic without side effects, while 'give me more food' does not become CONVERSATION_CONTINUATION.",
      "tags": ["interaction", "continuation", "gossip"],
      "turns": [
        {
          "text": "do you have any news",
          "expect": {
            "accepted": true,
            "ir.intent": "GOSSIP"
          }
        },
        {
          "text": "tell me more",
          "expect": {
            "accepted": true,
            "result.decision.route": "deterministic",
            "result.actionResult": {"absent": true},
            "dispatchTransport": {"count": 0},
            "toolCalls": {"count": 0},
            "llmCalls": 0,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "ir.provenance.pattern": {"prefix": "pnc.social.continuation."},
            "result.decision.response.selectionSource": "conversation_context",
            "trace.0.data.classification": "recognized_question",
            "trace.0.data.responseClassification": "grounded_npc_response",
            "messages.0.payload.text": {"contains": "anything else"},
            "contextAfter.dialogue.currentTopic": "gossip"
          }
        },
        {
          "resetConversation": true,
          "text": "do you have any news",
          "expect": {"accepted": true, "ir.intent": "GOSSIP"}
        },
        {
          "text": "can you say more",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "contextAfter.dialogue.currentTopic": "gossip"
          }
        },
        {
          "resetConversation": true,
          "text": "do you have any news",
          "expect": {"accepted": true, "ir.intent": "GOSSIP"}
        },
        {
          "text": "say more",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "contextAfter.dialogue.currentTopic": "gossip"
          }
        },
        {
          "resetConversation": true,
          "text": "do you have any news",
          "expect": {"accepted": true, "ir.intent": "GOSSIP"}
        },
        {
          "text": "what else",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "contextAfter.dialogue.currentTopic": "gossip"
          }
        },
        {
          "resetConversation": true,
          "text": "do you have any news",
          "expect": {"accepted": true, "ir.intent": "GOSSIP"}
        },
        {
          "text": "anything else",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "contextAfter.dialogue.currentTopic": "gossip"
          }
        },
        {
          "resetConversation": true,
          "text": "do you have any news",
          "expect": {"accepted": true, "ir.intent": "GOSSIP"}
        },
        {
          "text": "go on",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "CONVERSATION",
            "ir.extensions.dialogueFollowUp": "CONVERSATION_CONTINUATION",
            "contextAfter.dialogue.currentTopic": "gossip"

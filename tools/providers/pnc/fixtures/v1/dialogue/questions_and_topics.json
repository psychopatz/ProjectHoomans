{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.dialogue.questions_and_topics",
  "domain": "dialogue",
  "cases": [
    {
      "id": "dialogue.questions_and_topics.question_location_direct",
      "tags": [
        "dialogue",
        "question",
        "location"
      ],
      "turns": [
        {
          "text": "Where is John?",
          "expect": {
            "ir.intent": "QUESTION",
            "ir.subject": "LOCATION",
            "ir.target.text": "john",
            "ir.target.unresolved": true
          }
        }
      ],
      "domain": "dialogue"
    },
    {
      "id": "dialogue.questions_and_topics.question_location_find",
      "tags": [
        "dialogue",
        "question",
        "location"
      ],
      "turns": [
        {
          "text": "Where can I find Sarah?",
          "expect": {
            "ir.subject": "LOCATION",
            "ir.target.text": "sarah",
            "ir.pattern": "pnc.question.where_can_find"
          }
        }
      ],
      "domain": "dialogue"
    },
    {

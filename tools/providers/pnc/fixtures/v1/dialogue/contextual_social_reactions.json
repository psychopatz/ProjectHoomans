    {
      "id": "dialogue.contextual_social_reactions.typoed_hostility_keeps_recognized_social_route",
      "description": "Typoed hostility 'fuck ypuuuu' keeps HOSTILE_REMARK, pnc.social.profanity, HOSTILE_REMARK_RECEIVED, and negative relationship effect.",
      "tags": ["dialogue", "social", "hostility", "typo"],
      "turns": [
        {
          "text": "fuck ypuuuu",
          "expect": {
            "accepted": true,
            "ir.intent": "HOSTILE_REMARK",
            "ir.speechAct": "HOSTILE_REMARK",
            "ir.provenance.pattern": "pnc.social.profanity",
            "ir.diagnostics.unresolvedEntity": true,
            "ir.confidence": {"min": 0.85},
            "result.decision.branch": "HOSTILE_REMARK_RECEIVED",
            "result.decision.response.templateID": {"notEquals": "semantic.ask_clarification"},
            "messages.0.payload.text": {"notEquals": "I'm not sure what you mean."},
            "result.actionResult.accepted": true,
            "result.actionResult.status": "applied",
            "result.actionResult.speechAct": "HOSTILE_REMARK",
            "result.actionResult.relationshipDelta.approval": {"max": -1}
          }
        }
      ],
      "domain": "dialogue"
    },
    {
      "id": "dialogue.contextual_social_reactions.rejected_and_unavailable_insults_truthful",
      "description": "Invalid lease rejects insult truthfully; unavailable social transport reports unavailable without relationship delta.",
      "tags": ["dialogue", "social", "insult", "authority"],
      "scenario": {
        "npc": {
          "runtime": {
            "conversationLease": {"token": "authority-token"}
          }
        },
        "conversation": {"token": "client-token"}
      },
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "result.actionResult.accepted": false,
            "result.actionResult.status": "rejected",
            "result.actionResult.reason": "invalid_lease",
            "result.actionResult.authority": "server",
            "messages.0.payload.key": "semantic.social.interaction.rejected",
            "messages.0.payload.text": {"notEquals": "I couldn't do that right now."}
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"runtime": null}, "conversation": {"token": null}, "runtime": {"socialTransportAvailable": false}},
          "text": "fuck you",
          "expect": {
            "result.actionResult.accepted": false,
            "result.actionResult.status": "semantic_social_dispatch_unavailable",
            "result.actionResult.reason": "semantic_social_transport_unavailable",
            "messages.0.payload.key": "semantic.social.interaction.unavailable",
            "dispatchTransport": {"count": 0}
          }
        }
      ],
      "domain": "dialogue"
    },

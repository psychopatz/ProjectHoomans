{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.dialogue.contextual_social_reactions",
  "domain": "dialogue",
  "cases": [
    {
      "id": "dialogue.contextual_social_reactions.apology_uses_relationship_emotion_and_precedence",
      "description": "Apology uses guarded emotion, relationship, and social-style precedence without side effects.",
      "tags": ["dialogue", "social", "apology"],
      "scenario": {
        "npc": {
          "personality": {"socialStyle": "neutral"}
        }
      },
      "turns": [
        {
          "text": "You're an idiot",
          "expect": {"accepted": true}
        },
        {
          "text": "sorry",
          "expect": {
            "accepted": true,
            "result.ir.intent": "APOLOGIZE",
            "result.decision.branch": "SOCIAL_ACKNOWLEDGED",
            "result.decision.route": "deterministic",
            "result.decision.response.templateID": "social.apology.friendly",
            "messages.0.payload.semanticTemplateID": "social.apology.friendly",
            "routedSituation.social.style": "neutral",
            "llmCalls": 0,
            "dispatchTransport": {"count": 0},
            "toolCalls": {"count": 0},
            "result.actionResult": {"absent": true}
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"traits": {"friendly": true}, "personality": null}},
          "text": "You're an idiot",
          "expect": {"accepted": true}
        },
        {
          "text": "sorry",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "social.apology.friendly",
            "routedSituation.social.style": "friendly"
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"traits": {"friendly": false, "reserved": true}, "relationshipState": "Member", "personality": {"socialStyle": "neutral"}}},
          "text": "You're an idiot",
          "expect": {"accepted": true}
        },
        {
          "text": "sorry",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "social.apology.friendly",
            "routedSituation.social.style": "neutral"
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"conditionStats": {"stress": 95}}},
          "text": "You're an idiot",
          "expect": {"accepted": true}
        },
        {
          "text": "sorry",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "social.apology.friendly",
            "routedSituation.social.style": "neutral"
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"traits": {"reserved": false, "friendly": true}, "personality": {"socialStyle": "friendly"}}},
          "text": "You're an idiot",
          "expect": {"accepted": true}
        },
        {
          "text": "sorry",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "social.apology.friendly",
            "routedSituation.social.style": "friendly"
          }
        }
      ],
      "domain": "dialogue"
    },

    {
      "id": "dialogue.contextual_social_reactions.offer_uses_emotion_hunger_and_social_context",
      "description": "Offers select friendly, withdrawn, hungry, and stressed templates by precedence.",
      "tags": ["dialogue", "social", "offer"],
      "scenario": {
        "npc": {
          "personality": {"socialStyle": "friendly"}
        }
      },
      "turns": [
        {
          "text": "want some food",
          "expect": {
            "accepted": true,
            "ir.intent": "OFFER",
            "ir.speechAct": "OFFER",
            "result.decision.branch": "OFFER_RECEIVED",
            "result.decision.response.templateID": "social.offer_friendly",
            "messages.0.payload.semanticTemplateID": "social.offer_friendly",
            "routedSituation.social.style": "friendly",
            "dispatchTransport": {"count": 0},
            "result.actionResult": {"absent": true}
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"personality": {"socialStyle": "withdrawn"}}},
          "text": "want some food",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "semantic.social.offer_withdrawn",
            "routedSituation.social.style": "withdrawn"
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"needs": {"hunger": 0.9}, "personality": {"socialStyle": "neutral"}}},
          "text": "want some food",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": {"oneOf": ["semantic.offer.hungry", "semantic.offer.dataset.hungry_share", "semantic.offer.dataset.hungry_appreciate"]},
            "routedSituation.social.style": "neutral"
          }
        },
        {
          "resetConversation": true,
          "scenarioPatch": {"npc": {"needs": {"hunger": 0.9}, "conditionStats": {"stress": 95}, "personality": {"socialStyle": "friendly"}}},
          "text": "want some food",
          "expect": {
            "accepted": true,
            "result.decision.response.templateID": "semantic.social.offer_stressed",
            "routedSituation.social.style": "friendly"
          }
        }
      ],
      "domain": "dialogue"
    },

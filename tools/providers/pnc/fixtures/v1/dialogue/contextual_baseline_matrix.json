    {
      "id": "dialogue.contextual_baseline_matrix.wellbeing_followup_reuses_bounded_context",
      "description": "'Are you okay?' followed by 'What's wrong?' reuses wellbeing topic context and preview is pure.",
      "tags": ["dialogue", "wellbeing", "followup", "preview"],
      "scenario": {
        "npc": {
          "healthState": "injured",
          "activeBehavior": "treatment",
          "needs": {},
          "conditionStats": {}
        }
      },
      "turns": [
        {
          "text": "Are you okay?",
          "expect": {
            "accepted": true,
            "ir.subject": "WELLBEING",
            "result.decision.response.templateID": {"prefix": "question.wellbeing.injured"}
          }
        },
        {
          "action": "preview",
          "text": "What is wrong?",
          "expect": {
            "accepted": true,
            "ir.provenance.pattern": "pnc.question.wellbeing_follow_up_what_is_wrong",
            "result.decision.response.templateID": "semantic.question.wellbeing.follow_up.injured",
            "messages": {"count": 0},
            "dispatchTransport": {"count": 0},
            "toolCalls": {"count": 0},
            "llmCalls": 0
          }
        },
        {
          "text": "What's wrong?",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "WELLBEING",
            "ir.provenance.pattern": "pnc.question.wellbeing_follow_up_whats_wrong",
            "ir.extensions.dialogueFollowUp": "WELLBEING",
            "result.decision.branch": "QUESTION_RECEIVED",
            "result.decision.response.templateID": {"prefix": "semantic.question.wellbeing.follow_up.injured"},
            "contextBefore.state.sequence": 1,
            "contextAfter.state.sequence": 2,
            "contextBefore.dialogue.currentTopic": "wellbeing",
            "contextAfter.dialogue.currentTopic": "wellbeing",
            "dispatchTransport": {"count": 0}
          }
        }
      ],
      "domain": "dialogue"
    }

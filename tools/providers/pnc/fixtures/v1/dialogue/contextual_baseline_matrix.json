      "id": "dialogue.contextual_baseline_matrix.identity_exchange_records_self_name",
      "description": "'who are you' followed by 'im psycho' records identity claim.",
      "tags": ["dialogue", "identity", "baseline"],
      "turns": [
        {
          "text": "who are you",
          "expect": {
            "accepted": true,
            "ir.intent": "QUESTION",
            "ir.subject": "IDENTITY",

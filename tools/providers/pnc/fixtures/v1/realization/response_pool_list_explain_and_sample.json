{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.realization.response_pool_list_explain_and_sample",
  "domain": "realization",
  "cases": [
    {
      "id": "realization.response_pool_list_explain_and_sample.response_list_explain_sample",
      "domain": "realization",
      "description": "Verify response pool listing, explanation, and sampling.",
      "tags": [
        "realization"
      ],
      "turns": [
        {
          "action": "response.list",
          "payload": {
            "limit": 8
          },
          "expect": {
            "operation.status": "ok",
            "result.pools": {
              "minCount": 1
            }
          }
        },
        {
          "action": "response.explain",
          "payload": {
            "poolID": "semantic.combat.human_kill.aggressive",
            "context": {},
            "salt": "a1-seed"
          },
          "expect": {
            "operation.status": "ok",
            "result.poolID": "semantic.combat.human_kill.aggressive"
          }
        },
        {
          "action": "response.sample",
          "payload": {
            "poolID": "semantic.combat.human_kill.aggressive",
            "context": {},
            "salt": "a1-seed"
          },
          "expect": {
            "operation.status": "ok",
            "result.poolID": "semantic.combat.human_kill.aggressive"
          }
        }
      ]
    }
  ]
}

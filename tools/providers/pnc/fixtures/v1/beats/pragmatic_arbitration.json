    {
      "id": "beats.pragmatic_arbitration.reconciliation_forgiving",
      "description": "High forgiveness exits argument into reconciliation and keeps director context bounded.",
      "tags": [
        "beats",
        "behaviors",
        "arbitration",
        "multi_turn"
      ],
      "scenario": {
        "npc": {
          "personality": {
            "forgiveness": 0.9
          }
        }
      },
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "decision.director.selectedBeat.id": "beat.argument_escalation",
            "decision.director.selectedBehavior.id": "behavior.warn"
          }
        },
        {
          "text": "sorry",
          "expect": {
            "ir.intent": "APOLOGIZE",
            "decision.director.exited.id": "beat.argument_escalation",
            "decision.director.entered.id": "beat.reconciliation",
            "decision.director.selectedBeat.id": "beat.reconciliation",
            "decision.director.selectedBehavior.id": "behavior.reconcile",
            "decision.response.sourcePoolID": "semantic.apology",
            "decision.response.plan.dialogueAct": "RECONCILE",
            "decision.interactionPlan.behaviorID": "behavior.reconcile",
            "contextAfter.dialogue.director.active.id": "beat.reconciliation",
            "contextAfter.dialogue.director.recent": {
              "maxCount": 4
            },
            "contextAfter.dialogue.director.revision": {
              "min": 2
            }
          }
        }
      ],
      "domain": "beats"
    },
    {
      "id": "beats.pragmatic_arbitration.reconciliation_unforgiving",
      "description": "Low forgiveness exits argument into end_conversation.",
      "tags": [
        "beats",
        "behaviors",
        "arbitration",
        "multi_turn"
      ],
      "scenario": {
        "npc": {
          "personality": {
            "forgiveness": 0.1
          }
        }
      },
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "decision.director.selectedBeat.id": "beat.argument_escalation"
          }
        },
        {
          "text": "sorry",
          "expect": {
            "decision.director.exited.id": "beat.argument_escalation",
            "decision.director.selectedBeat.id": "beat.reconciliation",
            "decision.director.selectedBehavior.id": "behavior.end_conversation",
            "decision.response.sourcePoolID": "semantic.apology",
            "decision.response.plan.dialogueAct": "END_CONVERSATION",
            "decision.interactionPlan.behaviorID": "behavior.end_conversation"
          }
        }
      ],
      "domain": "beats"
    },
    {
      "id": "beats.pragmatic_arbitration.active_argument_does_not_hijack_wellbeing",
      "description": "Active argument beat does not hijack an unrelated grounded wellbeing question.",
      "tags": [
        "beats",
        "arbitration",
        "multi_turn"
      ],
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "decision.director.selectedBeat.id": "beat.argument_escalation"
          }
        },
        {
          "text": "are you okay",
          "expect": {
            "decision.director.selectedBeat.id": "beat.argument_escalation",
            "decision.director.selectedBehavior": {
              "absent": true
            },
            "decision.branch": "QUESTION_RECEIVED",
            "decision.response.sourcePoolID": {
              "notEquals": "semantic.hostile_remark"
            }
          }
        }
      ],
      "domain": "beats"
    },
    {
      "id": "beats.pragmatic_arbitration.catalog_initial_beats",
      "description": "Verify initial production beat and behavior catalog counts.",
      "tags": [
        "beats",
        "behaviors"
      ],
      "turns": [
        {
          "action": "beat.catalog",
          "expect": {
            "operation.status": "ok",
            "result.beatCount": 3,
            "result.behaviorCount": 30
          }
        }
      ],
      "domain": "beats"
    }
  ]

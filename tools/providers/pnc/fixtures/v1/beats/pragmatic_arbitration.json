            "decision.response.sourcePoolID": "semantic.hostile_remark",
            "decision.response.plan.dialogueAct": "RETALIATE_VERBALLY",
            "decision.interactionPlan.behaviorID": "behavior.retaliate_verbally",
            "decision.interactionPlan.dialogueAct": "RETALIATE_VERBALLY"
          }
        }
      ],
      "domain": "beats"
    },
    {

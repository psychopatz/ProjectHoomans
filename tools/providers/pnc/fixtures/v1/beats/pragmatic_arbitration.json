{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.beats.pragmatic_arbitration",
  "domain": "beats",
  "cases": [
    {
      "id": "beats.pragmatic_arbitration.suspicious_first_contact_persists_then_challenges_gossip",
      "description": "Suspicious first contact persists across greeting and challenges gossip without hijacking grounded wellbeing.",
      "tags": [
        "beats",
        "arbitration",
        "multi_turn"
      ],
      "turns": [
        {
          "text": "hello",
          "expect": {
            "decision.director.selectedBeat.id": "beat.suspicious_first_contact",
            "decision.response.sourcePoolID": "semantic.flow.greeting.opening"
          }
        },
        {
          "text": "do you have any news",
          "expect": {
            "decision.director.selectedBeat.id": "beat.suspicious_first_contact",
            "decision.director.selectedBehavior.id": "behavior.challenge",
            "decision.response.sourcePoolID": "semantic.gossip",
            "decision.response.plan.dialogueAct": "CHALLENGE",
            "decision.response.fallback": {
              "notEquals": "I'm not sure what you mean."
            }
          }
        },
        {
          "text": "are you okay",
          "expect": {
            "decision.branch": "QUESTION_RECEIVED",
            "decision.response.plan.dialogueAct": {
              "notEquals": "CHALLENGE"
            }
          }
        }
      ],
      "domain": "beats"
    },
    {
      "id": "beats.pragmatic_arbitration.argument_contextual_behavior_warn",
      "description": "Default personality selects boundary warning under hostile remark.",
      "tags": [
        "beats",
        "behaviors",
        "arbitration"
      ],
      "turns": [
        {
          "text": "fuck ypuuuu",
          "expect": {
            "ir.intent": "HOSTILE_REMARK",
            "ir.speechAct": "HOSTILE_REMARK",
            "ir.provenance.pattern": "pnc.social.profanity",
            "decision.director.selectedBeat.id": "beat.argument_escalation",
            "decision.director.selectedBehavior.id": "behavior.warn",
            "decision.response.sourcePoolID": "semantic.hostile_remark",
            "decision.response.plan.sourcePoolID": "semantic.hostile_remark",
            "decision.response.plan.dialogueAct": "BOUNDARY_WARNING",
            "decision.interactionPlan.behaviorID": "behavior.warn",
            "decision.interactionPlan.dialogueAct": "BOUNDARY_WARNING",
            "decision.response.selectionSource": {
              "notEquals": "director"
            }
          }
        }
      ],
      "domain": "beats"
    },
    {

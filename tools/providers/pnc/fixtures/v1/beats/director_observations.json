{
  "schema": "semantic.harness-test.v1",
  "suite": "pnc.beats.director_observations",
  "domain": "beats",
  "cases": [
    {
      "id": "beats.director_observations.observations_hostile_turn_end_to_end",
      "description": "Director observation explains hostile turn candidate selection, modifiers, and bounded surfaces.",
      "tags": [
        "beats",
        "behaviors",
        "observation"
      ],
      "scenario": {
        "npc": {
          "personality": {
            "aggression": 0.95,
            "confidence": 0.85,
            "forgiveness": 0.8
          }
        }
      },
      "turns": [
        {
          "text": "fuck ypuuuu",
          "expect": {
            "observation.ir.intent": "HOSTILE_REMARK",
            "observation.director.kind": "interaction_director_preview",
            "observation.director.committed": true,
            "observation.director.selectedBeat.id": "beat.argument_escalation",
            "observation.director.selectedBehavior.id": "behavior.retaliate_verbally",
            "observation.director.beatCandidates": {
              "maxCount": 12
            },
            "observation.director.behaviorCandidates": {
              "maxCount": 12
            },
            "observation.interactionPlan.beatID": "beat.argument_escalation",
            "observation.interactionPlan.behaviorID": "behavior.retaliate_verbally",
            "observation.interactionPlan.dialogueAct": "RETALIATE_VERBALLY",
            "observation.response.sourcePoolID": "semantic.hostile_remark",
            "observation.response.dialogueAct": "RETALIATE_VERBALLY",
            "observation.response.text": {
              "truthy": true
            },
            "observation.sideEffects": {
              "contains": "none"
            },
            "observation.actionResult.speechAct": "HOSTILE_REMARK",
            "observation.actionResult.accepted": true
          }
        }
      ],
      "domain": "beats"
    },
    {
      "id": "beats.director_observations.observations_argument_exit_reconciliation_entry",
      "description": "Director observation records argument exit, reconciliation entry, and revision increment.",
      "tags": [
        "beats",
        "observation",
        "multi_turn"
      ],
      "turns": [
        {
          "text": "fuck you",
          "expect": {
            "observation.director.beatCandidates": {
              "maxCount": 12
            },
            "observation.director.behaviorCandidates": {
              "maxCount": 12
            }
          }
        },
        {
          "text": "sorry",
          "expect": {
            "observation.director.exited.id": "beat.argument_escalation",
            "observation.director.entered.id": "beat.reconciliation",
            "observation.director.contextAfter.active.id": "beat.reconciliation",
            "observation.director.contextAfter.revision": {
              "min": 2
            }
          }
        }
      ],
      "domain": "beats"
    }
  ]
}

      "turns": [
        {
          "text": "What's up?",
          "expect": {
            "accepted": true,
            "observation.suggestions.currentGroupID": "semantic_hub.whats_up",
            "observation.suggestions.groups.1.candidates": {"contains": {"id": "question.wellbeing"}}
          }
        },
        {
          "text": "hello",
          "expect": {
            "accepted": true
          }
        },
        {
          "suggestionClick": {"groupID": "semantic_hub.whats_up", "candidateID": "question.wellbeing", "fromTurn": 0},
          "expect": {
            "accepted": false,

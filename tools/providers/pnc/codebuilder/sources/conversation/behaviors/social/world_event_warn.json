{
  "schema": "pnc.conversation.shard.v1",
  "version": 1,
  "kind": "behaviors",
  "domain": "social",
  "source": {
    "name": "Project Hoomans Pragmatic Interaction",
    "version": "1",
    "contentLicense": "Project Hoomans authored content"
  },
  "behaviors": [
    {
      "id": "behavior.world_event_warn",
      "version": 1,
      "owner": "ProjectHoomans",

      "continuation": {
        "mode": "terminate"
      },
      "when": {
        "path": "stimulus.semantic.intent",
        "op": "eq",
        "value": "COMBAT_HORDE_REPLY"
      },
      "baseRelevance": 0.65,
      "modifiers": []
    },

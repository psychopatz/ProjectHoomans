    {
      "id": "behavior.scene_news_followup",
      "version": 1,
      "owner": "ProjectHoomans",
      "act": "ASK_NEWS_FOLLOWUP",
      "mode": "one_shot",
      "stimuli": [
        "NPC_SEMANTIC_ACT"

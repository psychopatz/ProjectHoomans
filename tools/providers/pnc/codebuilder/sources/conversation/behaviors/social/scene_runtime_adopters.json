{
  "schema": "pnc.conversation.shard.v1",
  "version": 1,
  "kind": "behaviors",
  "domain": "social",
  "source": {
    "name": "Project Hoomans Scene Runtime Adopters",
    "version": "1",
    "contentLicense": "Project Hoomans authored content"
  },
  "behaviors": [
    {
      "id": "behavior.scene_horde_prompt",
      "version": 1,
      "owner": "ProjectHoomans",
      "act": "COMBAT_HORDE_PROMPT",
      "mode": "one_shot",
      "stimuli": [
        "DANGER_CHANGED"
      ],
      "requiredCapabilities": [
        "speech"
      ],
      "outputs": {
        "speech": {
          "dialogueAct": "WARN",
          "contentTemplateID": "semantic.interaction.scene.horde_prompt"
        },
        "emote": {
          "id": "emote.alert"
        }
      },
      "continuation": {
        "mode": "emit",
        "target": "other",
        "intent": "COMBAT_HORDE_REPLY",
        "speechAct": "REPLY"
      },
      "when": {
        "path": "stimulus.semantic.intent",
        "op": "eq",
        "value": "COMBAT_HORDE_ALERT"
      },
      "baseRelevance": 1.0,
      "modifiers": []
    },
    {
      "id": "behavior.scene_horde_reply_brave",
      "version": 1,
      "owner": "ProjectHoomans",
      "act": "COMBAT_HORDE_REPLY",
      "mode": "one_shot",
      "stimuli": [
        "NPC_SEMANTIC_ACT"
      ],
      "requiredCapabilities": [
        "speech"
      ],
      "outputs": {
        "speech": {
          "dialogueAct": "PROPOSE_ENGAGE",
          "contentTemplateID": "semantic.interaction.scene.horde_reply_brave"
        }
      },
      "continuation": {
        "mode": "terminate"
      },
      "when": {
        "all": [
          {
            "path": "stimulus.semantic.intent",
            "op": "eq",
            "value": "COMBAT_HORDE_REPLY"
          },
          {
            "path": "actor.disposition.confidence",
            "op": "gte",
            "value": 0.65
          }
        ]
      },
      "baseRelevance": 1.0,
      "modifiers": []
    },
    {
      "id": "behavior.scene_horde_reply_cautious",
      "version": 1,
      "owner": "ProjectHoomans",
      "act": "COMBAT_HORDE_REPLY",
      "mode": "one_shot",
      "stimuli": [
        "NPC_SEMANTIC_ACT"
      ],
      "requiredCapabilities": [
        "speech"
      ],
      "outputs": {

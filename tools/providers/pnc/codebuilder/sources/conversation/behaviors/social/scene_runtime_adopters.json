      "when": {
        "path": "stimulus.semantic.intent",
        "op": "eq",
        "value": "SHARE_GROUNDED_NEWS"
      },
      "baseRelevance": 0.45,
      "modifiers": [
        {
          "when": {
            "path": "actor.disposition.sociability",
            "op": "gte",
            "value": 0.6
          },
          "delta": 0.25,
          "reason": "sociability_favors_news_followup"

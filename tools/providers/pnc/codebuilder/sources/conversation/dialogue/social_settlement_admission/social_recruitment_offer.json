{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "social.recruitment",
  "id": "offer",
  "owner": "ProjectHoomans",
  "invoke": {
    "intent": "REQUEST",
    "action": "RECRUIT"
  },
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "npc.companion_member"
  ],
  "closure": {
    "closureClass": "state_transition"
  },
  "statePolicy": [
    {
      "id": "already_member",
      "when": {
        "any": [
          {
            "path": "roles.companion",
            "op": "==",
            "value": true
          },
          {
            "path": "roles.owned",
            "op": "==",
            "value": true
          }
        ]
      },
      "outcome": "already_satisfied",
      "reason": "already_member",
      "admission": "no_op",
      "replyOutcome": "already_member"
    },
    {
      "id": "hostile_or_ineligible",
      "when": {
        "path": "roles.hostile",
        "op": "==",
        "value": true
      },
      "outcome": "blocked",
      "reason": "actor_blocked_or_hostile",
      "admission": "no_op",
      "replyOutcome": "rejected"
    },
    {
      "id": "ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "already_member": {
      "metadata": {
        "templateID": "recruitment.reject.member.1"
      },
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "rejected": {
      "metadata": {
        "templateID": "recruitment.reject.hostile.1"
      },
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "accepted": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "settlement_relationship",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "settlement",
      "domain": "settlement_relationship"
    }
  ]
}

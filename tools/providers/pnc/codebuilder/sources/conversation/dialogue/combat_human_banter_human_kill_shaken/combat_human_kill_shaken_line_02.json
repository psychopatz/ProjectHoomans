  "response": {
    "act": "REACT",
    "variants": [
      {
        "id": "neutral.01",
        "text": {
          "EN": "God. That was a person.",
          "TL": "Diyos ko. Tao 'yon."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "A real person... not a zombie.",
          "TL": "Tunay na tao... hindi zombie."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "He had a name... someone knew him.",
          "TL": "May pangalan 'yon... may nakakakilala sa kanya."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "We're killing each other now... God.",
          "TL": "Pumapatay na tayo ng kapwa... Diyos ko."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "He was just trying to survive too...",
          "TL": "Gusto lang din niyang mabuhay..."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "That was an actual human being lying there.",
          "TL": "Tunay na tao ang nakahandusay diyan."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "I can't shake this feeling... we took a life.",
          "TL": "Hindi maalis sa isip ko... pumatay tayo ng tao."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "He had boots, a jacket, a life... now he's gone.",
          "TL": "May gamit siya, may buhay... ngayon wala na."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "Killing people... what are we becoming?",
          "TL": "Pumapatay ng kapwa... ano na nagiging tayo?"
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "That was somebody's family once.",
          "TL": "Pamilya rin siya ng iba noon."
        }
      }
    ]
  },

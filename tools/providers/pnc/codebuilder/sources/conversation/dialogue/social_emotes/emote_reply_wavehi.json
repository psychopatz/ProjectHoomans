      },
      "metadata": {
        "category": "projecthoomans:core_social_content",
        "contentOwner": "projecthoomans.dialogue_content.social",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/social/emotes/reply.json",
        "responseTemplateID": "semantic.emote.reply.wavehi",
        "style": "warm"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "warm.01",
            "text": {
              "EN": "Hey again. Good to see a friendly face.",
              "TL": "Uy muli. Mabuti at may nakitang kaibigang mukha."
            }
          },
          {
            "id": "warm.02",
            "text": {
              "EN": "Hello, friend! How's your day treating you?",
              "TL": "Kumusta, kaibigan! Kamusta ang araw mo?"
            }
          },
          {
            "id": "warm.03",
            "text": {
              "EN": "Hey there! Always brightens things up when you come around.",
              "TL": "Kumusta! Laging sumasaya kapag dumadaan ka rito."
            }
          },
          {
            "id": "warm.04",
            "text": {
              "EN": "Great to see you again! Everything okay with you?",
              "TL": "Napakagandang makita ka muli! Maayos ba ang lagay mo?"
            }
          },
          {
            "id": "warm.05",
            "text": {
              "EN": "Hey! I was just hoping you'd swing by.",
              "TL": "Uy! Umasa nga akong dadaan ka rito."
            }
          },
          {
            "id": "warm.06",
            "text": {
              "EN": "Welcome back! Good to have you around.",
              "TL": "Maligayang pagbabalik! Mabuting narito ka."
            }
          },
          {
            "id": "warm.07",
            "text": {
              "EN": "Hello! Glad to see you made it through safely.",
              "TL": "Kumusta! Mabuti at nakaligtas ka nang ligtas."
            }
          },
          {
            "id": "warm.08",
            "text": {
              "EN": "Hey there! Come on over, take a seat.",
              "TL": "Kumusta! Halika rito, umupo ka muna."
            }
          },
          {
            "id": "warm.09",
            "text": {
              "EN": "Always a relief to see you walking up. Hey!",
              "TL": "Laging nakapagpapagaan ng loob na makita kang naglalakad papalapit. Uy!"
            }
          },
          {
            "id": "warm.10",
            "text": {
              "EN": "Hey, good to see you! How are you holding up?",
              "TL": "Uy, mabuting makita ka! Kumusta ang lagay mo?"
            }
          }
        ]
      },

    "act": "REPLY",
    "variants": [
      {
        "id": "neutral.01",
        "text": {
          "EN": "Go around.",
          "TL": "Umikot tayo."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "Bypass them. Stay quiet.",
          "TL": "Lalagpasan natin sila. Huwag mag-ingay."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "Find another route. Don't draw them.",
          "TL": "Maghanap ng ibang ruta. Huwag silang akitin."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "Circle wide. Keep in the shadows.",
          "TL": "Umikot nang malayo. Manatili sa dilim."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "Not worth the ammo. Move around.",
          "TL": "Sayang ang bala. Umiwas na lang."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "Detour through the alley. Quietly.",
          "TL": "Daan tayo sa eskinita. Nang tahimik."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "We sneak past. Crouch and move.",
          "TL": "Lulusot tayo nang lihim. Yumuko at lumakad."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "Leave them be. Take the back way.",
          "TL": "Hayaan sila roon. Daan tayo sa likod."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "Avoid contact. Step carefully.",
          "TL": "Iwasan ang engkwentro. Mag-ingat sa bawat hakbang."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Back out and take the alternate street.",
          "TL": "Atras muna at dumaan sa kabilang kalsada."
        }
      }
    ]
  },

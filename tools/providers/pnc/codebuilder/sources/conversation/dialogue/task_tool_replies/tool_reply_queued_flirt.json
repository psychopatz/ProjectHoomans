        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "You are bold, I will give you that.",
              "TL": "Matapang ka, aaminin ko iyan."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "You certainly don't lack nerve.",
              "TL": "Talagang hindi ka kulang sa lakas ng loob."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Bold move talking like that out here.",
              "TL": "Matapang na hakbang ang magsalita nang ganyan dito."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "You have plenty of confidence, I'll say that.",
              "TL": "Marami kang tiwala sa sarili, aaminin ko."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "That's quite a forward thing to say.",
              "TL": "Medyo mapangahas ang linyang 'yan."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "You certainly know how to shoot your shot.",
              "TL": "Marunong ka talagang sumubok ng diskarte mo."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Bold words for someone in danger.",
              "TL": "Matatapang na salita para sa taong nasa panganib."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "I admire the guts, if nothing else.",
              "TL": "Hanga ako sa tapang mo, kahit 'yon man lang."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "You're definitely not shy.",
              "TL": "Talagang hindi ka mahiyain."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "You like living dangerously, don't you?",
              "TL": "Gusto mo talagang sumugal sa delikado, 'no?"

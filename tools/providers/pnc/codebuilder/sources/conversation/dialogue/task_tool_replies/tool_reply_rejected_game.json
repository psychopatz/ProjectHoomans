          {
            "id": "neutral.03",
            "text": {
              "EN": "We have real survival to worry about. Not now.",
              "TL": "May tunay na kaligtasan tayong iniisip. Hindi ngayon."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "I'm busy staying alive. Not playing games.",
              "TL": "Abala ako sa pananatiling buhay. Di ako maglalaro."
            }
          },
          {

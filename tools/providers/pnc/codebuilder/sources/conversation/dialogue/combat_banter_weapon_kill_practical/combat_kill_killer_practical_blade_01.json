        "id": "neutral.01",
        "text": {
          "EN": "Blade did its job. Keep moving.",
          "TL": "Ginawa ng talim ang trabaho nito. Tuloy."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "Clean cut. Check blade edge.",
          "TL": "Malinis na hiwa. Tignan ang talim."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "Down without wasting noise.",
          "TL": "Bagsak nang hindi gumagawa ng ingay."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "Quiet kill. Keep your eyes sharp.",
          "TL": "Tahimik na patay. Panatilihing matalas ang mata."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "Severed cleanly. Don't let your guard down.",
          "TL": "Hiwa nang malinis. Huwag ibaba ang depensa."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "One silent drop. Keep the pace.",
          "TL": "Isang tahimik na pagbagsak. Tuloy ang hakbang."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "Edge held up fine. Move ahead.",
          "TL": "Maayos pa ang talim. Pasulong."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "Target down quietly. Scan the hall.",
          "TL": "Tahimik na naitumba ang target. Suriin ang pasilyo."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "No ammo burned. Good.",
          "TL": "Walang balang nasayang. Maganda."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Dropped it silently. Watch the rear.",
          "TL": "Tahimik na ibinagsak. Bantayan ang likuran."

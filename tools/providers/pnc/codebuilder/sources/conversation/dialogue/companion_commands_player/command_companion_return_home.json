{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "command.companion",
  "id": "return_home",
  "owner": "ProjectHoomans",
  "invoke": {
    "intent": "COMMAND",
    "action": "RETURN_HOME"
  },
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "companion.returning_home"
  ],
  "closure": {
    "closureClass": "state_transition"
  },
  "statePolicy": [
    {
      "id": "actor_blocked_or_hostile",
      "when": {
        "any": [
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          },
          {
            "path": "roles.authorityEligible",
            "op": "==",
            "value": false
          },
          {
            "path": "roles.status",
            "op": "==",
            "value": "hostile"
          },
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "dead"
            ]
          }
        ]
      },
      "outcome": "blocked",
      "reason": "actor_blocked_or_hostile",
      "admission": "no_op"
    },
    {
      "id": "already_returning",
      "when": {
        "path": "npcState.orderKind",
        "op": "==",
        "value": "return"
      },
      "outcome": "already_satisfied",
      "reason": "already_return_home",
      "admission": "no_op"
    },
    {
      "id": "ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "target": {
      "cardinality": "OPTIONAL_ONE",
      "kinds": [
        "actor",
        "entity"
      ]
    }
  },
  "domains": [
    {
      "domain": "companion_commands",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "companion_command",
      "domain": "companion_commands"
    }
  ],
  "activities": [
    {
      "id": "companion_order",
      "role": "target"
    }
  ]
}

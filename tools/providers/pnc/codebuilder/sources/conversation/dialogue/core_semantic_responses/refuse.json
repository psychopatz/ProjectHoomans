{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "id": "refuse",
  "owner": "ProjectHoomans",
  "metadata": {
    "responsePoolID": "refuse",
    "responseAct": "REFUSE"
  },
  "say": {
    "variants": [
      {
        "id": "refuse.dataset.pending_unavailable",
        "text": {
          "EN": "I can't take that on right now.",
          "TL": "I can't take that on right now."
        },
        "when": {
          "op": "eq",
          "path": "conversation.hasPendingRequest",
          "value": true
        },
        "metadata": {
          "fallback": "I can't take that on right now.",
          "priority": 1,
          "templateID": "refuse.dataset.pending_unavailable"
        }
      },
      {
        "id": "refuse.dataset.pending_enough",
        "text": {
          "EN": "Not this time. I have enough to manage.",
          "TL": "Not this time. I have enough to manage."
        },
        "when": {
          "op": "eq",
          "path": "conversation.hasPendingRequest",
          "value": true
        },
        "metadata": {
          "fallback": "Not this time. I have enough to manage.",
          "priority": 1,
          "templateID": "refuse.dataset.pending_enough"
        }
      }
    ]
  }
}

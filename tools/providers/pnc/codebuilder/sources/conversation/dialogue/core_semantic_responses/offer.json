{
  "schema": "psychopatz.convo-engine.v1",
  "id": "offer",
  "kind": "dialogue",
  "metadata": {
    "responsePoolID": "offer",
    "responseAct": "OFFER"
  },
  "say": {
    "variants": [
      {
        "id": "offer.dataset.hungry_share",
        "when": "conversation.needType == \"hunger\" && conversation.needUrgency in [\"moderate\", \"severe\", \"emergency\", \"critical\"]",
        "metadata": {
          "fallback": "That would help a lot. Could I have some?",
          "priority": 2,
          "templateID": "offer.dataset.hungry_share"
        }
      },
      {
        "id": "offer.dataset.hungry_appreciate",
        "when": "conversation.needType == \"hunger\" && conversation.needUrgency in [\"moderate\", \"severe\", \"emergency\", \"critical\"]",
        "metadata": {
          "fallback": "I'd appreciate a bite. Would you share?",
          "priority": 2,
          "templateID": "offer.dataset.hungry_appreciate"
        }
      }
    ]
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "social",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "social_interaction",
      "domain": "social"
    }
  ],
  "owner": "ProjectHoomans"
}

{
  "schema": "psychopatz.convo-engine.v1",
  "id": "accept",
  "kind": "dialogue",
  "metadata": {
    "responsePoolID": "accept",
    "responseAct": "ACCEPT"
  },
  "say": {
    "variants": [
      {
        "id": "accept.dataset.pending_started",
        "when": "conversation.hasPendingRequest == true",
        "metadata": {
          "fallback": "Okay, I'll get started.",
          "priority": 1,
          "templateID": "accept.dataset.pending_started"
        }
      },
      {
        "id": "accept.dataset.pending_care",
        "when": "conversation.hasPendingRequest == true",
        "metadata": {
          "fallback": "All right. I can take care of that.",
          "priority": 1,
          "templateID": "accept.dataset.pending_care"
        }
      }
    ]
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "social",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "social_interaction",
      "domain": "social"
    }
  ],
  "owner": "ProjectHoomans"
}

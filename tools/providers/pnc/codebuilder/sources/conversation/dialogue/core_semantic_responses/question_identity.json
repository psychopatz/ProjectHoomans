        "metadata": {
          "fallback": "I don't trust you enough to share my name. Who are you, really?",
          "priority": 2,
          "templateID": "question.identity.wary_alt_1"
        }
      },
      {
        "id": "question.identity.dataset.wary_alt_2",
        "when": "conversation.identityTrust == \"untrustworthy\"",

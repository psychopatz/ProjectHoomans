{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "combat.injury",
  "id": "triage_exchange",
  "owner": "ProjectHoomans",
  "inputPolicy": "typed_parity",
  "repeatPolicy": "repeatable",
  "closure": {
    "closureClass": "resolved_episode",
    "episodeId": "combat_injury_triage_exchange"
  },
  "statePolicy": [
    {
      "id": "blocked_dead_or_hostile",
      "when": {
        "any": [
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "dead"
            ]
          },
          {
            "path": "npcState.healthState",
            "op": "in",
            "values": [
              "dead",
              "incapacitated"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          }
        ]
      },
      "outcome": "blocked",
      "reason": "hostile_dead_or_incapacitated",
      "admission": "no_op",
      "replyOutcome": "refused"
    },
    {
      "id": "combat_injury_ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "patched_push_on": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "combat.aftermath.debrief_exchange"
        ]
      }
    },
    "ordered_fallback": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin"
        ]
      }
    },
    "covered_for_treatment": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin"
        ]
      }
    },
    "reassured_bond": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "combat.aftermath.debrief_exchange"
        ]
      }
    },
    "bite_non_lethal_stabilized": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin"
        ]
      }
    },
    "bite_quarantined": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "bite_psychopath_threatened": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "social.conflict.mediate_exchange"
        ]
      }
    },
    "refused": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "metadata": {
    "triggers": [
      {
        "intent": "QUESTION",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "CHECK",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "OFFER",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "ACCEPT",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "CLARIFY",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "WARN",
        "subject": "COMBAT_INJURY"
      },
      {
        "intent": "INFORM",
        "subject": "COMBAT_INJURY"

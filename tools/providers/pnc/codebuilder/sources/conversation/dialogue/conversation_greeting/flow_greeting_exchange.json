{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "flow.greeting",
  "id": "exchange",
  "owner": "ProjectHoomans",
  "inputPolicy": "typed_parity",
  "repeatPolicy": "repeatable",
  "closure": {
    "closureClass": "none"
  },
  "statePolicy": [
    {
      "id": "hostile_or_blocked_greeting",
      "when": {
        "any": [
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          }
        ]
      },
      "outcome": "blocked",
      "reason": "hostile_or_busy_npc",
      "admission": "no_op",
      "replyOutcome": "hostile"
    },
    {
      "id": "friendly_greeting",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "EN": "Hello.",
    "TL": "Kamusta."
  },
  "reply": {
    "hostile": {
      "say": {
        "EN": "Stay back.",
        "TL": "Lumayo ka."
      }
    },
    "friendly": {
      "say": {
        "EN": "Good to see you.",
        "TL": "Mabuti at nandito ka."
      }
    }
  },
  "metadata": {
    "triggers": [
      {
        "intent": "GREET",
        "speechAct": "GREET"
      }
    ],
    "flow": {
      "id": "greeting",
      "version": 1,
      "owner": "ProjectHoomans",
      "constraints": {
        "all": [
          {
            "path": "npcState.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "neq",
            "value": true
          },
          {
            "path": "actorConversationContext.roles.hostile",
            "op": "neq",
            "value": true
          },
          {
            "path": "actorConversationContext.situation.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "npcState.healthState",
            "op": "not_in",
            "values": [
              "dead",
              "incapacitated"
            ]
          }
        ]
      },
      "initial": "await_thanks",
      "nodes": {
        "await_thanks": {
          "responsePool": "semantic.flow.greeting.opening",
          "branchOffers": [
            {
              "id": "greeting.thanks",
              "labelKey": "UI_PNC_Conversation_Suggestion_GreetingThank_Label",
              "labelFallback": "Thank them",
              "utteranceKey": "UI_PNC_Conversation_Suggestion_GreetingThank_Utterance",
              "utteranceFallback": "Thanks.",
              "frame": {
                "intent": "THANK",
                "speechAct": "THANK"
              }
            }
          ],
          "accepts": [
            {
              "intent": "THANK",
              "speechAct": "THANK"
            },
            {
              "intent": "INFORM",
              "speechAct": "INFORM",
              "selfDirected": true,
              "target": "SELF",
              "stateType": "WELLBEING"
            }
          ],
          "onMatch": "complete",
          "onRefuse": "cancel",
          "onUnrelated": "suspend"
        },
        "complete": {
          "terminal": true,
          "responsePool": "semantic.flow.greeting.followup"
        }
      }
    }
  }
}

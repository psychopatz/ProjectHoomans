          },
          {
            "path": "world.time.hour",
            "op": "lt",
            "value": 21
          }
        ]
      }
    ]
  },
  "metadata": {
    "runtimeBlockID": "projecthoomans:greeting_member_dusk",
    "category": "projecthoomans:greetings",

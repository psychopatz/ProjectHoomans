      },
      "metadata": {
        "category": "projecthoomans:social.apology",
        "sourceSurface": "content/social_apology.json",
        "responseTemplateID": "semantic.social.apology.friendly",
        "style": "warm"
      },
      "response": {
        "act": "APOLOGY_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.01"
            },
            "text": {
              "EN": "It's okay. I appreciate you saying that.",
              "TL": "Ayos lang. Pinahahalagahan ko ang sinabi mo."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.02"
            },
            "text": {
              "EN": "Don't worry about it for a second. We're friends.",
              "TL": "Huwag mo nang alalahanin kahit sandali. Magkaibigan tayo."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.03"
            },
            "text": {
              "EN": "Hey, it takes a good person to say that. Thank you.",
              "TL": "Kailangan ng mabuting puso para sabihin 'yan. Salamat."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.04"
            },
            "text": {
              "EN": "We're completely fine. Really.",
              "TL": "Maayos na maayos tayo. Totoo."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.05"
            },
            "text": {
              "EN": "You don't have to carry that around. I forgive you.",
              "TL": "Huwag mo nang dalhin sa dibdib mo 'yan. Pinatatawad kita."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.06"
            },
            "text": {
              "EN": "I appreciate your honesty. It means a lot to me.",
              "TL": "Salamat sa katapatan mo. Malaking bagay ito sa akin."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.07"
            },
            "text": {
              "EN": "We look out for each other. Don't worry about it.",
              "TL": "Nagtitinginan tayo rito. Huwag mo nang isipin 'yon."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.08"
            },
            "text": {
              "EN": "You're good in my book. Always.",
              "TL": "Mabuti ka sa akin. Palagi."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.09"
            },
            "text": {
              "EN": "Thanks for being real with me. We're good.",
              "TL": "Salamat sa pagiging tapat sa akin. Ayos tayo."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.friendly.warm.10"
            },
            "text": {
              "EN": "No bad blood between us. Not now, not ever.",
              "TL": "Walang samaan ng loob sa atin. Kahit kailan."
            }
          }
        ]
      },
      "namespace": "semantic.social.apology.friendly"
    },

          },
          {
            "id": "guarded.06",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.default.guarded.06"
            },
            "text": {
              "EN": "Did you touch something you shouldn't have?",
              "TL": "May ginalaw ka ba na hindi dapat?"

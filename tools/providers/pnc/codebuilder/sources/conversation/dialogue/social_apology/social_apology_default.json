              "style": "guarded",
              "textKey": "semantic.social.apology.default.guarded.09"
            },
            "text": {
              "EN": "Tell me what you did before I find out myself.",
              "TL": "Sabihin mo ang ginawa mo bago ko pa matuklasan."

          },
          {
            "id": "guarded.03",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.default.guarded.03"
            },
            "text": {
              "EN": "What went wrong that I should know about?",
              "TL": "Anong pumalpak na dapat kong malaman?"
            }
          },
          {
            "id": "guarded.04",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.default.guarded.04"
            },
            "text": {
              "EN": "People only apologize when they messed up. What was it?",
              "TL": "Nagsasabi lang ng sorry ang tao kapag pumalpak. Ano 'yon?"
            }
          },
          {
            "id": "guarded.05",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.default.guarded.05"
            },
            "text": {
              "EN": "What are you trying to get ahead of?",
              "TL": "Ano ang inuunahan mong sabihin?"

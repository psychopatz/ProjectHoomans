  "records": [
    {
      "kind": "dialogue",
      "id": "neutral",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:social.apology",
        "sourceSurface": "content/social_apology.json",
        "responseTemplateID": "semantic.social.apology.stressed",
        "style": "neutral"
      },
      "response": {
        "act": "APOLOGY_RESPONSE",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.01"
            },
            "text": {
              "EN": "I know things are tense. Let's keep it calm.",
              "TL": "Alam kong tensiyonado tayo. Panatilihin nating mahinahon."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.02"
            },
            "text": {
              "EN": "We're all under a lot of stress. Just take a breath.",
              "TL": "Lahat tayo nai-stress. Huminga ka muna nang malalim."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.03"
            },
            "text": {
              "EN": "Tensions are high right now. Let's not lose our heads.",
              "TL": "Mataas ang tensiyon ngayon. Huwag tayong mawalan ng katinuan."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.04"
            },
            "text": {
              "EN": "It's fine. We just need to keep our cool.",
              "TL": "Ayos lang. Kailangan lang nating magpakahinahon."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.05"
            },
            "text": {
              "EN": "Pressure gets to everyone out here. We're okay.",
              "TL": "Lahat naman nadadala sa bigat ng sitwasyon. Ayos lang tayo."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.06"
            },
            "text": {
              "EN": "Let's reset and focus on what needs doing.",
              "TL": "Mag-reset tayo at magpokus sa kailangang gawin."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.07"
            },
            "text": {
              "EN": "No one's at their best under this much strain. It's fine.",
              "TL": "Walang perpekto kapag ganito kabigat ang sitwasyon. Ayos lang."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.08"
            },
            "text": {
              "EN": "Take it easy. We can work through this.",
              "TL": "Dahan-dahan lang. Kakayanin natin ito."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.09"
            },
            "text": {
              "EN": "It's all right. Let's keep our nerves steady.",
              "TL": "Ayos lang. Panatilihin nating kalmado ang sarili natin."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.social.apology.stressed.neutral.10"
            },
            "text": {
              "EN": "Understood. Let's de-escalate and move forward.",
              "TL": "Naiintindihan ko. Magpahinga muna at magpatuloy."
            }
          }
        ]
      },
      "namespace": "semantic.social.apology.stressed"
    },
    {
      "kind": "dialogue",
      "id": "warm",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:social.apology",
        "sourceSurface": "content/social_apology.json",
        "responseTemplateID": "semantic.social.apology.stressed",
        "style": "warm"
      },
      "response": {
        "act": "APOLOGY_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.01"
            },
            "text": {
              "EN": "I know things are tense. Thanks for saying that.",
              "TL": "Alam kong tensiyonado tayo. Salamat sa pagsabi niyan."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.02"
            },
            "text": {
              "EN": "Hey, we're all frayed right now. It's totally okay.",
              "TL": "Huy, pagod tayong lahat ngayon. Ayos na ayos lang 'yan."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.03"
            },
            "text": {
              "EN": "I know how hard this is on you. We're in this together.",
              "TL": "Alam ko kung gaano kabigat ito sa 'yo. Magkasama tayo rito."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.04"
            },
            "text": {
              "EN": "Don't apologize for being stressed. You're human.",
              "TL": "Huwag kang mag-sorry dahil nai-stress ka. Tao ka lang."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.05"
            },
            "text": {
              "EN": "I appreciate you taking the time to say that. We're good.",
              "TL": "Salamat sa paglalaan ng oras para sabihin 'yan. Ayos tayo."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.06"
            },
            "text": {
              "EN": "Take a breath. I'm right here with you.",
              "TL": "Huminga ka muna. Narito lang ako kasama mo."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.07"
            },
            "text": {
              "EN": "We'll get through the rough patch together. Don't worry.",
              "TL": "Lalampasan natin ang hirap na ito nang magkasama. Huwag kang mag-alala."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.08"
            },
            "text": {
              "EN": "Thank you for checking in despite the chaos. It means a lot.",
              "TL": "Salamat sa pangungumusta sa kabila ng gulo. Malaking bagay ito."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.09"
            },
            "text": {
              "EN": "You don't have to carry the stress alone. We're okay.",
              "TL": "Hindi mo kailangang pasanin mag-isa ang bigat. Ayos tayo."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.social.apology.stressed.warm.10"
            },
            "text": {
              "EN": "It's okay. Let's just catch our breath for a minute.",
              "TL": "Ayos lang. Huminga muna tayo nang sandali."
            }
          }
        ]
      },
      "namespace": "semantic.social.apology.stressed"
    },
    {
      "kind": "dialogue",

      },
      "metadata": {
        "category": "projecthoomans:social.apology",
        "sourceSurface": "content/social_apology.json",
        "responseTemplateID": "semantic.social.apology.stressed",
        "style": "terse"
      },
      "response": {
        "act": "APOLOGY_RESPONSE",
        "variants": [
          {
            "id": "terse.01",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.01"
            },
            "text": {
              "EN": "Keep it calm.",
              "TL": "Maging mahinahon."
            }
          },
          {
            "id": "terse.02",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.02"
            },
            "text": {
              "EN": "Breathe.",
              "TL": "Huminga ka."
            }
          },
          {
            "id": "terse.03",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.03"
            },
            "text": {
              "EN": "Cool off.",
              "TL": "Kumalma ka muna."
            }
          },
          {
            "id": "terse.04",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.04"
            },
            "text": {
              "EN": "Not now. Stay focused.",
              "TL": "Hindi ngayon. Magpokus ka."
            }
          },
          {
            "id": "terse.05",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.05"
            },
            "text": {
              "EN": "Keep your head.",
              "TL": "Gamitin ang isip."
            }
          },
          {
            "id": "terse.06",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.06"
            },
            "text": {
              "EN": "Fine. Settle down.",
              "TL": "Sige. Kalma na."
            }
          },
          {
            "id": "terse.07",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.07"
            },
            "text": {
              "EN": "No drama. We have work.",
              "TL": "Walang drama. May trabaho tayo."
            }
          },
          {
            "id": "terse.08",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.08"
            },
            "text": {
              "EN": "Steady up.",
              "TL": "Magpakatatag ka."
            }
          },
          {
            "id": "terse.09",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.09"
            },
            "text": {
              "EN": "Heard. Keep moving.",
              "TL": "Narinig ko. Tuloy ang lakad."
            }
          },
          {
            "id": "terse.10",
            "metadata": {
              "style": "terse",
              "textKey": "semantic.social.apology.stressed.terse.10"
            },
            "text": {
              "EN": "Hold it together.",
              "TL": "Kayanin mo."
            }
          }
        ]
      },
      "namespace": "semantic.social.apology.stressed"
    },
    {
      "kind": "dialogue",
      "id": "guarded",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:social.apology",
        "sourceSurface": "content/social_apology.json",
        "responseTemplateID": "semantic.social.apology.stressed",
        "style": "guarded"
      },
      "response": {
        "act": "APOLOGY_RESPONSE",
        "variants": [
          {
            "id": "guarded.01",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.01"
            },
            "text": {
              "EN": "Things are tense. Leave it there.",
              "TL": "Tensiyonado tayo. Tama na iyon."
            }
          },
          {
            "id": "guarded.02",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.02"
            },
            "text": {
              "EN": "We don't need panic on top of danger. Keep steady.",
              "TL": "Hindi natin kailangan ng takot sa ibabaw ng panganib. Magpakatatag."
            }
          },
          {
            "id": "guarded.03",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.03"
            },
            "text": {
              "EN": "Keep your stress to yourself. We need clear heads.",
              "TL": "Kimkimin mo ang kaba mo. Kailangan natin ng malinaw na isip."
            }
          },
          {
            "id": "guarded.04",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.04"
            },
            "text": {
              "EN": "I'm stressed too, but I'm not snapping. Watch yourself.",
              "TL": "Pagod din ako, pero di ako nagwawala. Mag-ingat ka."
            }
          },
          {
            "id": "guarded.05",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.05"
            },
            "text": {
              "EN": "Apology heard. Don't let your nerves get us killed.",
              "TL": "Narinig ang tawad. Huwag mong hayaang mapatay tayo ng kaba mo."
            }
          },
          {
            "id": "guarded.06",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.06"
            },
            "text": {
              "EN": "Keep a grip on yourself. That's all I ask.",
              "TL": "Kontrolin mo ang sarili mo. Iyon lang ang hinihiling ko."
            }
          },
          {
            "id": "guarded.07",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.07"
            },
            "text": {
              "EN": "If you lose control out here, we're all finished.",
              "TL": "Kapag nawalan ka ng kontrol dito, tapos tayong lahat."
            }
          },
          {
            "id": "guarded.08",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.08"
            },
            "text": {
              "EN": "I heard you. Pull yourself together now.",
              "TL": "Narinig kita. Ayusin mo ang sarili mo ngayon."
            }
          },
          {
            "id": "guarded.09",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.09"
            },
            "text": {
              "EN": "Stress is an excuse that gets survivors killed.",
              "TL": "Ang kaba ay dahilan na ikinamamatay ng mga tao."
            }
          },
          {
            "id": "guarded.10",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.social.apology.stressed.guarded.10"
            },
            "text": {
              "EN": "Leave it. Keep your eyes on our surroundings.",
              "TL": "Tama na. Iwan mo ang paningin mo sa paligid."
            }
          }
        ]
      },
      "namespace": "semantic.social.apology.stressed"
    }
  ]
}

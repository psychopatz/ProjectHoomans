        "id": "neutral.05",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.05"
        },
        "text": {
          "EN": "Blood is still seeping through. Need that wrap.",
          "TL": "Tumutulo pa rin ang dugo. Kailangan ko ng pambalot."
        }
      },

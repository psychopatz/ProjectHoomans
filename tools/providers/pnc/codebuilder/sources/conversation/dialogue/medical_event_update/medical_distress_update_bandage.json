        "id": "neutral.07",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.07"
        },
        "text": {
          "EN": "Waiting on clean cloth. Can't stand like this.",
          "TL": "Naghihintay ng malinis na tela. Hindi makatayo nang ganito."

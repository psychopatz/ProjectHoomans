      {
        "id": "neutral.03",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.03"
        },
        "text": {
          "EN": "Wound is still unbandaged. Need it wrapped soon.",
          "TL": "Wala pa ring benda ang sugat. Kailangang balutin na agad."
        }
      },
      {
        "id": "neutral.04",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.04"
        },
        "text": {
          "EN": "Still waiting for someone to bind this cut.",
          "TL": "Naghihintay pa rin ng magtatali sa hiwang 'to."

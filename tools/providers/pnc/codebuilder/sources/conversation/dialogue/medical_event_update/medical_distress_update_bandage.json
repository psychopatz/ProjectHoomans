        "id": "neutral.06",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.06"
        },
        "text": {
          "EN": "Still grounded until these wounds get dressed.",
          "TL": "Bagsak pa rin hangga't hindi nagagamot ang mga sugat na 'to."
        }

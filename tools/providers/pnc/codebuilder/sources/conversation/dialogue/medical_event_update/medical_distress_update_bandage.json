        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.update.bandage.neutral.02"
        },
        "text": {
          "EN": "Still on the floor. Where is that bandage?",
          "TL": "Nasa sahig pa rin. Nasaan na 'yung benda?"
        }

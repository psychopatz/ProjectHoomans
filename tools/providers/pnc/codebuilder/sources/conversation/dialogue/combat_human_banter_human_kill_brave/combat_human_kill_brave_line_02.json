        "id": "neutral.01",
        "text": {
          "EN": "He's done. Watch the rest.",
          "TL": "Tapos na siya. Bantayan ang iba."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "That one's down. Focus on any survivors.",
          "TL": "Bagsak na ang isang 'yon. Tutukan kung may iba pa."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "One less rifle against us. Watch the flanks.",
          "TL": "Bawas ang isang baril laban sa atin. Bantayan ang gilid."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "Hostile down. Don't let your guard down.",
          "TL": "Bagsak ang kalaban. Huwag ibaba ang depensa."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "He won't be firing again. Check the bushes.",
          "TL": "Hindi na siya puputok ulit. Tignan ang damuhan."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "Downed. Scan for secondary shooters.",
          "TL": "Bagsak. Maghanap ng pangalawang bumaril."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "He's finished. Keep watching the tree line.",
          "TL": "Tapos na siya. Bantayan pa rin ang kakahuyan."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "Target ceased. Search the area.",
          "TL": "Tumigil na ang target. Halughugin ang lugar."

      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "One enemy down. Expect more.",
          "TL": "Isang kalaban ang naitumba. Asahang may iba pa."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Confirmed casualty. Keep the pressure on.",
          "TL": "Kumpirmadong patay. Ipagpatuloy ang pag-iingat."

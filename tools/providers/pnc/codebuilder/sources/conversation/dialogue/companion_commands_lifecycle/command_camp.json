{
  "schema": "psychopatz.convo-engine.v1",
  "id": "command.camp",
  "action": {
    "capability": "hoomans.camp.establish",
    "mutating": true
  },
  "requiredCapabilities": [
    "hoomans.camp.establish"
  ],
  "metadata": {
    "category": "projecthoomans:companion_commands",
    "contentOwner": "projecthoomans.dialogue_content.commands_emotes",
    "responseAct": "REPLY"
  },
  "reply": {
    "queued": {
      "act": "REPLY",
      "say": {
        "1": {
          "variants": [
            {
              "id": "neutral"
            },
            {
              "id": "friendly"
            },
            {
              "id": "repeated"
            },
            {
              "id": "trusted"
            },
            {
              "id": "withdrawn"
            }
          ]
        }
      }
    },
    "rejected": {
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "failed": {
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "pending": {
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "completed": {
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "rejected_out_of_range": {
      "when": "result.reasonClass == \"out_of_range\"",
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "rejected_no_site": {
      "when": "result.reasonClass == \"target_unavailable\"",
      "act": "REPLY",
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "slots": {
    "camp_site": {
      "type": "entity.location",
      "required": true,
      "suggest": "camp_site_candidates",
      "limit": 4
    }
  },
  "bindings": {
    "camp.locationPhrase": {
      "resolver": "pnc.camp.location_phrase",
      "from": "result.data.site",
      "type": "entity.location"
    }
  },
  "affordance": {
    "consumers": [
      "player"
    ],
    "groups": [
      "companion",
      "command",
      "camp"
    ],
    "metadata": {
      "action": "CAMP"
    }
  },
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "execute": {
    "use": "pnc.companion.camp",
    "with": {
      "target": "$slot.camp_site",
      "npcID": "$context.addressee.id"
    },
    "mode": "request_response"
  },
  "invoke": {
    "intent": "COMMAND",
    "action": "CAMP"
  },
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "companion.camping"
  ],
  "closure": {
    "closureClass": "state_transition"
  },
  "statePolicy": [
    {
      "id": "actor_blocked_or_hostile",
      "when": {
        "any": [
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          },
          {
            "path": "roles.authorityEligible",
            "op": "==",
            "value": false
          },
          {
            "path": "roles.status",
            "op": "==",
            "value": "hostile"
          },
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "dead"
            ]
          }
        ]
      },
      "outcome": "blocked",
      "reason": "actor_blocked_or_hostile",
      "admission": "no_op"
    },
    {
      "id": "already_camping",
      "when": {
        "path": "npcState.orderKind",
        "op": "==",
        "value": "camp"
      },
      "outcome": "already_satisfied",
      "reason": "already_camp",
      "admission": "no_op"
    },
    {
      "id": "ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "owner": "ProjectHoomans",
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "target": {
      "cardinality": "OPTIONAL_ONE",
      "kinds": [
        "actor",
        "entity"
      ]
    }
  },
  "domains": [
    {
      "domain": "companion_commands",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "companion_command",
      "domain": "companion_commands"
    }
  ],
  "activities": [
    {
      "id": "companion_order",
      "role": "target"
    }
  ]
}

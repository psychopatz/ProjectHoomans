  "response": {
    "act": "REACT",
    "variants": [
      {
        "id": "neutral.01",
        "text": {
          "EN": "You killed one. So what?",
          "TL": "Napatay mo ang isa. Ano ngayon?"
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "One corpse among millions. Step over.",
          "TL": "Isang bangkay sa milyun-milyon. Hakbangan."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "That was one. There are thousands more.",
          "TL": "Isa lang 'yan. May libu-libo pa."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "Do not admire your work. Advance.",
          "TL": "Huwag mong hangaan ang gawa mo. Sulong."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "A rotten corpse fell. Big deal.",
          "TL": "Bumagsak ang isang bulok. Ano naman."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "Don't pause over it. Keep moving.",
          "TL": "Huwag kang tumigil diyan. Kilos."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "One less dead body standing. Next.",
          "TL": "Bawas ang isang nakatayong bangkay. Sunod."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "You survived a contact. Keep walking.",
          "TL": "Nakaligtas ka sa isang engkwentro. Lakad."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "It was in the way. It fell. Move.",
          "TL": "Nakaharang, bumagsak. Kilos."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Hardly impressive. Keep your weapon ready.",
          "TL": "Hindi nakakahanga. Ihanda ang sandata mo."
        }
      }
    ]
  },

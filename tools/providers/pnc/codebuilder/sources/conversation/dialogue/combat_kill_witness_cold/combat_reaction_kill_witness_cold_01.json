  "response": {
    "act": "REACT",
    "variants": [
      {
        "id": "neutral.01",
        "text": {
          "EN": "Don't expect applause.",
          "TL": "Huwag kang umasa ng palakpak."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "Basic survival. Nothing to celebrate.",
          "TL": "Pangkaraniwang kaligtasan. Walang ipagdiriwang."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "You did what was expected. Move.",
          "TL": "Ginawa mo ang inaasahan. Kilos."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "One kill doesn't earn a trophy.",
          "TL": "Ang isang patay ay hindi para ipagmalaki."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "A child could swing that weapon. Walk.",
          "TL": "Kahit bata kayang ihataw ang sandatang 'yan. Lakad."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "Don't smirk. Keep walking.",
          "TL": "Huwag kang ngumisi. Magpatuloy sa paglalakad."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "That was the minimum requirement.",
          "TL": "Iyon ang pinakamababang kailangan."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "You hit it. Congratulations on living.",
          "TL": "Tinamaan mo. Binabati kita sa pananatiling buhay."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "Save the pride for when we're safe.",
          "TL": "Itago ang yabang kapag ligtas na tayo."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Routine takedown. Move on.",
          "TL": "Pangkaraniwang patay. Tuloy."
        }
      }
    ]
  },

{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "social.relationship",
  "id": "proposal",
  "owner": "ProjectHoomans",
  "invoke": {
    "intent": "REQUEST",
    "action": "RELATIONSHIP_PROPOSAL"
  },
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "relationship.partner_accepted"
  ],
  "closure": {
    "closureClass": "state_transition"
  },
  "statePolicy": [
    {
      "id": "already_partner",
      "when": {
        "path": "relationship.state",
        "op": "in",
        "values": [
          "lover",
          "partner",
          "spouse"
        ]
      },
      "outcome": "already_satisfied",
      "reason": "already_partner",
      "admission": "no_op",
      "replyOutcome": "already_partner"
    },
    {
      "id": "ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "already_partner": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "accepted": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "rejected": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "settlement_relationship",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "relationship",
      "domain": "settlement_relationship"
    }
  ]
}

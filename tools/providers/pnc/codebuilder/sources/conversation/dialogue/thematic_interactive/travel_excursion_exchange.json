              "subject": "EXCURSION"
            },
            {
              "intent": "REFUSE",
              "speechAct": "REFUSE"
            }
          ]
        },
        "departing": {
          "terminal": true
        },
        "postponed_route": {
          "terminal": true
        },
        "called_off": {
          "terminal": true
        }
      }
    },

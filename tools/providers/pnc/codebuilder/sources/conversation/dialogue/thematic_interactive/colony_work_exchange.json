{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "colony.work",
  "id": "status_exchange",
  "owner": "ProjectHoomans",
  "inputPolicy": "typed_parity",
  "repeatPolicy": "repeatable",
  "closure": {
    "closureClass": "resolved_episode",
    "episodeId": "colony_work_status_exchange"
  },
  "statePolicy": [
    {
      "id": "blocked_unsafe_or_hostile",
      "when": {
        "any": [
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "npcState.healthState",
            "op": "in",
            "values": [
              "dead",
              "incapacitated"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          }
        ]
      },
      "outcome": "blocked",
      "reason": "hostile_combat_or_incapacitated",
      "admission": "no_op",
      "replyOutcome": "refused"
    },
    {
      "id": "colony_work_ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "agreed": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "deferred": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "checked_in": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "refused": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "metadata": {
    "triggers": [
      {
        "intent": "QUESTION",
        "subject": "COLONY_WORK"
      },
      {
        "intent": "INFORM",
        "subject": "COLONY_WORK"
      }
    ],
    "flow": {
      "id": "colony.work.status_exchange",
      "version": 1,
      "owner": "ProjectHoomans",
      "constraints": {
        "all": [
          {
            "path": "npcState.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "neq",
            "value": true
          },
          {
            "path": "npcState.healthState",
            "op": "not_in",
            "values": [
              "dead",
              "incapacitated"
            ]
          }
        ]
      },
      "initial": "check_chore_status",
      "nodes": {
        "check_chore_status": {
          "slots": {
            "task": {
              "type": "string",
              "owner": "colony.work.status_exchange",
              "source": "slots.task.value"
            },
            "settlement": {
              "type": "string",
              "owner": "colony.work.status_exchange",
              "source": "slots.settlement.value"
            }
          },
          "branchOffers": [
            {
              "id": "colony.work.offer_help",
              "labelKey": "UI_PNC_ColonyWork_OfferHelp_Label",
              "labelFallback": "Pitch in on the chore",
              "utteranceKey": "UI_PNC_ColonyWork_OfferHelp_Utterance",
              "utteranceFallback": "Need another pair of hands on that?",
              "consumers": [
                "participant"
              ],
              "frame": {
                "intent": "OFFER",
                "speechAct": "OFFER",
                "subject": "COLONY_WORK"
              }
            },
            {
              "id": "colony.work.clarify_task",
              "labelKey": "UI_PNC_ColonyWork_ClarifyTask_Label",
              "labelFallback": "Ask which job needs doing",
              "utteranceKey": "UI_PNC_ColonyWork_ClarifyTask_Utterance",
              "utteranceFallback": "Are we talking about the back fence or the rain barrels?",
              "consumers": [
                "participant"
              ],
              "frame": {
                "intent": "CLARIFY",
                "speechAct": "CLARIFY",
                "subject": "COLONY_WORK"
              }
            },
            {
              "id": "colony.work.defer_shift",
              "labelKey": "UI_PNC_ColonyWork_DeferShift_Label",
              "labelFallback": "Hold off until later",
              "utteranceKey": "UI_PNC_ColonyWork_DeferShift_Utterance",
              "utteranceFallback": "Better leave the hammering until morning.",
              "consumers": [
                "participant"
              ],
              "frame": {
                "intent": "SUGGEST",
                "speechAct": "SUGGEST",
                "subject": "COLONY_WORK",
                "stateValue": "deferred"
              }
            }
          ],
          "accepts": [
            {
              "intent": "OFFER",
              "speechAct": "OFFER",
              "subject": "COLONY_WORK"
            },
            {
              "intent": "SUGGEST",
              "speechAct": "SUGGEST",
              "subject": "COLONY_WORK",
              "stateValue": "deferred"
            },
            {
              "intent": "CLARIFY",
              "speechAct": "CLARIFY",
              "subject": "COLONY_WORK"
            }
          ],
          "onMatch": "confirm_assignment",
          "onClarify": "clarify_chore",
          "onRefuse": "declined",
          "onUnrelated": "suspend"
        },
        "clarify_chore": {
          "slots": {
            "task": {
              "type": "string",
              "owner": "colony.work.status_exchange",
              "source": "slots.task.value"
            }
          },
          "accepts": [
            {
              "intent": "INFORM",
              "speechAct": "INFORM",
              "subject": "COLONY_WORK"
            },
            {
              "intent": "OFFER",
              "speechAct": "OFFER",
              "subject": "COLONY_WORK"
            },
            {
              "intent": "AGREE",
              "speechAct": "AGREE",
              "subject": "COLONY_WORK"
            }
          ],
          "onMatch": "confirm_assignment",
          "onRefuse": "declined",
          "onUnrelated": "suspend"
        },
        "confirm_assignment": {
          "branchOffers": [
            {
              "id": "colony.work.agree_plan",
              "labelKey": "UI_PNC_ColonyWork_AgreePlan_Label",
              "labelFallback": "Agree to split the work",
              "utteranceKey": "UI_PNC_ColonyWork_AgreePlan_Utterance",
              "utteranceFallback": "Alright, I'll grab the hammer and meet you out back.",
              "consumers": [
                "participant"
              ],
              "frame": {
                "intent": "AGREE",
                "speechAct": "AGREE",
                "subject": "COLONY_WORK"
              }
            },
            {
              "id": "colony.work.pause_later",
              "labelKey": "UI_PNC_ColonyWork_PauseLater_Label",
              "labelFallback": "Pick it up later",
              "utteranceKey": "UI_PNC_ColonyWork_PauseLater_Utterance",
              "utteranceFallback": "Keep an eye on it; we'll finish it at first light.",
              "consumers": [
                "participant"
              ],
              "frame": {
                "intent": "DEFER",
                "speechAct": "DEFER",
                "subject": "COLONY_WORK"
              }
            }
          ],
          "accepts": [
            {
              "intent": "AGREE",
              "speechAct": "AGREE",
              "subject": "COLONY_WORK"
            },
            {
              "intent": "ACCEPT"
            },
            {
              "intent": "DEFER",
              "speechAct": "DEFER",
              "subject": "COLONY_WORK"
            }
          ],
          "onMatch": "agreed",
          "onRefuse": "declined",
          "onUnrelated": "suspend"
        },
        "agreed": {
          "terminal": true
        },
        "declined": {
          "terminal": true
        }
      }
    },
    "replySemantics": {
      "agreed": {
        "stance": "positive",
        "outcome": "agreed"
      },
      "deferred": {
        "stance": "contextual",
        "outcome": "deferred"
      },
      "checked_in": {
        "stance": "neutral",
        "outcome": "checked_in"
      },
      "refused": {
        "stance": "negative",
        "outcome": "refused"
      }
    }
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "colony",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "colony_work",
      "domain": "colony"
    }
  ]
}

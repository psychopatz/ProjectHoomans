            {
              "intent": "INFORM",
              "speechAct": "INFORM",
              "subject": "COMBAT_AFTERMATH"
            },
            {
              "intent": "WARN",
              "speechAct": "WARN",
              "subject": "COMBAT_AFTERMATH",
              "stateValue": "gunfire"
            },
            {
              "intent": "REQUEST",
              "speechAct": "REQUEST",
              "subject": "COMBAT_AFTERMATH",
              "stateValue": "injured"
            },
            {
              "intent": "REFUSE",
              "speechAct": "REFUSE"
            }
          ]

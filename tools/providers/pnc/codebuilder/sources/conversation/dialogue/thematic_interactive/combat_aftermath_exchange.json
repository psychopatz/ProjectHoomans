{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "combat.aftermath",
  "id": "debrief_exchange",
  "owner": "ProjectHoomans",
  "inputPolicy": "typed_parity",
  "repeatPolicy": "repeatable",
  "closure": {
    "closureClass": "resolved_episode",
    "episodeId": "combat_aftermath_debrief_exchange"
  },
  "statePolicy": [
    {
      "id": "blocked_unsafe_or_hostile",
      "when": {
        "any": [
          {
            "path": "npcState.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "npcState.healthState",
            "op": "in",
            "values": [
              "dead",
              "incapacitated"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "==",
            "value": true
          }
        ]
      },
      "outcome": "blocked",
      "reason": "hostile_combat_or_incapacitated",
      "admission": "no_op",
      "replyOutcome": "refused"
    },
    {
      "id": "combat_aftermath_ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "debriefed": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin"
        ]
      }
    },
    "cleared": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "colony.work.status_exchange"
        ]
      }
    },
    "shaken": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin"
        ]
      }
    },
    "refused": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "corroborated": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      },
      "after": {
        "recommend": [
          "wellbeing.needs.checkin",
          "travel.excursion.plan_exchange"
        ]
      }
    },
    "contradicted": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    },
    "withdraw": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "metadata": {
    "triggers": [
      {
        "intent": "QUESTION",
        "subject": "COMBAT_AFTERMATH"
      },
      {
        "intent": "INFORM",
        "subject": "COMBAT_AFTERMATH"
      }
    ],
    "flow": {
      "id": "combat.aftermath.debrief_exchange",
      "version": 1,
      "owner": "ProjectHoomans",
      "constraints": {
        "all": [
          {
            "path": "npcState.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "situation.activeBehavior",
            "op": "not_in",
            "values": [
              "hostile",
              "combat",
              "busy",
              "dead"
            ]
          },
          {
            "path": "roles.hostile",
            "op": "neq",
            "value": true
          },
          {
            "path": "npcState.healthState",
            "op": "not_in",
            "values": [
              "dead",
              "incapacitated"
            ]
          }
        ]
      },
      "initial": "catch_breath",

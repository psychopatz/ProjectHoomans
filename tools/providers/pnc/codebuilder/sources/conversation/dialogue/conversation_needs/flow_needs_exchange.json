{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "flow.needs",
  "id": "exchange",
  "owner": "ProjectHoomans",
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "needs.exchange_closed"
  ],
  "closure": {
    "closureClass": "resolved_episode",
    "episodeId": "needs_exchange"
  },
  "statePolicy": [
    {
      "id": "needs_proposal_accepted",
      "when": {
        "path": "flow.nodeId",
        "op": "==",
        "value": "proposal_pending"
      },
      "outcome": "actionable",
      "reason": "proposal_complete",
      "admission": "dispatch",
      "replyOutcome": "completed"
    },
    {
      "id": "needs_inquiry_ready",
      "outcome": "actionable",
      "reason": "ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "variants": [
      {
        "id": "default"
      }
    ]
  },
  "reply": {
    "completed": {
      "say": {
        "variants": [
          {
            "id": "default"
          }
        ]
      }
    }
  },
  "metadata": {
    "triggers": [
      {
        "intent": "QUESTION",
        "subject": "NEEDS"
      }
    ],
    "flow": {
      "id": "needs",
      "version": 1,
      "owner": "ProjectHoomans",
      "initial": "await_player_quantity",
      "nodes": {
        "await_player_quantity": {
          "responsePool": "semantic.question.needs.offer",
          "accepts": [
            {
              "intent": "QUESTION",
              "subject": "QUANTITY"
            },
            {
              "intent": "CLARIFY",
              "speechAct": "CLARIFY",
              "subject": "NEEDS"
            }
          ],
          "requiredSlots": [
            "quantity"
          ],
          "sourceFactRefs": [
            "npc.needs"
          ],
          "onMatch": "quantity_answer",
          "onClarify": "clarification",
          "onRefuse": "cancel",
          "onUnrelated": "suspend"
        },
        "clarification": {
          "responsePool": "semantic.question.needs.quantity",
          "accepts": [
            {
              "intent": "QUESTION",
              "subject": "QUANTITY"
            },
            {
              "intent": "CLARIFY",
              "speechAct": "CLARIFY",
              "subject": "NEEDS"
            }
          ],
          "requiredSlots": [
            "quantity"
          ],
          "sourceFactRefs": [
            "npc.needs"
          ],
          "onMatch": "quantity_answer",
          "onClarify": "clarification",
          "onRefuse": "cancel",
          "onUnrelated": "suspend"
        },
        "quantity_answer": {
          "responsePool": "semantic.question.needs.quantity",
          "accepts": [
            {
              "intent": "PROMISE",
              "speechAct": "PROMISE",
              "subject": "NEEDS"
            }
          ],
          "requiredSlots": [
            "offer"
          ],
          "sourceFactRefs": [
            "npc.needs"
          ],
          "pendingKind": "PROPOSAL",
          "onMatch": "proposal_pending",
          "onRefuse": "cancel",
          "onUnrelated": "suspend"
        },
        "proposal_pending": {
          "responsePool": "semantic.question.needs.proposal",
          "accepts": [
            {
              "intent": "ACCEPT"
            },
            {
              "intent": "AGREE"
            }
          ],
          "requiredSlots": [
            "confirmation"
          ],
          "sourceFactRefs": [
            "npc.needs"
          ],
          "pendingKind": "PROPOSAL",
          "onMatch": "complete",
          "onRefuse": "cancel",
          "onUnrelated": "suspend"
        },
        "complete": {
          "terminal": true,
          "responsePool": "semantic.question.needs.proposal"
        }
      }
    }
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "social",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "social_interaction",
      "domain": "social"
    }
  ]
}

    "variants": [
      {
        "id": "neutral.01",
        "text": {
          "EN": "It's over. Stay close to me.",
          "TL": "Tapos na. Dumikit ka sa akin."
        }
      },
      {
        "id": "neutral.02",
        "text": {
          "EN": "He's dead. Keep tight on my shoulder.",
          "TL": "Patay na siya. Dumikit ka lang sa balikat ko."
        }
      },
      {
        "id": "neutral.03",
        "text": {
          "EN": "Fight's ending. Don't wander off.",
          "TL": "Pahupa na ang laban. Huwag kang lalayo."
        }
      },
      {
        "id": "neutral.04",
        "text": {
          "EN": "He won't hurt us now. Stay near.",
          "TL": "Hindi na niya tayo masasaktan. Manatili sa malapit."
        }
      },
      {
        "id": "neutral.05",
        "text": {
          "EN": "Target down. Stick close while we clear.",
          "TL": "Bagsak ang target. Dumikit habang naglilinis tayo."
        }
      },
      {
        "id": "neutral.06",
        "text": {
          "EN": "Got him. Stay behind cover with me.",
          "TL": "Nakuha ko na. Dito ka sa kublihan kasama ko."
        }
      },
      {
        "id": "neutral.07",
        "text": {
          "EN": "It's handled. We stick together.",
          "TL": "Naasikaso na. Magsama tayo."
        }
      },
      {
        "id": "neutral.08",
        "text": {
          "EN": "Threat dropped. Keep close until it's quiet.",
          "TL": "Bagsak ang banta. Dumikit hanggang tumahimik."
        }
      },
      {
        "id": "neutral.09",
        "text": {
          "EN": "He's finished. I've got your back.",
          "TL": "Tapos na siya. Hawak ko ang likod mo."
        }
      },
      {
        "id": "neutral.10",
        "text": {
          "EN": "Down. Don't leave my side.",
          "TL": "Bagsak. Huwag kang aalis sa tabi ko."
        }
      }
    ]

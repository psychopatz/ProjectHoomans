      {
        "id": "neutral.07",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.07"
        },
        "text": {
          "EN": "I won't last long without treatment! Now!",
          "TL": "Hindi ako magtatagal nang walang gamot! Ngayon na!"

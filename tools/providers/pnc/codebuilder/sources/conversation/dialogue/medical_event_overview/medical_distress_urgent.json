        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.06"
        },
        "text": {
          "EN": "Severe injury! Drop what you're doing and help me!",
          "TL": "Malubhang pinsala! Bitawan ang ginagawa mo at tulungan mo ako!"
        }

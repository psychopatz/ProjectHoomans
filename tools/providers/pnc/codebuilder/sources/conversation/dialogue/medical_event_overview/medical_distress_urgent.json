          "textKey": "semantic.medical.distress.urgent.neutral.02"
        },
        "text": {
          "EN": "Emergency! I need immediate medical attention!",
          "TL": "Kagipitan! Kailangan ko ng agarang gamot ngayon din!"
        }
      },
      {
        "id": "neutral.03",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.03"
        },
        "text": {
          "EN": "Hit bad! Come over here right now!",
          "TL": "Grabe ang tama ko! Halika rito ngayon din!"
        }
      },
      {
        "id": "neutral.04",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.04"
        },
        "text": {
          "EN": "Urgent! I'm bleeding and falling down!",
          "TL": "Apurahan! Dumurugo ako at bumabagsak!"
        }
      },
      {
        "id": "neutral.05",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.05"
        },
        "text": {
          "EN": "I need aid this second! Hurry!",
          "TL": "Kailangan ko ng gamot sa segundong ito! Bilis!"
        }
      },
      {

        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.08"
        },
        "text": {
          "EN": "Critical wound! Bandage me now!",
          "TL": "Kritikal na sugat! Bendahan mo ako ngayon din!"
        }
      },
      {
        "id": "neutral.09",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.09"
        },
        "text": {
          "EN": "I'm going down hard! Medic, help me!",
          "TL": "Bumabagsak na ako! Saklolo, tulungan mo ako!"
        }
      },
      {
        "id": "neutral.10",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.urgent.neutral.10"
        },
        "text": {
          "EN": "Urgent distress! Someone patch me up right now!",
          "TL": "Apurahang saklolo! May magbenda sa akin ngayon din!"

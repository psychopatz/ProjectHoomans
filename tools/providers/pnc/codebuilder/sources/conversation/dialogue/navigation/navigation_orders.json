          },
          {
            "id": "guarded.07",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.orders.guarded.07"
            },
            "text": {
              "EN": "What do you need done? Don't waste my time.",
              "TL": "Ano'ng kailangang gawin? Huwag sayangin ang oras ko."
            }
          },

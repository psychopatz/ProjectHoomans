          {
            "id": "guarded.06",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.orders.guarded.06"
            },
            "text": {
              "EN": "I'm listening to commands, but I judge safety.",
              "TL": "Nakikinig ako sa utos, pero ako ang humahatol sa kaligtasan."

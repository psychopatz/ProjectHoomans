          },
          {
            "id": "guarded.03",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.orders.guarded.03"
            },
            "text": {
              "EN": "What do you want me to do? Nothing reckless.",
              "TL": "Ano'ng gusto mong gawin ko? Huwag mapusok."
            }
          },
          {
            "id": "guarded.04",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.orders.guarded.04"
            },
            "text": {
              "EN": "Give the order, but watch my back.",
              "TL": "Ibigay ang utos, pero bantayan mo likod ko."
            }
          },
          {
            "id": "guarded.05",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.orders.guarded.05"
            },
            "text": {
              "EN": "What's the directive? Make it sensible.",
              "TL": "Ano'ng direktiba? Gawing may kabuluhan."

      },
      "response": {
        "act": "NAVIGATION_RESPONSE",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.01"
            },
            "text": {
              "EN": "Where should we set up?",
              "TL": "Saan tayo pupuwesto?"
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.02"
            },
            "text": {
              "EN": "Which location are you considering for camp?",
              "TL": "Aling lokasyon ang iniisip mo para sa kampo?"
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.03"
            },
            "text": {
              "EN": "Where do you want to establish our rest site?",
              "TL": "Saan mo gustong itayo ang pahingahan natin?"
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.04"
            },
            "text": {
              "EN": "Where are we making camp today?",
              "TL": "Saan tayo magtatayo ng kampo ngayon?"
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.05"
            },
            "text": {
              "EN": "Point out the spot you have in mind.",
              "TL": "Ituro mo ang pwestong nasa isip mo."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.06"
            },
            "text": {
              "EN": "Where should we pitch our camp?",
              "TL": "Saan natin ilalatag ang kampo?"
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.07"
            },
            "text": {
              "EN": "Which area looks suitable for stopping?",
              "TL": "Aling lugar ang mukhang angkop para huminto?"
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.08"
            },
            "text": {
              "EN": "Where do you want to place the campsite?",
              "TL": "Saan mo gustong ilagay ang campsite?"
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.09"
            },
            "text": {
              "EN": "Tell me where you want to settle down.",
              "TL": "Sabihin mo kung saan mo gustong tumigil."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp.neutral.10"
            },
            "text": {
              "EN": "Where are we setting our base for the night?",
              "TL": "Saan natin itatayo ang base natin para sa gabi?"
            }
          }
        ]
      },
      "namespace": "semantic.navigation.camp"
    },
    {
      "kind": "dialogue",
      "id": "warm",

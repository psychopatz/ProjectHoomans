      },
      "response": {
        "act": "NAVIGATION_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.01"
            },
            "text": {
              "EN": "Where should we set up camp?",
              "TL": "Saan tayo magtatayo ng kampo?"
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.02"
            },
            "text": {
              "EN": "Where would you like us to settle down, friend?",
              "TL": "Saan mo gustong huminto tayo, kaibigan?"
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.03"
            },
            "text": {
              "EN": "Found a cozy spot for us to rest?",
              "TL": "May nahanap ka bang maaliwalas na lugar para makapagpahinga?"
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.04"
            },
            "text": {
              "EN": "Where shall we make our camp today?",
              "TL": "Saan natin gagawin ang kampo natin ngayon?"
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.05"
            },
            "text": {
              "EN": "I'm happy to camp wherever you feel safe.",
              "TL": "Masaya akong magkampo kahit saan basta ligtas ka."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.06"
            },
            "text": {
              "EN": "Lead on to our camp spot. I'm right with you.",
              "TL": "Manguna ka sa campsite natin. Kasama mo ako."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.07"
            },
            "text": {
              "EN": "Where do you think we can rest easy tonight?",
              "TL": "Saan sa tingin mo tayo makakapagpahinga nang mapayapa ngayong gabi?"
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.08"
            },
            "text": {
              "EN": "Any spot you choose works for me.",
              "TL": "Kahit anong pwestong piliin mo, ayos sa akin."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.09"
            },
            "text": {
              "EN": "Let's find somewhere warm and secure to camp.",
              "TL": "Maghanap tayo ng maaliwalas at ligtas na lugar para magkampo."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp.warm.10"
            },
            "text": {
              "EN": "Where would you like to put down our packs?",
              "TL": "Saan mo gustong ibaba ang mga gamit natin?"
            }
          }
        ]
      },
      "namespace": "semantic.navigation.camp"
    },

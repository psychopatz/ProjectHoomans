      "response": {
        "act": "NAVIGATION_RESPONSE",
        "variants": [
          {
            "id": "guarded.01",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.01"
            },
            "text": {
              "EN": "Where do you want to risk it?",
              "TL": "Saan mo gustong makipagsapalaran?"
            }
          },
          {
            "id": "guarded.02",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.02"
            },
            "text": {
              "EN": "Which spot are you eyeing? Better be defendable.",
              "TL": "Aling pwesto ang tinitignan mo? Dapat kayang depensahan."
            }
          },
          {
            "id": "guarded.03",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.03"
            },
            "text": {
              "EN": "Make sure it has more than one exit.",
              "TL": "Siguraduhing may higit sa isang labasan."
            }
          },
          {
            "id": "guarded.04",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.04"
            },
            "text": {
              "EN": "Where do you want to hole up? Don't pick a trap.",
              "TL": "Saan mo gustong magtago? Huwag sa bitag."
            }
          },
          {
            "id": "guarded.05",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.05"
            },
            "text": {
              "EN": "Which site? I don't want us cornered.",
              "TL": "Aling lugar? Ayaw kong maipit tayo."
            }
          },
          {
            "id": "guarded.06",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.06"
            },
            "text": {
              "EN": "Pick carefully. A bad camp gets us killed.",
              "TL": "Pumili nang maigi. Ang maling kampo ay ikamamatay natin."
            }
          },
          {
            "id": "guarded.07",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.07"
            },
            "text": {
              "EN": "Where? I need to see the choke points first.",
              "TL": "Saan? Kailangan kong makita ang mga harang muna."
            }
          },
          {
            "id": "guarded.08",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.08"
            },
            "text": {
              "EN": "Where are you planning to bed down? Watch the perimeter.",
              "TL": "Saan mo balak matulog? Bantayan ang paligid."
            }
          },
          {
            "id": "guarded.09",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.09"
            },
            "text": {
              "EN": "Show me where. I'll inspect the sightlines.",
              "TL": "Ituro mo kung saan. Susuriin ko ang tanawin."
            }
          },
          {
            "id": "guarded.10",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp.guarded.10"
            },
            "text": {
              "EN": "Where? We need high ground or solid barricades.",
              "TL": "Saan? Kailangan natin ng mataas na lugar o matatag na barikada."
            }
          }
        ]
      },
      "namespace": "semantic.navigation.camp"

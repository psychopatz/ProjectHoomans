        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.01"
            },
            "text": {
              "EN": "I don't see a good place to set up here.",
              "TL": "Wala akong nakikitang magandang mapagpuwestuhan dito."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.02"
            },
            "text": {
              "EN": "This area lacks suitable spots for a camp.",
              "TL": "Kulang ang lugar na 'to sa maayos na pwesto para sa kampo."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.03"
            },
            "text": {
              "EN": "Nowhere practical to establish camp around here.",
              "TL": "Walang praktikal na mapagtatayuan ng kampo rito."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.04"
            },
            "text": {
              "EN": "We should look elsewhere. No good campsites here.",
              "TL": "Dapat tayong maghanap sa iba. Walang magandang campsite dito."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.05"
            },
            "text": {
              "EN": "Doesn't look like we can camp in this vicinity.",
              "TL": "Mukhang hindi tayo makakapagkampo sa lugar na 'to."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.06"
            },
            "text": {
              "EN": "There are no secure structures or clear ground here.",
              "TL": "Walang ligtas na gusali o maayos na lupa rito."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.07"
            },
            "text": {
              "EN": "Can't find a decent place to bed down here.",
              "TL": "Walang makitang maayos na mahihigaan dito."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.08"
            },
            "text": {
              "EN": "No campsite available here. Let's keep searching.",
              "TL": "Walang campsite dito. Patuloy tayong maghanap."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.09"
            },
            "text": {
              "EN": "This location isn't viable for setting up camp.",
              "TL": "Hindi angkop ang lokasyong 'to para magtayo ng kampo."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.navigation.camp_empty.neutral.10"
            },
            "text": {
              "EN": "Nothing suitable nearby. We need to move on.",
              "TL": "Walang angkop sa malapit. Kailangan nating magpatuloy."
            }
          }
        ]
      },
      "namespace": "semantic.navigation.camp_empty"

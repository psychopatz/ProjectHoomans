      "response": {
        "act": "NAVIGATION_RESPONSE",
        "variants": [
          {
            "id": "guarded.01",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.01"
            },
            "text": {
              "EN": "There is nowhere safe to set up here.",
              "TL": "Walang ligtas na mapagpuwestuhan dito."
            }
          },
          {
            "id": "guarded.02",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.02"
            },
            "text": {
              "EN": "This place is wide open. We'd get slaughtered.",
              "TL": "Masyadong lantad ang lugar na 'to. Papaslangin tayo rito."
            }
          },
          {
            "id": "guarded.03",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.03"
            },
            "text": {
              "EN": "No cover, no defenses. We can't stay here.",
              "TL": "Walang kublihan, walang depensa. Hindi tayo pwedeng manatili rito."
            }
          },
          {
            "id": "guarded.04",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.04"
            },
            "text": {
              "EN": "I won't camp in this death trap. Move on.",
              "TL": "Hindi ako magkakampo sa bitag na 'to. Lakad pa."
            }
          },
          {
            "id": "guarded.05",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.05"
            },
            "text": {
              "EN": "Zero security here. We'd be sitting ducks.",
              "TL": "Walang kaligtasan dito. Magiging madaling target tayo."
            }
          },
          {
            "id": "guarded.06",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.06"
            },
            "text": {
              "EN": "Not a single defensible corner. Keep walking.",
              "TL": "Wala man lang madedepensahang sulok. Tuloy sa paglakad."
            }
          },
          {
            "id": "guarded.07",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.07"
            },
            "text": {
              "EN": "Sleeping here is suicide. Find real shelter.",
              "TL": "Pagpapatiwakal ang pagtulog dito. Maghanap ng tunay na silungan."
            }
          },
          {
            "id": "guarded.08",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.08"
            },
            "text": {
              "EN": "Nothing here keeps the dead out. No camp.",
              "TL": "Walang haharang sa mga patay dito. Walang kampo."
            }
          },
          {
            "id": "guarded.09",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.09"
            },
            "text": {
              "EN": "Too exposed. I refuse to rest here.",
              "TL": "Masyadong lantad. Ayaw kong magpahinga rito."
            }
          },
          {
            "id": "guarded.10",
            "metadata": {
              "style": "guarded",
              "textKey": "semantic.navigation.camp_empty.guarded.10"
            },
            "text": {
              "EN": "Nowhere to hide if a horde passes. Move.",
              "TL": "Walang matataguan kapag dumaan ang kuyog. Kilos."
            }

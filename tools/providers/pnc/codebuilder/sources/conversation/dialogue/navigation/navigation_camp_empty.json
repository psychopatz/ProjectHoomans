        "act": "NAVIGATION_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.01"
            },
            "text": {
              "EN": "I don't see a safe place to set up here.",
              "TL": "Wala akong nakikitang ligtas na mapagpuwestuhan dito."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.02"
            },
            "text": {
              "EN": "I'd rather find us a warmer, safer spot than this.",
              "TL": "Mas gusto kong humanap tayo ng mas komportable at ligtas na lugar."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.03"
            },
            "text": {
              "EN": "Nothing comfortable or secure around here, I'm afraid.",
              "TL": "Walang komportable o ligtas dito, sa kasamaang palad."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.04"
            },
            "text": {
              "EN": "Let's keep looking. You deserve a better resting spot.",
              "TL": "Maghanap pa tayo. Karapat-dapat ka sa mas magandang pahingahan."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.05"
            },
            "text": {
              "EN": "This area doesn't feel right for us. Let's walk a bit more.",
              "TL": "Hindi maganda ang pakiramdam ko sa lugar na 'to. Lakad pa tayo."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.06"
            },
            "text": {
              "EN": "We can do better than this place. Let's find real shelter.",
              "TL": "Makakahanap pa tayo ng mas maayos kaysa rito. Maghanap tayo ng maayos na bubong."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.07"
            },
            "text": {
              "EN": "I want us both safe tonight. No good camp here.",
              "TL": "Gusto kong ligtas tayong dalawa ngayong gabi. Walang magandang kampo rito."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.08"
            },
            "text": {
              "EN": "Let's find somewhere cozy before we stop.",
              "TL": "Maghanap tayo ng mas maaliwalas bago huminto."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.09"
            },
            "text": {
              "EN": "I don't think we'd get any peaceful sleep here.",
              "TL": "Sa tingin ko hindi tayo makakatulog nang mahimbing dito."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.navigation.camp_empty.warm.10"
            },
            "text": {
              "EN": "Come on, let's look further ahead for a proper camp.",
              "TL": "Halika, maghanap tayo sa unahan para sa totoong kampo."
            }
          }
        ]
      },
      "namespace": "semantic.navigation.camp_empty"

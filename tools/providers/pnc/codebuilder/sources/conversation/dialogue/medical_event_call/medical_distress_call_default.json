          "textKey": "semantic.medical.distress.call.default.neutral.01"
        },
        "text": {
          "EN": "I'm down! I need help over here!",
          "TL": "Bagsak ako! Kailangan ko ng tulong dito!"
        }
      },
      {
        "id": "neutral.02",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.02"
        },
        "text": {
          "EN": "Can't stand! Someone help me up!",
          "TL": "Hindi ako makatayo! Tulungan niyo akong makatayo!"
        }
      },
      {
        "id": "neutral.03",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.03"
        },
        "text": {
          "EN": "I'm hit! Get over here!",
          "TL": "Tinamaan ako! Halika rito!"
        }
      },
      {
        "id": "neutral.04",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.04"
        },
        "text": {
          "EN": "Need medical attention immediately!",
          "TL": "Kailangan ko ng agarang panggagamot!"
        }
      },
      {
        "id": "neutral.05",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.05"
        },
        "text": {
          "EN": "Down and helpless! Don't leave me!",
          "TL": "Bagsak at walang laban! Huwag niyo akong iwan!"
        }
      },
      {
        "id": "neutral.06",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.06"
        },
        "text": {
          "EN": "I took a bad fall! Help me!",
          "TL": "Napasama ang bagsak ko! Tulungan mo ako!"
        }
      },
      {
        "id": "neutral.07",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.07"
        },
        "text": {
          "EN": "Can't get back on my feet! Help!",
          "TL": "Hindi ako makabangon! Tulong!"
        }

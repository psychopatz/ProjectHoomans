      {
        "id": "neutral.08",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.08"
        },
        "text": {
          "EN": "Hurt bad! Over here, please!",
          "TL": "Malubha ang tama ko! Dito, pakiusap!"

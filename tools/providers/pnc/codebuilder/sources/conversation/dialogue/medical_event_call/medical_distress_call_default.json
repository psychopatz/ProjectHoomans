      {
        "id": "neutral.09",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.09"
        },
        "text": {
          "EN": "I'm down on the ground! Need a hand!",
          "TL": "Nasa sahig ako! Pasaklolo naman!"
        }
      },
      {
        "id": "neutral.10",
        "metadata": {
          "style": "neutral",
          "textKey": "semantic.medical.distress.call.default.neutral.10"
        },
        "text": {

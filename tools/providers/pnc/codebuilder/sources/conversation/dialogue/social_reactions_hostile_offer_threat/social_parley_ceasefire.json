{
  "schema": "psychopatz.convo-engine.v1",
  "kind": "dialogue",
  "namespace": "social.parley",
  "id": "ceasefire",
  "owner": "ProjectHoomans",
  "invoke": {
    "intent": "REQUEST",
    "action": "CEASEFIRE"
  },
  "inputPolicy": "typed_parity",
  "repeatPolicy": "state_retired",
  "postconditions": [
    "relationship.ceasefire_active"
  ],
  "closure": {
    "closureClass": "state_transition"
  },
  "statePolicy": [
    {
      "id": "already_peaceful",
      "when": {
        "path": "roles.hostile",
        "op": "neq",
        "value": true
      },
      "outcome": "already_satisfied",
      "reason": "not_hostile",
      "admission": "no_op",
      "replyOutcome": "already_peaceful"
    },
    {
      "id": "ready",
      "outcome": "actionable",
      "reason": "hostile_parley_ready",
      "admission": "dispatch"
    }
  ],
  "say": {
    "EN": "Let's call a ceasefire.",
    "TL": "Itigil na natin ang away."
  },
  "reply": {
    "already_peaceful": {
      "say": {
        "EN": "We aren't fighting.",
        "TL": "Hindi naman tayo nag-aaway."
      }
    },
    "accepted": {
      "say": {
        "EN": "Fine. Stand down.",
        "TL": "Sige. Tigil-putukan."
      }
    }
  }
}

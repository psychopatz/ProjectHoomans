        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/social/reactions/hostile.json",
        "responseTemplateID": "semantic.social.hostile_withdrawn",
        "style": "warm"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "warm.01",
            "text": {
              "EN": "I just need some time alone, friend. Please.",
              "TL": "Kailangan ko lang ng oras mag-isa, kaibigan. Pakiusap."
            }
          },
          {
            "id": "warm.02",
            "text": {
              "EN": "It's not you, I promise. I just need to be by myself.",
              "TL": "Hindi ikaw ang may sala, pangako. Kailangan ko lang mapag-isa."
            }
          },
          {
            "id": "warm.03",
            "text": {
              "EN": "Please give me some quiet time. We'll talk later.",
              "TL": "Pakiusap bigyan mo ako ng katahimikan. Mag-usap tayo mamaya."
            }
          },
          {
            "id": "warm.04",
            "text": {
              "EN": "I'm in a dark headspace. I don't want to bring you down with me.",
              "TL": "Mabigat ang iniisip ko. Ayokong mahawa ka sa akin."
            }
          },
          {
            "id": "warm.05",
            "text": {
              "EN": "I need to withdraw for a little while. Take care of yourself.",
              "TL": "Kailangan ko munang lumayo sandali. Ingatan mo sarili mo."
            }
          },
          {
            "id": "warm.06",
            "text": {
              "EN": "Let me sit in the quiet. I'll find you when I'm ready.",
              "TL": "Hayaan mo muna akong maupo sa tahimik. Hahanapin kita kapag handa na."
            }
          },
          {
            "id": "warm.07",
            "text": {
              "EN": "Thank you for understanding. I just need space today.",
              "TL": "Salamat sa pag-unawa. Kailangan ko lang ng espasyo ngayon."
            }
          },
          {
            "id": "warm.08",
            "text": {
              "EN": "Don't worry about me, but please let me be for now.",
              "TL": "Huwag kang mag-alala sa 'kin, pero hayaan mo muna ako ngayon."
            }
          },
          {
            "id": "warm.09",
            "text": {
              "EN": "I promise I'll be okay. Just give me this time.",
              "TL": "Pangako magiging maayos ako. Ibigay mo lang ang oras na ito."
            }
          },
          {
            "id": "warm.10",
            "text": {
              "EN": "See you later, friend. I need the silence right now.",
              "TL": "Kita tayo mamaya, kaibigan. Kailangan ko ng katahimikan ngayon."
            }
          }
        ]

    {
      "kind": "dialogue",
      "id": "warm",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:core_social_content",
        "contentOwner": "projecthoomans.dialogue_content.social",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/social/reactions/hostile.json",
        "responseTemplateID": "semantic.social.hostile_short",
        "style": "warm"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "warm.01",
            "text": {
              "EN": "Hey, watch your mouth, friend. We're better than that.",
              "TL": "Huy, ingatan mo ang bibig mo, kaibigan. Mas maayos tayo riyan."
            }
          },
          {
            "id": "warm.02",
            "text": {
              "EN": "Don't talk like that. You're better than this anger.",
              "TL": "Huwag kang magsalita nang ganyan. Higit ka sa galit mong 'yan."
            }
          },
          {
            "id": "warm.03",
            "text": {
              "EN": "Come on, watch your tone with me.",
              "TL": "Sige na, ayusin mo ang tono mo sa akin."
            }
          },
          {
            "id": "warm.04",
            "text": {
              "EN": "Take a breath before you say something you'll regret.",
              "TL": "Huminga ka muna bago ka magsabi ng pagsisisihan mo."
            }
          },
          {
            "id": "warm.05",
            "text": {
              "EN": "I know you're frustrated, but don't lash out at me.",
              "TL": "Alam kong naiinis ka, pero huwag mong ibunton sa akin."
            }
          },
          {
            "id": "warm.06",
            "text": {
              "EN": "Easy now. We're on the same team.",
              "TL": "Dahan-dahan lang. Magkasama tayo rito."
            }
          },
          {
            "id": "warm.07",
            "text": {
              "EN": "Check yourself, partner. I'm with you, not against you.",
              "TL": "Ayusin mo sarili mo, kasama. Kakampi mo ako, hindi kalaban."
            }
          },
          {
            "id": "warm.08",
            "text": {
              "EN": "Don't let the anger win today. Stay with me.",
              "TL": "Huwag mong hayaang manalo ang galit ngayon. Sumama ka sa 'kin."
            }
          },
          {
            "id": "warm.09",
            "text": {
              "EN": "I'm giving you space, but watch what you say.",
              "TL": "Binibigyan kita ng puwang, pero bantayan mo ang sinasabi mo."
            }
          },
          {
            "id": "warm.10",
            "text": {
              "EN": "Hold your words. We can talk when you're calmer.",
              "TL": "Pigilan mo ang salita mo. Mag-usap tayo kapag kalmado ka na."
            }
          }
        ]
      },

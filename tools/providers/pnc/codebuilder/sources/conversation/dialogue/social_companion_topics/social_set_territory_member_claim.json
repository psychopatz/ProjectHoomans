{
  "schema": "psychopatz.convo-engine.v1",
  "id": "social.set_territory.member.claim",
  "when": "conversation.audience == \"member\" && scene.baseEstablished == false",
  "metadata": {
    "runtimeBlockID": "projecthoomans:set_territory_member",
    "category": "projecthoomans:set_territory",
    "audiences": [
      "member"
    ],
    "priority": 1000,
    "textTarget": "convo/social/territory/member/claim",
    "textDomain": "pnc.convo.social.territory.member.claim",
    "textRows": [
      {
        "key": "locked.base_established"
      }
    ]
  },
  "response": {
    "act": "SET_TERRITORY",
    "turns": [
      {
        "id": "opening",
        "metadata": {
          "textKey": "opening"
        },
        "offers": [
          {
            "id": "set_territory",
            "frame": {
              "intent": "REQUEST",
              "speechAct": "REQUEST",
              "subject": "TERRITORY",
              "topic": "territory"
            },
            "metadata": {
              "choiceKey": "choice.set_territory",
              "responseKey": "response.set_territory",
              "close": true,
              "effects": [
                {
                  "type": "pnc:open_territory_claim"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "roles": {
    "speaker": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    },
    "addressee": {
      "cardinality": "ONE",
      "kinds": [
        "actor"
      ]
    }
  },
  "domains": [
    {
      "domain": "social",
      "owner": "ProjectHoomans"
    }
  ],
  "topics": [
    {
      "id": "social_interaction",
      "domain": "social"
    }
  ],
  "owner": "ProjectHoomans"
}

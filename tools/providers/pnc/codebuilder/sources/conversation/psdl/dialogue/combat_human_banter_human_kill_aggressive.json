  "records": [
    {
      "kind": "dialogue",
      "id": "semantic.combat.human_kill.aggressive.line_01",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/aggressive.json",
        "responseTemplateID": "semantic.combat.human_kill.aggressive.line_01",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "He's down. Keep pushing.",
              "TL": "Bagsak na siya. Tuloy ang laban."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Took him out. Don't let up.",
              "TL": "Naitumba ko na. Huwag kayong titigil."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "That one's finished. Push their line.",
              "TL": "Tapos na ang isang 'yon. Wasakin ang linya nila."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Down in the dirt. Keep firing.",
              "TL": "Nalugmok sa lupa. Tuloy ang putok."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "One dead. Press the advantage.",
              "TL": "Isang patay. Samantalahin ang pagkakataon."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Dropped him. Don't give them room to breathe.",
              "TL": "Ibinagsak ko siya. Huwag silang bigyan ng puwang."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "He thought he had us. Keep moving.",
              "TL": "Akala niya kaya tayo. Tuloy lang."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Tore him down. Forward.",
              "TL": "Winasak ko na. Pasulong."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Scratch that bastard. Keep pressing.",
              "TL": "Bawas ang tarantado. Tuloy ang pasok."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "He's bleeding out. Advance on them.",
              "TL": "Umaagos ang dugo niya. Sugurin sila."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "id": "semantic.combat.human_kill.aggressive.line_02",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/aggressive.json",
        "responseTemplateID": "semantic.combat.human_kill.aggressive.line_02",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "One less bastard shooting at us.",
              "TL": "Isang tarantado na lang ang hindi babaril sa atin."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "That's for trying to kill us.",
              "TL": "Para 'yan sa pagsubok mong patayin kami."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Should've stayed in your hole.",
              "TL": "Dapat nanatili ka na lang sa lungga mo."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "He drew down on us. Now he's dead.",
              "TL": "Tinutukan niya tayo. Ngayon patay na siya."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Another shooter down.",
              "TL": "Bagsak ang isa pang bumaril."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "That'll teach 'em to ambush us.",
              "TL": "Matututo silang huwag tayong tambangan."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Good riddance to that one.",
              "TL": "Mabuti nga sa kanya."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Picked the wrong crew to fight.",
              "TL": "Maling grupo ang kinalaban mo."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "He got what he was asking for.",
              "TL": "Nakuha niya ang hinahanap niya."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Dead where he stood.",
              "TL": "Patay kung saan siya nakatayo."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "id": "semantic.combat.human_kill.aggressive.line_03",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/aggressive.json",
        "responseTemplateID": "semantic.combat.human_kill.aggressive.line_03",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Threat's dead. Eyes up.",
              "TL": "Patay na ang banta. Magmatyag."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Dead. Who else wants some?",
              "TL": "Patay na. Sino pa ang susunod?"
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Target eliminated. Keep scanning.",
              "TL": "Target naalis. Tuloy ang pagmamasid."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Down. Check for friends.",
              "TL": "Bagsak. Tignan kung may kasama pa."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "That one's history. Eyes open.",
              "TL": "Burado na ang isang 'yon. Manatiling gising."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Dropped him cold. Next target.",
              "TL": "Bagsak nang walang buhay. Susunod na target."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "He's done. Watch your sectors.",
              "TL": "Tapos na siya. Bantayan ang bawat sulok."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Put him down. Stay ready.",
              "TL": "Ibinagsak ko na. Maging handa."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "No more trouble from that one.",
              "TL": "Wala nang aberya mula sa kanya."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Finished him. Stay locked in.",
              "TL": "Tinapos ko na siya. Huwag mawala sa pokus."
            }
          }
        ]
      }
    }
  ]
}

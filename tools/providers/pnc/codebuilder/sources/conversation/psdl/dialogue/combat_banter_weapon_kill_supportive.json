      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.events",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_banter/weapon_kill/supportive.json",
        "responseTemplateID": "semantic.combat.kill.killer.supportive.firearm_01",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Got it. You good?",
              "TL": "Nakuha ko. Ayos ka?"
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Threat's down. Check yourself.",
              "TL": "Bagsak ang banta. Tignan mo sarili mo."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Downed that one. I've got your back.",
              "TL": "Ibinagsak ko ang isa. Hawak ko ang likod mo."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Clear! You hurt anywhere?",
              "TL": "Malinis! May tama ka ba kahit saan?"
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Got him off us. Stay close.",
              "TL": "Nailayo ko sa atin. Dumikit ka."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Dropped that one. Keep your eyes open.",
              "TL": "Bagsak na 'yon. Manatiling gising ang mata."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Took care of it. Are you alright?",
              "TL": "Inasikaso ko na. Ayos ka lang?"
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Shot landed. You safe?",
              "TL": "Tumama ang putok. Ligtas ka?"
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Target down. Covering you.",
              "TL": "Bagsak ang target. Sinasalag kita."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "That one's finished. Watch the flanks.",
              "TL": "Tapos na ang isang 'yon. Bantayan ang gilid."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "id": "semantic.combat.kill.killer.supportive.melee_01",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.events",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_banter/weapon_kill/supportive.json",
        "responseTemplateID": "semantic.combat.kill.killer.supportive.melee_01",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "It's down. Keep close.",
              "TL": "Bagsak na. Dumikit ka lang."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Got it off you. You alright?",
              "TL": "Nailayo ko sa'yo. Ayos ka lang?"
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Downed it. Check your corners.",
              "TL": "Ibinagsak ko na. Tignan ang sulok mo."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "I'm right here with you. It's dead.",
              "TL": "Nandito lang ako kasama mo. Patay na."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Crushed it before it got close.",
              "TL": "Dinurog bago pa makalapit."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Stay behind me. That one's done.",
              "TL": "Manatili sa likod ko. Tapos na 'yon."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Took it down. Catch your breath.",
              "TL": "Ibinagsak ko na. Huminga ka muna."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Dead on the floor. You holding up?",
              "TL": "Patay sa sahig. Nakakayanan mo pa?"
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "I've got this line. Watch behind us.",
              "TL": "Hawak ko ang linyang 'to. Bantayan ang likod."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "It's over for that one. We're okay.",
              "TL": "Tapos na ang isang 'yon. Ayos lang tayo."
            }
          }
        ]
      }
    }
  ]

        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/cold.json",
        "responseTemplateID": "semantic.combat.human_kill.cold.line_01",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "One less problem.",
              "TL": "Isang problema ang nabawas."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Ammunition well spent.",
              "TL": "Maayos na nagamit ang bala."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "He made his calculation and failed.",
              "TL": "Nagkamali siya sa kalkula niya."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Threat terminated efficiently.",
              "TL": "Mabilis na tinapos ang banta."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "No further resistance from this one.",
              "TL": "Wala nang laban mula sa isang 'to."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "He chose to fight. Result was inevitable.",
              "TL": "Pinili niyang lumaban. Inaasahan ang naging resulta."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Target eliminated without incident.",
              "TL": "Naalis ang target nang walang aberya."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Hostile ceased functioning.",
              "TL": "Tumigil sa paggalaw ang kalaban."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "One shooter off the board.",
              "TL": "Bawas ang isang bumaril sa talaan."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Dead. Expected outcome.",
              "TL": "Patay. Inaasahang kalalabasan."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "id": "semantic.combat.human_kill.cold.line_02",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/cold.json",
        "responseTemplateID": "semantic.combat.human_kill.cold.line_02",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "He's dead. Move.",
              "TL": "Patay na siya. Kilos."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Corpse is of no concern. Step forward.",
              "TL": "Walang silbi ang bangkay. Abante."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Leave him where he fell. Advance.",
              "TL": "Iwan kung saan bumagsak. Sulong."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Casualty confirmed. Continue the route.",
              "TL": "Patay kumpirmado. Ipagpatuloy ang ruta."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Do not stare. Keep moving.",
              "TL": "Huwag tumitig. Tuloy sa paglakad."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Body is neutralized. March on.",
              "TL": "Naitumba na ang katawan. Magmartsa."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "He is irrelevant now. Step over.",
              "TL": "Wala na siyang halaga ngayon. Hakbangan."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Target inactive. Proceed immediately.",
              "TL": "Hindi na aktibo ang target. Magpatuloy agad."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Nothing left to witness here. Move.",
              "TL": "Wala nang panonoorin dito. Kilos."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Down. Keep your focus on living targets.",
              "TL": "Bagsak. Tutukan ang mga buhay pang kalaban."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",
      "id": "semantic.combat.human_kill.cold.line_03",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.combat_human",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_human_banter/human_kill/cold.json",
        "responseTemplateID": "semantic.combat.human_kill.cold.line_03",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Finished. Check the others.",
              "TL": "Tapos na. Tingnan ang iba."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Target expired. Search remaining hostiles.",
              "TL": "Patay na ang target. Hanapin ang iba pang kalaban."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "One confirmed kill. Check their positions.",
              "TL": "Isang kumpirmadong patay. Tignan ang mga posisyon nila."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Handled. Now account for the rest.",
              "TL": "Naasikaso na. Bilangin naman ang natitira."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Done here. Shift focus to secondary contacts.",
              "TL": "Tapos na rito. Ilipat ang pansin sa iba."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "He is dead. Check the perimeter for his group.",
              "TL": "Patay na siya. Tignan ang paligid kung nasaan ang grupo niya."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Casualty verified. Confirm no further threats.",
              "TL": "Kumpirmadong biktima. Tiyaking wala nang banta."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Finished. Look for reinforcements.",
              "TL": "Tapos na. Maghanap ng posibleng saklolo."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Threat neutralized. Scan surrounding cover.",
              "TL": "Banta naalis. Suriin ang mga kublihan sa paligid."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "One eliminated. Assess the remainder.",
              "TL": "Isa ang tinanggal. Suriin ang natitira."
            }
          }
        ]
      }
    }
  ]
}

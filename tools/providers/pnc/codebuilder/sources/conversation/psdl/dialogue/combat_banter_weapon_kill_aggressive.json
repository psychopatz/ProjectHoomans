        "category": "projecthoomans:combat_kill",
        "contentOwner": "projecthoomans.dialogue_content.events",
        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_banter/weapon_kill/aggressive.json",
        "responseTemplateID": "semantic.combat.kill.killer.aggressive.firearm_high_named_02",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Right where I wanted it. Down.",
              "TL": "Eksakto sa gusto ko. Bagsak."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Dropped it in one shot. Beautiful.",
              "TL": "Bumagsak sa isang putok. Ayos."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Right between the eyes. Got him.",
              "TL": "Sa pagitan mismo ng mga mata. Sapul."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "That's how you put one down.",
              "TL": "Ganyan magpabagsak ng isa."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Dead on arrival. Love it.",
              "TL": "Tigok agad. Ayos."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Drilled that one clean.",
              "TL": "Sapul na sapul ang isang 'yon."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Saw the opening and took it.",
              "TL": "Nakakita ng butas at tinamaan agad."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Dropped like a stone.",
              "TL": "Bumagsak na parang bato."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Target down. Who's next?",
              "TL": "Bagsak ang target. Sino susunod?"
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Put that lead right where it hurts.",
              "TL": "Ipinasok ang tingga sa dapat kalagyan."
            }
          }
        ]
      }
    },
    {

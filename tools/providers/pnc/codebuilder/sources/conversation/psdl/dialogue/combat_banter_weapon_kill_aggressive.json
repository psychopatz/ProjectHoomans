        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/combat_banter/weapon_kill/aggressive.json",
        "responseTemplateID": "semantic.combat.kill.killer.aggressive.blade_head_01",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Took its head clean off.",
              "TL": "Tanggal ang ulo."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Split the skull wide open.",
              "TL": "Biyak ang bungo."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Severed the spine. Done.",
              "TL": "Naputol ang gulugod. Tapos."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Nothing stands up without a head.",
              "TL": "Walang tatayo kapag walang ulo."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Carved right through rotten bone.",
              "TL": "Bumaon diretso sa bulok na buto."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Off with its neck. Stay down.",
              "TL": "Putol ang leeg. Diyan ka lang."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Sliced it down to the dirt.",
              "TL": "Hiniwa hanggang bumagsak sa lupa."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Blade went straight through.",
              "TL": "Dire-diretso ang talim."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Head's gone. That one's not getting up.",
              "TL": "Wala nang ulo. Hindi na tatayo 'yan."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Clean decapitation. Keep moving.",
              "TL": "Malinis na pugot. Tuloy lang."
            }
          }
        ]
      }
    },

            "id": "neutral.09",
            "text": {
              "EN": "Pounded that one into the floor.",
              "TL": "Ibinagsak sa sahig sa lakas ng palo."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Cracked wide open. Moving on.",
              "TL": "Basag nang todo. Tuloy."

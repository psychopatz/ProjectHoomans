    {
      "kind": "dialogue",
      "id": "semantic.combat.kill.killer.aggressive.firearm_high_named_01",
      "owner": "ProjectHoomans",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },

          {
            "id": "neutral.01",
            "text": {
              "EN": "That's why I like the reach.",
              "TL": "Kaya gusto ko ang abot nito."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Punched right through the eye socket.",
              "TL": "Tumagos sa butas ng mata."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Kept my distance and pinned it down.",
              "TL": "Dumistansya at itinarak pabagsak."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Spear through the brain. Done.",
              "TL": "Sibat sa utak. Tapos."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Stuck it before it could touch me.",
              "TL": "Itinarak bago pa ako mahawakan."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Straight thrust. Dropped immediately.",
              "TL": "Diretsong saksak. Bagsak agad."

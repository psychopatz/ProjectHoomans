      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Split that rotten head wide open.",
              "TL": "Biyak na biyak ang bulok na ulo."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Axe bit deep right into the skull.",
              "TL": "Bumaon nang malalim ang palakol sa bungo."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Cleft in two. Stay in the dirt.",
              "TL": "Biyak sa dalawa. Manatili ka sa lupa."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Buried the axe right between its ears.",
              "TL": "Ibaon ang palakol sa gitna ng tenga nito."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Heavy swing. Done for good.",
              "TL": "Mabigat na hataw. Tapos magpakailanman."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Crushed the crown with one chop.",
              "TL": "Durog ang tuktok sa isang taga."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "That skull never stood a chance.",
              "TL": "Walang laban ang bungong 'yon."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Broke right through bone.",
              "TL": "Bumasag diretso sa buto."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Split it down to the neck.",
              "TL": "Biyak hanggang leeg."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "One hard chop and it's over.",
              "TL": "Isang malakas na taga at tapos na."
            }
          }
        ]
      }
    },

        "sourceSurface": "tools/semantic_harness/codebuilder/sources/conversation/content/event/combat_kill/killer/practical.json",
        "responseTemplateID": "semantic.combat.reaction.kill_killer_practical_02",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "One down. Let's keep moving.",
              "TL": "Isa na. Tuloy tayo."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Handled one. Don't linger here.",
              "TL": "Inasikaso ang isa. Huwag magtagal dito."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Threat dead. Keep momentum going.",
              "TL": "Patay ang banta. Panatilihin ang bwelo."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "One eliminated. Push to the objective.",
              "TL": "Isa ang tinanggal. Sulong sa layunin."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Down. Step through before noise travels.",
              "TL": "Bagsak. Lumakad bago kumalat ang ingay."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Got one. Move to the next room.",
              "TL": "Nakuha ang isa. Lipat sa susunod na kwarto."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "One corpse. Don't stay in the open.",
              "TL": "Isang bangkay. Huwag manatili sa lantad na lugar."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Finished. Let's make distance.",
              "TL": "Tapos na. Lumayo na tayo rito."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Target down. Keep moving along the wall.",
              "TL": "Bagsak ang target. Sumabay sa pader sa paglakad."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Downed. Advance quietly.",
              "TL": "Bagsak. Pasulong nang tahimik."
            }
          }
        ]
      }
    },
    {
      "kind": "dialogue",

        "responseTemplateID": "semantic.combat.reaction.kill_killer_practical_03",
        "style": "neutral"
      },
      "response": {
        "act": "REACT",
        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "It's clear here. Watch for more.",
              "TL": "Malinis dito. Bantayan ang iba."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Downed. Expect company soon.",
              "TL": "Bagsak. Asahang may kasunod 'yan."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Dead. Noise might draw more.",
              "TL": "Patay na. Baka umakit ng iba ang tunog."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "One kill confirmed. Listen for footsteps.",
              "TL": "Isang patay kumpirmado. Makinig sa mga yabag."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Target cleared. Eyes on the shadows.",
              "TL": "Target naalis na. Tumingin sa mga anino."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Finished. Sound could bring stragglers.",
              "TL": "Tapos na. Baka may dumating na mga naiwan."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Down. Watch all doorways.",
              "TL": "Bagsak. Bantayan ang bawat pintuan."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Threat eliminated. Scan the next lane.",
              "TL": "Banta naalis. Suriin ang susunod na daan."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Clean kill. Be ready for the next one.",
              "TL": "Malinis na patay. Maging handa sa kasunod."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Downed it. Keep listening.",
              "TL": "Naibagsak ko na. Patuloy na makinig."
            }
          }
        ]
      }
    }

        "variants": [
          {
            "id": "neutral.01",
            "text": {
              "EN": "Stay alert.",
              "TL": "Manatiling alerto."
            }
          },
          {
            "id": "neutral.02",
            "text": {
              "EN": "Keep your eyes peeled.",
              "TL": "Buksan ang mga mata."
            }
          },
          {
            "id": "neutral.03",
            "text": {
              "EN": "Watch our surroundings.",
              "TL": "Bantayan ang paligid natin."
            }
          },
          {
            "id": "neutral.04",
            "text": {
              "EN": "Don't let your guard down.",
              "TL": "Huwag ibaba ang depensa."
            }
          },
          {
            "id": "neutral.05",
            "text": {
              "EN": "Stay sharp out here.",
              "TL": "Maging handa rito sa labas."
            }
          },
          {
            "id": "neutral.06",
            "text": {
              "EN": "Keep quiet and listen.",
              "TL": "Tumahimik at makinig."
            }
          },
          {
            "id": "neutral.07",
            "text": {
              "EN": "Keep checking the corners.",
              "TL": "Tignan palagi ang mga sulok."
            }
          },
          {
            "id": "neutral.08",
            "text": {
              "EN": "Stay cautious.",
              "TL": "Mag-ingat palagi."
            }
          },
          {
            "id": "neutral.09",
            "text": {
              "EN": "Eyes front and back.",
              "TL": "Tumingin sa harap at likod."
            }
          },
          {
            "id": "neutral.10",
            "text": {
              "EN": "Stay focused.",
              "TL": "Manatiling nakapokus."
            }
          }
        ]

# Companion moodle observations, behavioral follow-through acknowledgments,
# and actor-agnostic follower-to-leader need requests with Yes/No branching.
lang EN
namespace hoomans

flow semantic.companion.moodle_suggest
  # --- Exhausted -> suggest sitting down ---
  say [role=suggest_sit, actor.social_style=warm|friendly|protective] (pri 8) as suggest_sit_warm:
    "Hey {addressee.name}, you're breathing hard. Let's sit down for a minute and catch our breath."
  say [role=suggest_sit, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_sit_guarded:
    "You're dragging, {addressee.name}. Sit down before you get us both killed."
  say [role=suggest_sit] (pri 7) as suggest_sit_default:
    "You look exhausted, {addressee.name}. Maybe we should sit down for a bit."

  # --- Tired -> suggest sleeping ---
  say [role=suggest_sleep, actor.social_style=warm|friendly|protective] (pri 8) as suggest_sleep_warm:
    "You're barely keeping your eyes open, {addressee.name}. We should find a safe spot to sleep."
  say [role=suggest_sleep, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_sleep_guarded:
    "You're nodding off, {addressee.name}. Find a bed before you walk into a bite."
  say [role=suggest_sleep] (pri 7) as suggest_sleep_default:
    "You look dead tired, {addressee.name}. We should find somewhere to get some sleep."

  # --- Hungry -> suggest eating ---
  say [role=suggest_eat, actor.social_style=warm|friendly|protective] (pri 8) as suggest_eat_warm:
    "Your stomach's growling, {addressee.name}. Grab a bite when you get a second."
  say [role=suggest_eat, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_eat_guarded:
    "Eat something, {addressee.name}. Starving won't help us survive."
  say [role=suggest_eat] (pri 7) as suggest_eat_default:
    "You look hungry, {addressee.name}. Might want to eat something soon."

  # --- Thirsty -> suggest drinking ---
  say [role=suggest_drink, actor.social_style=warm|friendly|protective] (pri 8) as suggest_drink_warm:
    "Hey {addressee.name}, take a sip of water before you dry out."
  say [role=suggest_drink, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_drink_guarded:
    "Drink some water, {addressee.name}. Dehydration slows you down."
  say [role=suggest_drink] (pri 7) as suggest_drink_default:
    "You seem thirsty, {addressee.name}. Better grab a drink soon."

  # --- Overencumbered -> suggest dropping load ---
  say [role=suggest_drop_load, actor.social_style=warm|friendly|protective] (pri 8) as suggest_drop_load_warm:
    "That pack looks heavy, {addressee.name}. Let's lighten your load when we can."
  say [role=suggest_drop_load, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_drop_load_guarded:
    "You're hauling too much junk, {addressee.name}. Drop some weight before we have to run."
  say [role=suggest_drop_load] (pri 7) as suggest_drop_load_default:
    "Looks like you're carrying a lot, {addressee.name}. Might want to shed some weight."

  # --- Pain / Sick -> suggest resting ---
  say [role=suggest_rest, actor.social_style=warm|friendly|protective] (pri 8) as suggest_rest_warm:
    "You don't look so hot, {addressee.name}. Take it easy for a bit, okay?"
  say [role=suggest_rest, actor.social_style=hostile|guarded|withdrawn] (pri 8) as suggest_rest_guarded:
    "You look rough, {addressee.name}. Slow down before you keel over."
  say [role=suggest_rest] (pri 7) as suggest_rest_default:
    "You're looking a little rough, {addressee.name}. Maybe we should take it slow for a bit."

  # --- Follow-through acknowledgments when the leader actually does it ---
  say [role=ack_sit, actor.social_style=warm|friendly|protective] (pri 8) as ack_sit_warm:
    "Good call, {addressee.name}. Take a breather — I'll sit with you and watch the perimeter."
  say [role=ack_sit, actor.social_style=hostile|guarded|withdrawn] (pri 8) as ack_sit_guarded:
    "Finally. Good — catch your breath so we can move."
  say [role=ack_sit] (pri 7) as ack_sit_default:
    "Good idea, {addressee.name}. A quick sit-down does wonders."

  say [role=ack_eat, actor.social_style=warm|friendly|protective] (pri 8) as ack_eat_warm:
    "Good — glad you grabbed something to eat, {addressee.name}."
  say [role=ack_eat, actor.social_style=hostile|guarded|withdrawn] (pri 8) as ack_eat_guarded:
    "Good. Better full than fainting mid-run."
  say [role=ack_eat] (pri 7) as ack_eat_default:
    "Nice, that'll keep you going, {addressee.name}."

  say [role=ack_drink, actor.social_style=warm|friendly|protective] (pri 8) as ack_drink_warm:
    "Good, stay hydrated out here, {addressee.name}."
  say [role=ack_drink, actor.social_style=hostile|guarded|withdrawn] (pri 8) as ack_drink_guarded:
    "Smart. Keep the water down."
  say [role=ack_drink] (pri 7) as ack_drink_default:
    "Good call on the water, {addressee.name}."

  say [role=ack_sleep] (pri 7) as ack_sleep_default:
    "Get some sleep, {addressee.name}. You've earned it."

  say [role=ack_drop_load] (pri 7) as ack_drop_load_default:
    "Much better, {addressee.name}. We'll move faster like that."

  say [role=ack_rest] (pri 7) as ack_rest_default:
    "Good call taking it easy, {addressee.name}. I've got your back."

  say [default] (pri 5) as default:
    "Take care of yourself out here, {addressee.name}."


flow semantic.companion.need_request
  # --- Follower requests break from leader (player OR NPC leader) ---
  say [role=request_sit, actor.social_style=warm|friendly|protective] (pri 8) as req_sit_warm:
    "Hey {addressee.name}, I'm pretty beat. Mind if I sit down for a minute?"
  say [role=request_sit, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_sit_guarded:
    "{addressee.name}, my legs are shot. I need to sit for a minute — yes or no?"
  say [role=request_sit] (pri 7) as req_sit_default:
    "{addressee.name}, I'm getting exhausted. Can we sit down for a bit?"

  say [role=request_sleep, actor.social_style=warm|friendly|protective] (pri 8) as req_sleep_warm:
    "{addressee.name}, I can barely stay awake. Could we find somewhere to rest soon?"
  say [role=request_sleep, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_sleep_guarded:
    "I'm about to drop, {addressee.name}. I need sleep — can we stop?"
  say [role=request_sleep] (pri 7) as req_sleep_default:
    "Hey {addressee.name}, I'm really sleepy. Can we take a rest break?"

  say [role=request_eat, actor.social_style=warm|friendly|protective] (pri 8) as req_eat_warm:
    "{addressee.name}, I'm starving. Mind if I stop for a second to grab a bite?"
  say [role=request_eat, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_eat_guarded:
    "I need food, {addressee.name}. Can I eat before I pass out?"
  say [role=request_eat] (pri 7) as req_eat_default:
    "Hey {addressee.name}, I'm getting pretty hungry. Mind if I eat something?"

  say [role=request_drink, actor.social_style=warm|friendly|protective] (pri 8) as req_drink_warm:
    "{addressee.name}, my throat's dry as dust. Mind if I grab a quick drink?"
  say [role=request_drink, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_drink_guarded:
    "I need water, {addressee.name}. Give me a second to drink."
  say [role=request_drink] (pri 7) as req_drink_default:
    "Hey {addressee.name}, I'm really thirsty. Can I stop for a drink?"

  # --- Autonomous NPC Leader replies (Yes / No) ---
  say [role=leader_approve, actor.social_style=warm|friendly|protective] (pri 8) as leader_approve_warm:
    "Of course, {addressee.name}. Take a minute — we'll hold here."
  say [role=leader_approve, actor.social_style=hostile|guarded|withdrawn] (pri 8) as leader_approve_guarded:
    "Fine, {addressee.name}. Make it quick."
  say [role=leader_approve] (pri 7) as leader_approve_default:
    "Sure, {addressee.name}. Take a quick break."

  say [role=leader_deny, actor.social_style=warm|friendly|protective] (pri 8) as leader_deny_warm:
    "Not right here, {addressee.name}. Hang in there a little longer until we're somewhere safer."
  say [role=leader_deny, actor.social_style=hostile|guarded|withdrawn] (pri 8) as leader_deny_guarded:
    "No. Keep moving, {addressee.name} — we don't have time for breaks."
  say [role=leader_deny] (pri 7) as leader_deny_default:
    "Not right now, {addressee.name}. Let's push a bit further first."

  # --- Requester reacts to Yes / No ---
  say [role=requester_approved, actor.social_style=warm|friendly|protective] (pri 8) as req_approved_warm:
    "Thanks, {addressee.name}. I really needed that."
  say [role=requester_approved, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_approved_guarded:
    "Good. Won't take long."
  say [role=requester_approved] (pri 7) as req_approved_default:
    "Thanks, {addressee.name}. Just need a moment."

  say [role=requester_denied, actor.social_style=warm|friendly|protective] (pri 8) as req_denied_warm:
    "Alright, {addressee.name}... I'll try to keep up."
  say [role=requester_denied, actor.social_style=hostile|guarded|withdrawn] (pri 8) as req_denied_guarded:
    "Unbelievable... fine, {addressee.name}. Don't blame me if I slow us down."
  say [role=requester_denied] (pri 7) as req_denied_default:
    "Okay, {addressee.name}. I'll hang on a bit longer."

  say [default] (pri 5) as default:
    "Could use a quick break when we get a chance, {addressee.name}."

# Medical distress calls, teammate triage, assisted care, and combat injury triage flows.
lang EN
namespace hoomans

blueprint offer.medical_distress_nudges
  offer medical.what_happened:
    label: "What happened?"
    say: "What happened?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
  offer medical.who_hurt_you:
    label: "Who hurt you?"
    say: "Who hurt you?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
  offer medical.what_need:
    label: "What do you need?"
    say: "What do you need?"
    utility: openness
    intent: QUESTION
    subject: CONTEXT_REFERENCE

flow semantic.medical.distress.call
  use offer.medical_distress_nudges
  say [downed.need=mercy] (pri 10) as mercy:
    "Please... I'm not going to make it. Don't let me turn."
  say [downed.need=bleedout] (pri 9) as bleedout:
    "I'm bleeding out over here! Help me, please!"
  say [downed.need=bandage] (pri 8) as bandage:
    "I'm hurt and down! Need a bandage over here!"
  say [downed.need=rescue] (pri 8) as rescue:
    "I can't get up—somebody pull me out of here!"
  say [downed.need=dehydration] (pri 8) as dehydration:
    "Need water... I can barely move..."
  say [downed.need=starvation] (pri 8) as starvation:
    "Starving... I don't have the strength to stand..."
  say [downed.need=exhaustion] (pri 8) as exhaustion:
    "I'm completely spent... give me a hand up..."
  say [default] (pri 5) as default:
    "I'm down! Somebody help me!"

flow semantic.medical.distress.update
  use offer.medical_distress_nudges
  say [downed.need=mercy] (pri 10) as mercy:
    "It's getting worse... please don't leave me like this."
  say [downed.need=bleedout] (pri 9) as bleedout:
    "Still losing blood—hurry!"
  say [downed.need=bandage] (pri 8) as bandage:
    "I'm still down and waiting for a patch."
  say [downed.need=rescue] (pri 8) as rescue:
    "Still pinned down here—need a hand!"
  say [downed.need=dehydration] (pri 8) as dehydration:
    "Still need water before I pass out..."
  say [downed.need=starvation] (pri 8) as starvation:
    "Still weak—need food soon..."
  say [downed.need=exhaustion] (pri 8) as exhaustion:
    "Still trying to catch my breath down here..."
  say [default] (pri 5) as default:
    "Still down here—don't forget about me!"

flow semantic.medical.distress.repeat
  use offer.medical_distress_nudges
  say [downed.need=mercy] (pri 10) as mercy:
    "Please... end it before it's too late."
  say [downed.need=bleedout] (pri 9) as bleedout:
    "I'm running out of time—stop the bleeding!"
  say [downed.need=bandage] (pri 8) as bandage:
    "I still need these wounds patched! Hurry!"
  say [downed.need=rescue] (pri 8) as rescue:
    "Over here! I still can't get clear!"
  say [downed.need=dehydration] (pri 8) as dehydration:
    "Water... please, anything to drink..."
  say [downed.need=starvation] (pri 8) as starvation:
    "Please, I need something to eat..."
  say [downed.need=exhaustion] (pri 8) as exhaustion:
    "I still can't stand on my own..."
  say [default] (pri 5) as default:
    "Hey! Still need help over here!"

flow semantic.medical.distress.teammate
  use offer.medical_distress_nudges
  say [medical.bandage_status=missing] (pri 9) as missing:
    "They're hurt and I'm out of bandages—anyone have medical supplies?!"
  say [medical.bandage_status=found] (pri 9) as found:
    "Found bandages—cover me while I patch them up!"
  say [default] (pri 5) as default:
    "They're hurt! Stay with them while I cover you."

flow semantic.medical.distress.treatment
  say [downed.need=bandage] (pri 8) as bandage:
    "Bandage is on—thanks, that stopped the worst of it."
  say [default] (pri 5) as default:
    "The wound is treated. I can move when you are ready."

flow semantic.medical.care.assisted
  say [role=start_patch_npc] (pri 10) as start_patch_npc:
    "Hold still, {addressee.name}, let me wrap your {slot.wound.part}."
  say [role=start_patch_player] (pri 10) as start_patch_player:
    "Hold still—let me get a clean wrap on your {slot.wound.part}."
  say [role=start_change_dirty] (pri 10) as start_change_dirty:
    "That bandage on your {slot.wound.part} is soaked—let me swap it out."
  say [role=complete_patch] (pri 10) as complete_patch:
    "There—your {slot.wound.part} is wrapped tight."
  say [role=complete_change_dirty] (pri 10) as complete_change_dirty:
    "Fresh dressing is on your {slot.wound.part}. Keep it clean."
  say [role=patient_thanks] (pri 10) as patient_thanks:
    "Thanks for patching up my {slot.wound.part}, {addressee.name}—owe you one."
  say [default] (pri 5) as default:
    "Hold still, let me patch up that {slot.wound.part}."

flow semantic.flow.combat.injury.triage.open
  say [medical.is_bitten] (pri 11) as bitten:
    "Teeth caught me in the scramble! Help me clear a lane so we can check the bite!"
  say [medical.open_wounds] (pri 10) as open_wounds:
    "Still bleeding through my clothes—cover my front while I tie this wound off!"
  say [default] (pri 6) as default:
    "Still holding my ground, caught a hit and keeping eyes forward."

flow semantic.flow.combat.injury.triage.assess
  say [state.value=covered_for_treatment] (pri 11) as covered:
    "Thanks! Keep them off my back while I tie off this open bleed."
  say [state.value=reassured_bond] (pri 10) as reassured:
    "Heard you loud and clear. Still breathing, still swinging beside you."
  say [medical.open_wounds] (pri 9) as open_wounds:
    "The hit tore deep and it's still bleeding—give me two seconds of cover to wrap it!"
  say [default] (pri 6) as default:
    "Dressings are tight. Stay on my side and we'll sweep the rest of them."

flow semantic.flow.combat.injury.triage.bite_check
  say [!medical.saliva_transmissible] (pri 11) as non_transmissible:
    "Thank god saliva doesn't carry it here. Still stings awful, wrapping it tight now."
  say [default] (pri 6) as default:
    "Teeth broke the skin. Let's clear the stragglers first and I'll keep my distance."

flow semantic.flow.combat.injury.triage.squad_interject
  say [state.value=bite_psychopath_threatened] (pri 11) as threatened:
    "Keep that barrel down! We finish clearing the dead before anyone talks about executions."
  say [default] (pri 6) as default:
    "Eyes on the perimeter! Hold the line together while we sort this wound out."

flow semantic.flow.combat.injury.triage.tactical_order
  say [state.value=ordered_fallback] (pri 11) as fallback:
    "Alright, backing up two steps behind you. Cover me while I catch my breath!"
  say [state.value=covered_for_treatment] (pri 10) as covered:
    "Wrapping it right behind you—keep those {noun.zombie|s} off my shoulder!"
  say [default] (pri 6) as default:
    "Dressings are holding. Stay on my flank and we push through."

flow semantic.flow.combat.injury.triage.bite_standoff
  say [state.value=bite_non_lethal_stabilized] (pri 11) as non_lethal:
    "Saliva doesn't turn people here—just let me wrap the tear and keep fighting!"
  say [state.value=bite_psychopath_threatened] (pri 10) as threatened:
    "Keep that barrel down! We finish clearing the dead before anyone talks about executions."
  say [default] (pri 6) as default:
    "I know the rules. Help me clear the stragglers and I'll stay apart from the group."

flow semantic.flow.combat.injury.triage.resolved
  say [state.value=ordered_fallback] (pri 11) as fallback:
    "Pulling back to rear guard now—watch the front!"
  say [state.value=covered_for_treatment] (pri 10) as covered:
    "Tying off the dressing under your cover right now!"
  say [state.value=bite_non_lethal_stabilized] (pri 10) as non_lethal:
    "Bite's wrapped tight and saliva isn't lethal here. Back in formation!"
  say [state.value=bite_quarantined] (pri 10) as quarantined:
    "Understood. I'll keep my distance from the squad and watch for fever."
  say [state.value=bite_psychopath_threatened] (pri 10) as threatened:
    "Nobody's firing on our own while I'm standing here. Eyes back on the dead!"
  say [state.value=reassured_bond] (pri 9) as reassured:
    "Heard you loud and clear. Still breathing, still swinging beside you."
  say [intent=REFUSE] (pri 9) as refused:
    "Save the talk for when there aren't teeth snapping in our faces!"
  say [default] (pri 6) as default:
    "Dressings are tight. Stay on my side and we'll sweep the rest of them."

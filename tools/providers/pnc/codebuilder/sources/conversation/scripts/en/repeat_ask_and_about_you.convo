# "Tell me about yourself" hub, relationship-gated refusals, and repeat-ask
# annoyance lines compiled through ConvoDSL.
lang EN
namespace hoomans

flow semantic.question.about_you
  say [actor.social_style=friendly|protective] (pri 9) as warm:
    "Sure thing — what do you want to know about me?"
  say [actor.social_style=withdrawn|guarded|hostile] (pri 9) as guarded:
    "Depends on what you're asking. What about me?"
  say [default] (pri 5) as neutral:
    "What do you want to know about me?"

flow semantic.question.about_you.gated
  say [topic=faction, actor.social_style=withdrawn|guarded|hostile] (pri 10) as faction_guarded:
    "I don't hand out who I run with to someone I barely know."
  say [topic=faction] (pri 9) as faction_neutral:
    "We haven't known each other long enough for me to get into who I'm with."
  say [topic=surname, actor.social_style=withdrawn|guarded|hostile] (pri 10) as surname_guarded:
    "First name's enough for now. We're not that close."
  say [topic=surname] (pri 9) as surname_neutral:
    "Let's stick to first names until we know each other a bit better."
  say [actor.social_style=withdrawn|guarded|hostile] (pri 8) as personal_guarded:
    "That's personal. We're not there yet."
  say [default] (pri 5) as personal_neutral:
    "I'm not ready to get into that yet — maybe once we know each other better."

flow semantic.question.repeat_known
  say [npc.fed_up] (pri 12) as fed_up:
    "Stop asking me the same thing over and over—it's {slot.known_value}. Move on."
  say [npc.annoyed, topic=identity] (pri 11) as annoyed_identity:
    "Seriously? It's {slot.known_value}. You already asked me that."
  say [npc.annoyed, topic=faction] (pri 11) as annoyed_faction:
    "You've asked me twice now — {slot.known_value}. Are you even listening?"
  say [npc.annoyed, topic=surname] (pri 11) as annoyed_surname:
    "Again? It's {slot.known_value}. Try to keep up."
  say [npc.annoyed] (pri 10) as annoyed_default:
    "You already asked me that — {slot.known_value}."
  say [topic=identity] (pri 8) as repeat_identity:
    "I already told you — it's {slot.known_value}. Everything alright?"
  say [topic=faction] (pri 8) as repeat_faction:
    "I told you before, I'm with {slot.known_value}."
  say [topic=surname] (pri 8) as repeat_surname:
    "Already told you — my surname is {slot.known_value}."
  say [topic=nickname] (pri 8) as repeat_nickname:
    "I already said most people call me {slot.known_value}."
  say [default] (pri 5) as repeat_default:
    "I told you already — {slot.known_value}."

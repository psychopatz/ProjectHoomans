# First-party tool outcome replies (social, order, quest, and task tools).
lang EN
namespace hoomans

flow semantic.tool_reply.ask_name.named
  say [default] (pri 6) as 1:
    "Understood."
  say [default] (pri 6) as 2:
    "Understood."
  say [default] (pri 6) as 3:
    "Understood."

flow semantic.tool_reply.ask_name.prompt
  say [default] (pri 6) as prompt:
    "I'll tell you my name once we've established some trust. What's your name?"

flow semantic.tool_reply.ask_name.rejected

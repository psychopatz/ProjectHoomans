# Player vanilla-emote visible speech lines and greeting flow pools.
lang EN
namespace hoomans

flow semantic.emote.player
  say [action=insult] (pri 8) as insult:
    "Back off, {addressee.name}!"
  say [action=thumbsdown] (pri 8) as thumbsdown:
    "No. That's not good enough, {addressee.name}."
  say [action=wavehi] (pri 8) as wavehi:
    "Hey, {addressee.name}!"
  say [action=wavebye] (pri 8) as wavebye:
    "Take care, {addressee.name}."
  say [action=thankyou] (pri 8) as thankyou:
    "Thanks, {addressee.name}."
  say [action=thumbsup] (pri 8) as thumbsup:
    "Good work, {addressee.name}."
  say [action=clap] (pri 8) as clap:
    "Well done, {addressee.name}!"
  say [action=salute] (pri 8) as salute:
    "Respect, {addressee.name}."

flow semantic.flow.greeting.opening
  offer greeting.check_in.report_wellbeing:
    label: "Say you're doing fine"
    say: "I'm fine, thank you."
    utility: openness
    intent: INFORM
    subject: WELLBEING
  say [env.raining] (pri 9) as rain:
    "Hey there. Wet one today. >> How are you holding up?"
  say [actor.social_style=friendly|protective] (pri 8) as friendly:
    "Hey there! Good to see you. >> How are you doing?"
  say [default] (pri 5) as default:
    "Hey there. >> How are you holding up?"

flow semantic.flow.greeting.followup
  say [actor.social_style=friendly|protective] (pri 8) as friendly:
    "You're welcome. It's good to see you too."
  say [default] (pri 5) as default:
    "Good to hear. Take care out there."

# Mod compatibility adapters (Bandits, Necroa, Project A-Life, Companion Dogs).
lang EN
namespace hoomans

flow semantic.compat.bandits.hooman_hurt
  say [social.role=colonist] (pri 9) as colonist:
    "Bandit fire! Pull back and cover the wounded colonist."
  say [social.role=lover] (pri 9) as lover:
    "Bandit fire. Stay close; I have got you."
  say [social.role=family] (pri 9) as family:
    "Bandit fire! Stay together and cover the wounded family member."
  say [default] (pri 5) as default:
    "Bandit fire! Stay with the wounded survivor and watch the flank."

flow semantic.compat.necroa.mask_warning
  say [social.role=family] (pri 9) as family:
    "Put your mask on, family. I am not losing you to the air."
  say [social.role=colonist] (pri 9) as colonist:
    "Mask up. We keep the camp safe together."
  say [default] (pri 5) as default:
    "Put your mask back on. Knox is airborne."

flow semantic.compat.necroa.player_mask_removed
  say [social.role=hostile] (pri 9) as hostile:
    "Put your mask back on before you become a problem."
  say [social.role=lover] (pri 9) as lover:
    "Please put your mask back on, love. This air is not safe."
  say [default] (pri 5) as default:
    "Put your mask back on. The air is not safe."

flow semantic.compat.projectalife.meta
  say [alife.kind=gunfire] (pri 9) as gunfire:
    "Someone is shooting nearby. Keep your head down."
  say [alife.kind=heli] (pri 9) as aircraft:
    "Something is flying over us. Keep listening."
  say [alife.kind=military] (pri 9) as military:
    "That aircraft sounds close. Stay sharp."
  say [alife.kind=crash] (pri 9) as crash:
    "That crash sounded close. Keep your eyes open."
  say [alife.kind=ambience] (pri 9) as ambience:
    "I do not like that sound. Stay close."

flow semantic.compat.projectalife.encounter
  say [alife.stance=friendly] (pri 9) as friendly:
    "Those survivors seem friendly. Keep your hands visible."
  say [alife.stance=hostile|careful] (pri 9) as hostile:
    "That group looks hostile. Keep cover between us and them."
  say [alife.stance=unknown|neutral] (pri 6) as unknown:
    "Someone is out there. Let us watch before we approach."

flow semantic.compat.projectalife.faction
  say [event.type=projectalife_faction_stance, alife.stance=hostile|careful] (pri 9) as hostile:
    "That faction may be hostile toward us now. Stay alert."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=incoming] (pri 9) as incoming:
    "They just opened fire on us. Stay close."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=outgoing] (pri 9) as outgoing:
    "We hit them. They may retaliate soon."

flow semantic.compat.companion_dogs.greeting
  say [dog.sex=male] (pri 8) as male:
    "Who is a good boy?"
  say [dog.sex=female] (pri 8) as female:
    "Who is a good girl?"
  say [dog.sex=unknown] (pri 8) as unknown:
    "Who is a good dog?"

flow semantic.compat.companion_dogs.feed
  say [dog.sex=male] (pri 8) as male:
    "Here you go, good boy."
  say [dog.sex=female] (pri 8) as female:
    "Here you go, good girl."
  say [dog.sex=unknown] (pri 8) as unknown:
    "Here you go, good dog."

# Redundant command reactions, annoyance escalation, and mood-colored replies.
lang EN
namespace hoomans

blueprint offer.redundant_follow_nudges
  offer follow.switch_stay:
    when: [state.already_following]
    label: "Actually, stay here"
    say: "Actually, hold up and stay here instead."
    utility: directness
    intent: REQUEST
    subject: STAY
  offer follow.sorry_nag:
    when: [npc.annoyed]
    label: "Sorry, my bad"
    say: "Sorry—didn't mean to keep repeating myself."
    utility: openness
    intent: APOLOGY
    subject: SOCIAL

flow command.follow.redundant
  use offer.redundant_follow_nudges
  say [npc.fed_up, player.rude] (pri 13) as fed_up_rude:
    "Stop barking at me to follow you—I haven't left your side!"
  say [npc.fed_up] (pri 12) as fed_up:
    "I heard you the first three times! Look behind you, I'm literally right here!"
  say [npc.annoyed, mood.tired] (pri 11) as annoyed_tired:
    "I'm already dragging myself behind you. Give me a break, I'm beat."
  say [npc.annoyed] (pri 10) as annoyed:
    "Still following you. You don't need to keep repeating it."
  say [mood.panicked] (pri 10) as panicked:
    "I'm already right behind you—just keep moving!"
  say [mood.in_pain] (pri 10) as in_pain:
    "I'm already following you as fast as I can... give me a second, I'm hurting."
  say [mood.stressed] (pri 9) as stressed:
    "Already with you, alright? Let's just get somewhere safe."
  say [mood.tired] (pri 8) as tired:
    "Still right behind you... just don't sprint, I'm exhausted."
  say [mood.cheerful] (pri 8) as cheerful:
    "Haha, still right behind you! Didn't lose me yet."
  say [npc.annoyance=mild] (pri 7) as mild:
    "I'm already following you—just lead on."
  say [default] (pri 6) as calm:
    "I'm already right behind you{end} {?mood.tail}"

flow command.stay.redundant
  say [npc.fed_up] (pri 12) as fed_up:
    "I'm not going anywhere! You already told me to stay!"
  say [npc.annoyed] (pri 10) as annoyed:
    "Still holding position. I heard you the first time."
  say [mood.tired] (pri 8) as tired:
    "Trust me, I wasn't planning on moving anyway."
  say [mood.cheerful] (pri 8) as cheerful:
    "Already planted right here! Take your time."
  say [default] (pri 6) as calm:
    "Already holding position right here{end} {?mood.tail}"

flow social.annoyance.nag
  use offer.social_repair
  say [npc.fed_up, player.rude] (pri 12) as fed_up_rude:
    "Enough! Keep barking at me like that and you can handle things yourself!"
  say [npc.fed_up] (pri 11) as fed_up:
    "Look, give me a minute—you've been on my case nonstop."
  say [npc.annoyed] (pri 9) as annoyed:
    "You just asked me that. Something else on your mind?"
  say [default] (pri 6) as mild:
    "Like I said a moment ago—nothing's changed."

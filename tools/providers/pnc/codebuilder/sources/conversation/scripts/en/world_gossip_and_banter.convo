# World gossip, auto-discovered story rumors, radio/AEBS news, 7-day raid
# patterns, mundane/reminiscent/belief banter, and NPC-to-NPC social exchanges.
lang EN
namespace hoomans

lex clause.gossip_closure
  [default] (pri 6): "That's all I know about it, honestly." | "Honestly, that's everything I saw—couldn't tell you much more." | "That's about all I caught."

lex clause.banter_closure
  [default] (pri 6): "Anyway, no use dwelling on it—gotta keep moving." | "That's about it. Just thinking out loud." | "Anyway, back to reality."

flow semantic.gossip.world.opening
  offer world_gossip.stance_positive:
    label: "Agree / take it seriously"
    say: "I agree, that makes sense."
    utility: warmth
    intent: AGREE
    subject: CONVERSATION_TOPIC
  offer world_gossip.stance_neutral:
    label: "Not sure / ask more"
    say: "Hard to say. Tell me more about that."
    utility: curiosity
    intent: CLARIFY
    subject: CONVERSATION_TOPIC
  offer world_gossip.stance_negative:
    label: "Skeptical / call bullshit"
    say: "I don't buy it, sounds like bullshit."
    utility: conflict
    intent: DISAGREE
    subject: CONVERSATION_TOPIC
  offer world_gossip.ask_where:
    label: "Where was that?"
    say: "Where was that?"
    utility: curiosity
    intent: QUESTION
    subject: LOCATION
  offer world_gossip.ask_when:
    label: "When did that happen?"
    say: "When did that happen?"
    utility: curiosity
    intent: QUESTION
    subject: TIME
  say [topic=threat_pattern_7d, world.raider_surge] (pri 11) as threat_chopper_linked:
    "Ever since that chopper passed over, the raids and the dead haven't stopped pushing in."
  say [topic=threat_pattern_7d] (pri 10) as threat_constant:
    "We've been hit {slot.gossip_raid_count} times in the past week—someone or something is definitely testing our perimeter."
  say [topic=helicopter_event] (pri 10) as chopper:
    "That chopper came over {slot.gossip_time} and drew half the dead in the county right through here."
  say [topic=aebs_air_activity] (pri 10) as aebs_air:
    "Caught the emergency broadcast earlier: \"{slot.gossip_headline}\""
  say [topic=aebs_utilities] (pri 9) as aebs_utilities:
    "The emergency broadcast warned about the grid: \"{slot.gossip_headline}\""
  say [topic=aebs_power_warning] (pri 10) as aebs_power:
    "Caught {slot.broadcast.episode} on {slot.broadcast.channel} {slot.gossip_time}. They warned the power grid is failing."
  say [topic=aebs_weather_warning] (pri 9) as aebs_weather:
    "Heard {slot.broadcast.episode} on {slot.broadcast.channel} {slot.gossip_time}. Rough weather is rolling in."
  say [topic=pastor_radio, actor.social_style=warm|friendly|protective] (pri 11) as pastor_radio_pos:
    "Caught {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. Honestly, hearing someone still praying gave me a little comfort."
  say [topic=pastor_radio, actor.social_style=hostile|guarded|withdrawn] (pri 11) as pastor_radio_neg:
    "Caught {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. Complete bullshit—preaching into a mic isn't stopping the dead."
  say [topic=pastor_radio] (pri 9) as pastor_radio_neu:
    "Caught {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. Not sure what to believe anymore, honestly."

  say [topic=news_outbreak, actor.social_style=warm|friendly|protective] (pri 11) as news_outbreak_pos:
    "Caught {slot.broadcast.channel} {slot.gossip_time} talking about {slot.broadcast.topic}. Still hoping somebody out there gets this under control."
  say [topic=news_outbreak, actor.social_style=hostile|guarded|withdrawn] (pri 11) as news_outbreak_neg:
    "Caught {slot.broadcast.channel} {slot.gossip_time} spinning {slot.broadcast.topic}. Half of it is official bullshit—they're already losing."
  say [topic=news_outbreak] (pri 10) as news_outbreak_neu:
    "Caught {slot.broadcast.channel} {slot.gossip_time} talking about {slot.broadcast.topic}. Hard to tell what's still true out there."

  say [topic=open_band_refugee, actor.social_style=warm|friendly|protective] (pri 11) as ob_refugee_pos:
    "Picked up a refugee mayday on {slot.broadcast.channel} {slot.gossip_time}. Families with wounded—we should try to help them if we can."
  say [topic=open_band_refugee, actor.social_style=hostile|guarded|withdrawn] (pri 11) as ob_refugee_neg:
    "Picked up some sob story on {slot.broadcast.channel} {slot.gossip_time}. Could easily be bait—not risking our necks for strangers."
  say [topic=open_band_refugee] (pri 9) as ob_refugee_neu:
    "Picked up a refugee mayday on {slot.broadcast.channel} {slot.gossip_time}. Not sure if we can spare the meds, or if it's even safe."

  say [topic=open_band_trader, actor.social_style=warm|friendly|protective] (pri 11) as ob_trader_pos:
    "A trader caravan was calling on {slot.broadcast.channel} {slot.gossip_time}! Good chance to barter for tools and meds."
  say [topic=open_band_trader, actor.social_style=hostile|guarded|withdrawn] (pri 11) as ob_trader_neg:
    "Some caravan was bragging on {slot.broadcast.channel} {slot.gossip_time}. Half those 'traders' are just scouts sizing people up."
  say [topic=open_band_trader] (pri 9) as ob_trader_neu:
    "A trader caravan was calling on {slot.broadcast.channel} {slot.gossip_time}. Might be worth checking out if we stay cautious."

  say [topic=open_band_settlement, actor.social_style=warm|friendly|protective] (pri 11) as ob_settlement_pos:
    "Heard an organized settlement on {slot.broadcast.channel} {slot.gossip_time}. Feels good knowing people are actually rebuilding."
  say [topic=open_band_settlement, actor.social_style=hostile|guarded|withdrawn] (pri 11) as ob_settlement_neg:
    "Heard some enclave flexing on {slot.broadcast.channel} {slot.gossip_time}. Organized groups usually mean rules and guns pointed at outsiders."
  say [topic=open_band_settlement] (pri 9) as ob_settlement_neu:
    "Heard an organized settlement broadcasting on {slot.broadcast.channel} {slot.gossip_time}. Hard to say if they're friendly until we see them."

  say [topic=numbers_station, actor.social_style=warm|friendly|protective] (pri 10) as numbers_station_pos:
    "Caught {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. Maybe it means someone in command is still alive and coordinating."
  say [topic=numbers_station, actor.social_style=hostile|guarded|withdrawn] (pri 10) as numbers_station_neg:
    "Caught {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. Just creepy military garbage playing on an empty loop."
  say [topic=numbers_station] (pri 9) as numbers_station_neu:
    "Stumbled across {slot.broadcast.topic} on {slot.broadcast.channel} {slot.gossip_time}. No idea what those numbers even mean."

  say [topic=open_band_looter_trap, actor.social_style=warm|friendly|protective] (pri 11) as ob_looter_pos:
    "Heard a sketchy call on {slot.broadcast.channel} {slot.gossip_time} promising free supplies. Hate that people are setting traps like that—hope nobody falls for it."
  say [topic=open_band_looter_trap, actor.social_style=hostile|guarded|withdrawn] (pri 11) as ob_looter_neg:
    "Some idiots on {slot.broadcast.channel} {slot.gossip_time} tried pulling a 'free supplies, come alone' ambush. Total bullshit—we should steer clear or hit them first."
  say [topic=open_band_looter_trap] (pri 10) as ob_looter_neu:
    "Heard a suspicious broadcast on {slot.broadcast.channel} {slot.gossip_time} offering free supplies. Smells like a trap, honestly."

  say [topic=cannibal_radio, actor.social_style=warm|friendly|protective] (pri 11) as cannibal_pos:
    "Heard something awful on {slot.broadcast.channel} {slot.gossip_time}—people talking about hunting survivors. We have to look out for each other."
  say [topic=cannibal_radio, actor.social_style=hostile|guarded|withdrawn] (pri 11) as cannibal_neg:
    "Sick bastards on {slot.broadcast.channel} {slot.gossip_time} talking about eating people. Run into them and I'm shooting first."
  say [topic=cannibal_radio] (pri 10) as cannibal_neu:
    "Heard something disturbing on {slot.broadcast.channel} {slot.gossip_time}—not even sure if they were serious, but I'm not sticking around to find out."

  say [topic=military_comms, actor.social_style=warm|friendly|protective] (pri 11) as military_pos:
    "Picked up military traffic on {slot.broadcast.channel} {slot.gossip_time}. At least some units are still out there trying to hold the line."
  say [topic=military_comms, actor.social_style=hostile|guarded|withdrawn] (pri 11) as military_neg:
    "Picked up military traffic on {slot.broadcast.channel} {slot.gossip_time}. Sounds like they're falling apart—nobody's coming to save us."
  say [topic=military_comms] (pri 10) as military_neu:
    "Picked up military traffic on {slot.broadcast.channel} {slot.gossip_time}. Hard to tell whether they're regrouping or pulling out."

  say [topic=survivor_radio, actor.social_style=warm|friendly|protective] (pri 11) as survivor_pos:
    "Heard another survivor calling out on {slot.broadcast.channel} {slot.gossip_time}. Good to know we're not alone out here."
  say [topic=survivor_radio, actor.social_style=hostile|guarded|withdrawn] (pri 11) as survivor_neg:
    "Heard someone yelling on {slot.broadcast.channel} {slot.gossip_time}. Half the voices on open frequencies are trouble waiting to happen."
  say [topic=survivor_radio] (pri 9) as survivor_neu:
    "Heard another survivor on {slot.broadcast.channel} {slot.gossip_time}, though the static cut them off before I could tell much."

  say [topic=open_band_conflict, actor.social_style=warm|friendly|protective] (pri 10) as ob_conflict_pos:
    "Overheard two groups arguing on {slot.broadcast.channel} {slot.gossip_time}. Shame people are still fighting each other when the dead are everywhere."
  say [topic=open_band_conflict, actor.social_style=hostile|guarded|withdrawn] (pri 10) as ob_conflict_neg:
    "Overheard two loudmouths bickering on {slot.broadcast.channel} {slot.gossip_time}. Idiots are gonna get themselves killed over petty drama."
  say [topic=open_band_conflict] (pri 8) as ob_conflict_neu:
    "Overheard two groups arguing on {slot.broadcast.channel} {slot.gossip_time} over supplies. Better to stay out of their way."

  say [topic=skill_show, actor.social_style=warm|friendly|protective] (pri 10) as skill_show_pos:
    "Watched {slot.show.name} on {slot.broadcast.channel} {slot.gossip_time}! Actually picked up some really useful tricks."
  say [topic=skill_show, actor.social_style=hostile|guarded|withdrawn] (pri 10) as skill_show_neg:
    "Caught {slot.show.name} {slot.gossip_time}. Half of TV advice is too clean for the real world, though a couple tips might help."
  say [topic=skill_show] (pri 8) as skill_show_neu:
    "Watched {slot.show.name} on {slot.broadcast.channel} {slot.gossip_time}. Might come in handy next time we need to build or fix something."

  say [topic=home_vhs, actor.social_style=warm|friendly|protective] (pri 10) as home_vhs_pos:
    "Watched {slot.show.name} {slot.gossip_time}. Kind of comforting remembering how ordinary life used to feel."
  say [topic=home_vhs, actor.social_style=hostile|guarded|withdrawn] (pri 10) as home_vhs_neg:
    "Watched {slot.show.name} {slot.gossip_time}. Honestly just depressing staring at ghosts of the old world."
  say [topic=home_vhs] (pri 8) as home_vhs_neu:
    "Watched {slot.show.name} {slot.gossip_time}. Strange peeking into somebody else's home tape."

  say [topic=music_radio, actor.social_style=warm|friendly|protective] (pri 9) as music_pos:
    "Caught {slot.show.name} playing {slot.gossip_time}. Really lifted my mood hearing real music again."
  say [topic=music_radio, actor.social_style=hostile|guarded|withdrawn] (pri 9) as music_neg:
    "Caught {slot.show.name} {slot.gossip_time}. Just hope the noise doesn't draw walkers to the door."
  say [topic=music_radio] (pri 7) as music_neu:
    "Caught {slot.show.name} playing {slot.gossip_time}. Nice change of pace from all the static."

  say [topic=entertainment_tv, actor.social_style=warm|friendly|protective] (pri 9) as ent_pos:
    "Caught {slot.show.name} {slot.gossip_time}. Nice to laugh and forget about the dead for five minutes."
  say [topic=entertainment_tv, actor.social_style=hostile|guarded|withdrawn] (pri 9) as ent_neg:
    "Caught {slot.show.name} {slot.gossip_time}. Feels like a waste of power watching reruns while the world burns."
  say [topic=entertainment_tv] (pri 7) as ent_neu:
    "Caught {slot.show.name} {slot.gossip_time}. Surreal watching regular TV like nothing happened."

  say [topic=news_general] (pri 8) as news_general:
    "Caught a broadcast on {slot.broadcast.channel} {slot.gossip_time} about {slot.broadcast.topic}."
  say [topic=radio_broadcast] (pri 8) as radio_news:
    "Caught something on the radio {slot.gossip_time}: \"{slot.gossip_headline}\""
  say [topic=medical_wreck] (pri 8) as medical_wreck:
    "I saw a crashed ambulance {slot.gossip_time}, {slot.gossip_location}—might still have medical supplies."
  say [topic=police_blockade] (pri 8) as police_blockade:
    "Ran into a police blockade {slot.gossip_time}, {slot.gossip_location}. Looked like things went sideways."
  say [topic=bandit_activity] (pri 8) as bandit_activity:
    "People spotted bandits on the road {slot.gossip_time}, {slot.gossip_location}. Best to stay sharp."
  say [topic=horde_sighting] (pri 8) as horde_sighting:
    "Saw a big horde {slot.gossip_time}, {slot.gossip_location}. Wouldn't wander over there alone."
  say [topic=meta_gunshot] (pri 8) as meta_gunshot:
    "Heard gunfire {slot.gossip_time}, {slot.gossip_location}. Somebody's still fighting out there."
  say [topic=meta_scream] (pri 8) as meta_scream:
    "Heard someone screaming {slot.gossip_time}, {slot.gossip_location}. Doesn't sound like they made it."
  say [default] (pri 5) as default:
    "I spotted something strange {slot.gossip_time}, {slot.gossip_location}."

flow semantic.gossip.world.followup
  offer world_gossip.stance_positive:
    label: "Agree / support"
    say: "I agree with you on that."
    utility: warmth
    intent: AGREE
    subject: CONVERSATION_TOPIC
  offer world_gossip.stance_neutral:
    label: "Not sure / weigh it"
    say: "Hard to say. What should we do?"
    utility: practical
    intent: CLARIFY
    subject: CONVERSATION_TOPIC
  offer world_gossip.stance_negative:
    label: "Disagree / push back"
    say: "I don't buy it, that's bullshit."
    utility: conflict
    intent: DISAGREE
    subject: CONVERSATION_TOPIC
  # --- 3-Stance Branching Follow-Ups (reused by Player Q&A and NPC-to-NPC Gossip) ---
  say [topic=pastor_radio, action=stance_positive] (pri 12) as pastor_pos_fu:
    "Glad you see it that way too. Holding onto a little faith keeps you human out here."
  say [topic=pastor_radio, action=stance_neutral] (pri 12) as pastor_neu_fu:
    "Yeah, hard to say either way. Guess everybody copes however they can when the world ends."
  say [topic=pastor_radio, action=stance_negative] (pri 12) as pastor_neg_fu:
    "Fair enough—prayers don't reload magazines or barricade windows. I get why you're calling bullshit."

  say [topic=news_outbreak, action=stance_positive] (pri 12) as news_pos_fu:
    "Right? At least knowing what's happening with {slot.broadcast.topic} lets us plan ahead instead of walking blind."
  say [topic=news_outbreak, action=stance_neutral] (pri 12) as news_neu_fu:
    "Hard to say how much of {slot.broadcast.channel} is still accurate, though. Things change by the hour."
  say [topic=news_outbreak, action=stance_negative] (pri 12) as news_neg_fu:
    "Yeah, half the news is spin anyway. What we see on the street tells us way more than {slot.broadcast.channel}."

  say [topic=open_band_refugee, action=stance_positive] (pri 12) as ref_pos_fu:
    "Good—if we still help people who need it, we haven't lost who we are."
  say [topic=open_band_refugee, action=stance_neutral] (pri 12) as ref_neu_fu:
    "Yeah, it's a tough call. We'd have to scout carefully before risking our own supplies."
  say [topic=open_band_refugee, action=stance_negative] (pri 12) as ref_neg_fu:
    "I hear you. Too many ambushes start with a sob story on the radio—our crew comes first."

  say [topic=open_band_trader, action=stance_positive] (pri 12) as trader_pos_fu:
    "Agreed. A fair barter saves us days of looting dangerous buildings."
  say [topic=open_band_trader, action=stance_neutral] (pri 12) as trader_neu_fu:
    "Could go either way. We check their numbers from a distance first before showing our packs."
  say [topic=open_band_trader, action=stance_negative] (pri 12) as trader_neg_fu:
    "Yeah, I don't blame you for not trusting them. Easy way to get robbed if you let your guard down."

  say [action=stance_positive] (pri 10) as generic_stance_pos:
    "Glad we're on the same page about {slot.broadcast.topic}. Makes it easier to move as a team."
  say [action=stance_neutral] (pri 10) as generic_stance_neu:
    "Yeah, hard to be sure either way about {slot.broadcast.topic}. We'll just have to see how it plays out."
  say [action=stance_negative] (pri 10) as generic_stance_neg:
    "Fair enough—maybe it really is bullshit. Better skeptical than dead out here."
  say [action=where] (pri 9) as detail_where:
    "It was {slot.gossip_location}. {clause.gossip_closure}"
  say [action=when] (pri 9) as detail_when:
    "Happened {slot.gossip_time}, right before things quieted down. {clause.gossip_closure}"
  say [action=who] (pri 9) as detail_who:
    "Couldn't make out any faces—I kept my distance. {clause.gossip_closure}"
  # --- Procedural Broadcast Expansions: Stage 2 (action=more) ---
  say [topic=aebs_air_activity, action=more] (pri 10) as more_aebs_air:
    "They flagged air activity over the zone. Whenever a chopper flies through, it drags huge herds straight across town."
  say [topic=aebs_power_warning, action=more] (pri 10) as more_aebs_power:
    "They reported grid instability and blackouts spreading. Once the power drops, freezers spoil and nights get pitch black."
  say [topic=aebs_weather_warning, action=more] (pri 10) as more_aebs_wx:
    "They warned visibility and temperatures are going to tank. Bad weather hides walkers until they're right on top of you."
  say [topic=news_outbreak, action=more] (pri 10) as more_news_outbreak:
    "On {slot.broadcast.channel}, they kept talking about {slot.broadcast.topic}. Even the anchors sounded like they were losing hope."
  say [topic=military_comms, action=more] (pri 10) as more_military:
    "Sounded like units were falling back and losing contact with command. Whatever containment line they had is breaking."
  say [topic=survivor_radio, action=more] (pri 10) as more_survivor:
    "They were asking if anyone copied on {slot.broadcast.channel}, sounded stressed and short on time before the static cut them off."
  say [topic=open_band_looter_trap, action=more] (pri 10) as more_looter_trap:
    "They promised free food and told listeners to come alone and signal twice. Classic ambush bait."
  say [topic=open_band_trader, action=more] (pri 10) as more_trader:
    "They mentioned carrying tools, batteries, and canned food, and asked for medicine or fuel in return."
  say [topic=open_band_refugee, action=more] (pri 10) as more_refugee:
    "They said they had wounded people with fevers and their radio battery was nearly dead."
  say [topic=open_band_settlement, action=more] (pri 10) as more_settlement:
    "They have guards on watch and a working generator, and warned outsiders to keep weapons lowered and identify themselves."
  say [topic=open_band_conflict, action=more] (pri 10) as more_conflict:
    "Sounded like one faction accused the other of taking supplies and trespassing in a house they marked."
  say [topic=numbers_station, action=more] (pri 10) as more_numbers:
    "It was just cold, steady callsigns and digits on a loop. No context, no sign-off, just static between sets."
  say [topic=cannibal_radio, action=more] (pri 10) as more_cannibal:
    "They weren't talking about scavenging cans—they were talking about waiting on travelers like prey."
  say [topic=pastor_radio, action=more] (pri 10) as more_pastor:
    "He was telling whoever was listening to repent and hold onto faith through the collapse."
  say [topic=skill_show, action=more] (pri 10) as more_skill:
    "They walked through {slot.show.name} step by step. Way clearer than guessing from scratch."
  # --- Procedural Broadcast Expansions: Stage 3 (action=plan -> takeaway before closure) ---
  say [topic=aebs_air_activity, action=plan] (pri 10) as plan_aebs_air:
    "We should stick close to indoor cover today and avoid open streets until the chopper clears. {clause.gossip_closure}"
  say [topic=aebs_power_warning, action=plan] (pri 10) as plan_aebs_power:
    "Best move is cooking perishables now and tracking down a generator, fuel, and a manual. {clause.gossip_closure}"
  say [topic=open_band_looter_trap, action=plan] (pri 10) as plan_looter_trap:
    "Steer clear of them—or if we ever cross paths, go in heavy and never walk in alone. {clause.gossip_closure}"
  say [topic=open_band_trader, action=plan] (pri 10) as plan_trader:
    "Let's gather any spare trade goods and keep an eye out for their caravan on our next run. {clause.gossip_closure}"
  say [topic=open_band_refugee, action=plan] (pri 10) as plan_refugee:
    "If we have extra bandages or meds to spare, we could look for them—just stay alert on approach. {clause.gossip_closure}"
  say [topic=open_band_settlement, action=plan] (pri 10) as plan_settlement:
    "If we visit their enclave, weapons down and announce ourselves early so we start off on good terms. {clause.gossip_closure}"
  say [topic=cannibal_radio, action=plan] (pri 10) as plan_cannibal:
    "Trust nobody on that frequency and keep our guard up whenever we meet strangers on the road. {clause.gossip_closure}"
  say [action=plan] (pri 8) as plan_generic:
    "Best we can do is stay sharp, use what we learned from {slot.broadcast.channel}, and watch each other's backs. {clause.gossip_closure}"
  say [topic=medical_wreck, action=more] (pri 9) as more_medical:
    "Looked like somebody already checked the cab, though the back doors were still jammed shut. {clause.gossip_closure}"
  say [topic=police_blockade, action=more] (pri 9) as more_police:
    "Saw shell casings and overturned barricades—didn't stick around long enough to check the trunks. {clause.gossip_closure}"
  say [topic=bandit_activity, action=more] (pri 9) as more_bandit:
    "They were armed and moving fast. I kept my head down until they cleared out. {clause.gossip_closure}"
  say [default] (pri 5) as default:
    "Didn't stay long enough to search everything—too many stragglers wandering around. {clause.gossip_closure}"

flow semantic.gossip.world.closure
  say [default] (pri 5) as default:
    "{clause.gossip_closure}"

# Universal Compositional Stance Exchange (Layer 1): scales to any topic registered
# with an axis (compassion, caution, pragmatism, social) with zero boilerplate.
flow semantic.stance.exchange
  say [action=aligned_compassion, actor.social_style=warm|friendly|protective] (pri 11) as sc_al_comp_warm:
    "Glad you feel the same way about {slot.broadcast.topic}, {addressee.name}. Means we haven't lost our humanity."
  say [action=aligned_compassion, actor.social_style=hostile|guarded|withdrawn] (pri 11) as sc_al_comp_cold:
    "Finally somebody talking sense about {slot.broadcast.topic}, {addressee.name}. Soft hearts get people killed."
  say [action=aligned_compassion] (pri 10) as sc_al_comp_neu:
    "Makes sense, {addressee.name}. Good to know we see {slot.broadcast.topic} the same way."

  say [action=clashed_compassion, actor.social_style=warm|friendly|protective] (pri 11) as sc_cl_comp_warm:
    "That's pretty cold, {addressee.name}. I still think {slot.broadcast.topic} matters."
  say [action=clashed_compassion, actor.social_style=hostile|guarded|withdrawn] (pri 11) as sc_cl_comp_cold:
    "Spare me the naive talk about {slot.broadcast.topic}, {addressee.name}. The world doesn't work like that anymore."
  say [action=clashed_compassion] (pri 10) as sc_cl_comp_neu:
    "We clearly don't see eye to eye on {slot.broadcast.topic}, {addressee.name}."

  say [action=aligned_caution, actor.social_style=warm|friendly|protective] (pri 11) as sc_al_caut_warm:
    "Smart call on {slot.broadcast.topic}, {addressee.name}. Staying careful keeps everyone alive."
  say [action=aligned_caution, actor.social_style=hostile|guarded|withdrawn] (pri 11) as sc_al_caut_cold:
    "Yeah, you've got the right idea about {slot.broadcast.topic}, {addressee.name}. No point playing scared."
  say [action=aligned_caution] (pri 10) as sc_al_caut_neu:
    "Agreed on {slot.broadcast.topic}, {addressee.name}. Good to be on the same page."

  say [action=clashed_caution, actor.social_style=warm|friendly|protective] (pri 11) as sc_cl_caut_warm:
    "You're being reckless about {slot.broadcast.topic}, {addressee.name}. We can't afford sloppy mistakes."
  say [action=clashed_caution, actor.social_style=hostile|guarded|withdrawn] (pri 11) as sc_cl_caut_cold:
    "Stop jumping at shadows over {slot.broadcast.topic}, {addressee.name}. Caution turns into paralysis real fast."
  say [action=clashed_caution] (pri 10) as sc_cl_caut_neu:
    "I think you're reading {slot.broadcast.topic} wrong, {addressee.name}."

  say [action=aligned_pragmatism] (pri 10) as sc_al_prag:
    "Practical thinking on {slot.broadcast.topic}, {addressee.name}. That's how we stay ahead."
  say [action=clashed_pragmatism] (pri 10) as sc_cl_prag:
    "That's not realistic about {slot.broadcast.topic}, {addressee.name}. We need plans that actually hold up."
  say [action=respected_clash] (pri 11) as sc_resp_clash:
    "I don't agree with you on {slot.broadcast.topic}, {addressee.name}, but I respect that you stand your ground."
  say [action=diplomatic] (pri 9) as sc_diplomatic:
    "Fair enough, {addressee.name}. Guess we'll see how {slot.broadcast.topic} plays out."
  say [action=measured_match] (pri 9) as sc_measured:
    "Yeah, hard to say for sure on {slot.broadcast.topic}, {addressee.name}. Best to keep an open mind."
  say [default] (pri 5) as default:
    "Noted, {addressee.name}. Let's keep moving."

flow semantic.banter.mundane
  offer banter.ask_more:
    label: "Tell me more"
    say: "Tell me more about that."
    utility: warmth
    intent: QUESTION
    subject: CONVERSATION_TOPIC
  say [topic=reminisce_sunset] (pri 9) as reminisce_sunset:
    "I miss just sitting on the porch watching the sunset without worrying about walkers."
  say [topic=reminisce_comforts] (pri 8) as reminisce_comforts:
    "Funny what you miss—I'd trade half my pack for a hot shower and a cold soda."
  say [topic=reminisce_music] (pri 8) as reminisce_music:
    "Every time I pass an old car, I half expect the radio to kick on with some late-night rock station."
  say [topic=personal_belief, actor.social_style=friendly] (pri 9) as belief_compassionate:
    "I still think people are worth saving, even after everything we've seen."
  say [topic=personal_belief] (pri 8) as belief_pragmatic:
    "Out here, you only make it if you watch your own back first and trust slow."
  say [topic=mundane_food] (pri 7) as mundane_food:
    "If I have to eat one more cold can of beans straight out of the tin, I might lose my mind."
  say [default] (pri 5) as mundane_default:
    "My feet are killing me—feels like we've walked half of Knox County this week."

flow semantic.banter.mundane.followup
  say [topic=reminisce_sunset] (pri 9) as followup_sunset:
    "Used to be my favorite part of the day—just quiet air, orange sky, and nowhere else to be. {clause.banter_closure}"
  say [topic=reminisce_comforts] (pri 8) as followup_comforts:
    "You don't realize how much the little stuff kept you sane until it's all gone. {clause.banter_closure}"
  say [topic=personal_belief, actor.social_style=friendly] (pri 9) as followup_belief_warm:
    "If we stop looking out for each other, then what's the point of surviving at all? {clause.banter_closure}"
  say [topic=personal_belief] (pri 8) as followup_belief_pragmatic:
    "Seen too many good folks get burned because they assumed a stranger meant well. {clause.banter_closure}"
  say [default] (pri 5) as default:
    "Dry socks and a warm meal are worth more than gold out here. {clause.banter_closure}"

beat semantic.social.npc_exchange.intro
  say [role=open] (pri 8) as open:
    "Hey, I don't think we've met. I'm {speaker.name}."
  say [role=reply] (pri 8) as reply:
    "I'm {speaker.name}. Stay safe out here."

beat semantic.social.npc_exchange.friend
  say [role=open] (pri 8) as open:

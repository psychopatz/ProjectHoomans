# Standardized, actor-agnostic conversation pause/switch, discourse resumption, and farewell pools.
# Reused identically by Player<->NPC UI (< > switcher, red Goodbye, Close X) and NPC<->NPC scenes.
lang EN
namespace hoomans

flow semantic.conversation.pause_switch.say
  say [rel.bond=lover|spouse] (pri 11) as lover:
    "Hold on a second, {?term.address}—I'll be right back with you."
  say [rel.bond=parent|child|sibling|family] (pri 10) as family:
    "Give me a second, {?term.address}, let me check in over here first."
  say [actor.role=trader] (pri 9) as trader:
    "Hold that thought—let me talk to the others for a moment."
  say [actor.role=looter|bandit] (pri 9) as bandit:
    "Stay put. I'll be back in a second."
  say [actor.age_band=elder] (pri 8) as elder:
    "Excuse me a moment—I'll be right back."
  say [default] (pri 5) as default:
    "Hold on a moment, {?term.address}—I'll talk to you in a bit."

flow semantic.conversation.pause_switch.ack
  say [npc.fed_up] (pri 12) as fed_up:
    "Yeah, fine—go ahead."
  say [mood.panicked] (pri 11) as panicked:
    "Just don't wander off!"
  say [rel.bond=lover|spouse] (pri 10) as lover:
    "Take your time, {?term.address}. I'll be right here."
  say [rel.bond=parent|child|sibling|family] (pri 10) as family:
    "Sure thing, {?term.address}. I'm not going anywhere."
  say [actor.role=trader] (pri 9) as trader:
    "No rush—my stock isn't going anywhere."
  say [actor.role=looter|bandit] (pri 9) as bandit:
    "Don't waste my time."
  say [actor.age_band=elder] (pri 8) as elder:
    "Go on ahead, {?term.address}. I'll wait right here."
  say [mood.cheerful] (pri 7) as cheerful:
    "Sure thing! Catch you in a second."
  say [default] (pri 5) as default:
    "Alright, take your time{end}"

flow semantic.conversation.resume
  say [npc.fed_up] (pri 12) as fed_up:
    "Back again? Alright, spit it out."
  say [rel.bond=lover|spouse] (pri 11) as lover:
    "Welcome back, {?term.address}. Where were we?"
  say [rel.bond=parent|child|sibling|family] (pri 10) as family:
    "Back already, {?term.address}? Go ahead."
  say [actor.role=trader] (pri 9) as trader:
    "Ready to pick back up where we left off?"
  say [actor.role=looter|bandit] (pri 9) as bandit:
    "You're back. Make it quick."
  say [actor.age_band=elder] (pri 8) as elder:
    "There you are, {?term.address}. What were we saying?"
  say [default] (pri 5) as default:
    "Alright, I'm listening again. Where were we?"

flow semantic.conversation.farewell.player
  say [rel.bond=lover|spouse] (pri 11) as lover:
    "Stay safe, {?term.address}. Talk soon."
  say [rel.bond=parent|child|sibling|family] (pri 10) as family:
    "Take care of yourself, {?term.address}. Catch you later."
  say [actor.role=trader] (pri 9) as trader:
    "That's all for now. Safe roads."
  say [actor.role=looter|bandit] (pri 9) as bandit:
    "We're done here."
  say [env.night_or_dusk] (pri 8) as night:
    "That's all. Stay safe in the dark."
  say [default] (pri 5) as default:
    "That's all for now. Stay safe."

flow semantic.conversation.farewell.reply
  say [npc.fed_up] (pri 12) as fed_up:
    "Finally. See you around."
  say [mood.panicked] (pri 11) as panicked:
    "Stay sharp—watch your back out there!"
  say [rel.bond=lover|spouse] (pri 11) as lover:
    "Be careful out there, {?term.address}. Come back in one piece."
  say [rel.bond=parent|child|sibling|family] (pri 10) as family:
    "You too, {?term.address}. Don't take unnecessary risks."
  say [actor.role=trader] (pri 9) as trader:
    "Safe travels, {?term.address}. Come find me next time you need supplies."
  say [actor.role=looter|bandit] (pri 9) as bandit:
    "Yeah, get moving."
  say [actor.age_band=elder] (pri 8) as elder:
    "Look after yourself, {?term.address}."
  say [env.night_or_dusk] (pri 8) as night:
    "Keep your light low and stay safe tonight."
  say [mood.cheerful] (pri 7) as cheerful:
    "Catch you later, {?term.address}! Stay safe!"
  say [default] (pri 5) as default:
    "Stay safe out there{end} {?clause.stay_sharp}"

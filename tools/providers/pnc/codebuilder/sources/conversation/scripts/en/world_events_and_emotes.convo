# Vanilla emote replies, world utility/alarm/media/weather reactions, chronology milestones, and scoped world-event beats.
lang EN
namespace hoomans

flow semantic.emote.reply
  say [action=thumbsup, convo.prev_topic=water] (pri 9) as thumbsup_active:
    "Good—glad we're staying ahead on water."
  say [action=thumbsup] (pri 7) as thumbsup:
    "Right back at you{end}"
  say [action=thumbsdown] (pri 7) as thumbsdown:
    "Alright, noted. Not a fan of that."
  say [action=insult] (pri 7) as insult:
    "Watch it. No need for that."
  say [action=wavehi] (pri 7) as wavehi:
    "Hey there{end}"
  say [action=wavebye] (pri 7) as wavebye:
    "Take care out there."
  say [action=thankyou] (pri 7) as thankyou:
    "Anytime."
  say [action=clap] (pri 7) as clap:
    "Appreciate that!"
  say [action=salute] (pri 7) as salute:
    "Right back at you, partner."
  say [default] (pri 5) as default:
    "Got it."

flow semantic.world.alarm.react
  say [role=house_alarm_open] (pri 8) as house_alarm_open:
    "Damn—house alarm! Every {noun.zombie} on this {noun.road} is going to hear that!"
  say [role=house_alarm_open] (pri 8) as house_alarm_open_2:
    "Shit, a burglar alarm! {addressee.name}, we need to move before the whole block swarms in!"
  say [role=house_alarm_open] (pri 8) as house_alarm_open_3:
    "There goes a house alarm—great, like we needed a dinner bell ringing!"
  say [role=house_alarm_open] (pri 8) as house_alarm_open_4:
    "Hear that siren? Somebody tripped a security system nearby—weapons ready!"
  say [role=house_alarm_open] (pri 8) as house_alarm_open_5:
    "Loud alarm going off! Don't linger around here, {addressee.name}!"
  say [role=house_alarm_reply] (pri 8) as house_alarm_reply:
    "Yeah, let's get clear before {noun.pack|a} shows up!"
  say [role=house_alarm_reply] (pri 8) as house_alarm_reply_2:
    "Copy that, {addressee.name}—eyes on the corners, they'll be pouring in any second."
  say [role=house_alarm_reply] (pri 8) as house_alarm_reply_3:
    "Way too loud. Keep tight and let's put some distance between us and that house."
  say [role=house_alarm_reply] (pri 8) as house_alarm_reply_4:
    "I hear it—stay sharp and don't let them box us in!"
  say [role=house_alarm_reply] (pri 8) as house_alarm_reply_5:
    "No point fighting a whole neighborhood over an alarm. Let's stay mobile."
  say [role=house_alarm_chime] (pri 8) as house_alarm_chime_1:
    "Got your back—watching the rear in case stragglers come through."
  say [role=house_alarm_chime] (pri 8) as house_alarm_chime_2:
    "Just my luck. Keep moving, I'm right behind you."
  say [role=house_alarm_chime] (pri 8) as house_alarm_chime_3:
    "Stay off the main street if we can—that noise carries for blocks."
  say [role=house_alarm_chime] (pri 8) as house_alarm_chime_4:
    "Ready if anything jumps out. Let's not hang around."
  say [role=house_alarm_ended_open] (pri 8) as house_alarm_ended_open_1:
    "Finally—that alarm cut out. My ears are still ringing."
  say [role=house_alarm_ended_open] (pri 8) as house_alarm_ended_open_2:
    "Alarm's dead, {addressee.name}, but the damage is done—stay alert for stragglers."
  say [role=house_alarm_ended_open] (pri 8) as house_alarm_ended_open_3:
    "Thank god that siren shut off. Watch the treeline—anything nearby is still headed this way."
  say [role=house_alarm_ended_open] (pri 8) as house_alarm_ended_open_4:
    "Quiet again... don't let your guard down yet, the dead take a minute to arrive."
  say [role=house_alarm_ended_reply] (pri 8) as house_alarm_ended_reply_1:
    "Yeah, silence after an alarm is never really safe. Keeping my eyes peeled."
  say [role=house_alarm_ended_reply] (pri 8) as house_alarm_ended_reply_2:
    "Agreed, {addressee.name}. Let's check our sightlines before we relax."
  say [role=house_alarm_ended_reply] (pri 8) as house_alarm_ended_reply_3:
    "At least I can hear myself think again. Still watching the perimeter."
  say [role=house_alarm_ended_reply] (pri 8) as house_alarm_ended_reply_4:
    "Stay ready—half the neighborhood probably started shambling over here."
  say [role=house_alarm_ended_chime] (pri 8) as house_alarm_ended_chime_1:
    "Looks clear on my side for now, let's keep it that way."
  say [role=house_alarm_ended_chime] (pri 8) as house_alarm_ended_chime_2:
    "If we're lucky they went straight for that house instead of us."
  say [role=house_alarm_ended_chime] (pri 8) as house_alarm_ended_chime_3:
    "Good—now let's breathe and keep moving smart."
  say [default] (pri 5) as default:
    "That alarm is going to draw trouble—stay sharp!"

flow semantic.world.chopper.react
  say [role=chopper_start_open] (pri 8) as chopper_start_open_1:
    "Chopper! Hear those blades, {addressee.name}? Get under a roof right now!"
  say [role=chopper_start_open] (pri 8) as chopper_start_open_2:
    "Damn—helicopter overhead! It's going to drag every dead one in the county right onto us!"
  say [role=chopper_start_open] (pri 8) as chopper_start_open_3:
    "Wait—rotor blades! Everybody get indoors and stay away from the windows!"
  say [role=chopper_start_open] (pri 8) as chopper_start_open_4:
    "Chopper inbound! Don't let it spot us in the open, {addressee.name}!"
  say [role=chopper_start_open] (pri 8) as chopper_start_open_5:
    "That's a helicopter—and it sure isn't here to rescue us. Find cover!"
  say [role=chopper_start_reply] (pri 8) as chopper_start_reply_1:
    "On it, {addressee.name}! Inside a building—now, before it hovers over us!"
  say [role=chopper_start_reply] (pri 8) as chopper_start_reply_2:
    "I hear it! Keep low and get behind solid walls!"
  say [role=chopper_start_reply] (pri 8) as chopper_start_reply_3:
    "Last thing we need is a horde following those rotors—move!"
  say [role=chopper_start_reply] (pri 8) as chopper_start_reply_4:
    "Yeah, no waving at it—get out of sight and hunker down!"
  say [role=chopper_start_chime] (pri 8) as chopper_start_chime_1:
    "Right behind you—close the doors once we're inside!"
  say [role=chopper_start_chime] (pri 8) as chopper_start_chime_2:
    "Keep quiet once we're under cover and wait it out."
  say [role=chopper_start_chime] (pri 8) as chopper_start_chime_3:
    "Watch the streets—dead ones are already shifting toward the noise!"
  say [role=chopper_ended_open] (pri 8) as chopper_ended_open_1:
    "Rotors are fading out... sounds like the chopper finally left."
  say [role=chopper_ended_open] (pri 8) as chopper_ended_open_2:
    "It's gone, {addressee.name}. Give it a second before we step outside—the streets will be messy."
  say [role=chopper_ended_open] (pri 8) as chopper_ended_open_3:
    "Chopper's finally moving off. Let's check the windows before we head back out."
  say [role=chopper_ended_open] (pri 8) as chopper_ended_open_4:
    "Thank god that noise is gone. Stay sharp—it probably stirred up half the town."
  say [role=chopper_ended_reply] (pri 8) as chopper_ended_reply_1:
    "Good call waiting a beat, {addressee.name}. Let's peek outside carefully."
  say [role=chopper_ended_reply] (pri 8) as chopper_ended_reply_2:
    "Glad we kept our heads down. Weapons ready when we step out."
  say [role=chopper_ended_reply] (pri 8) as chopper_ended_reply_3:
    "Yeah, that thing always leaves a mess of walkers behind. Stay tight."
  say [role=chopper_ended_reply] (pri 8) as chopper_ended_reply_4:
    "Looks like we rode it out. Let's see what's still shambling around."
  say [role=chopper_ended_chime] (pri 8) as chopper_ended_chime_1:
    "My heart's still pounding. Good thing we got under cover."
  say [role=chopper_ended_chime] (pri 8) as chopper_ended_chime_2:
    "Next time I hear blades, I'm not even looking up—straight indoors."
  say [role=chopper_ended_chime] (pri 8) as chopper_ended_chime_3:
    "Alright, back to business—watch the corners."
  say [default] (pri 5) as default:
    "Helicopter noise—keep low and stay under cover!"

flow semantic.world.utility.outage
  say [role=power_shutoff_open] (pri 8) as power_shutoff_open:
    "The grid's finally gone... no more power, {addressee.name}."
  say [role=power_shutoff_reply] (pri 8) as power_shutoff_reply:
    "Knew it was coming. We'll need generators and flashlights now."
  say [role=power_shutoff_chime] (pri 8) as power_shutoff_chime:
    "Everything in the fridges is going to spoil fast—let's grab what's still good."
  say [role=water_shutoff_open] (pri 8) as water_shutoff_open:
    "Taps just ran dry, {addressee.name}. Water pressure's gone."
  say [role=water_shutoff_reply] (pri 8) as water_shutoff_reply:
    "Time to start collecting rain and rationing every bottle."
  say [role=water_shutoff_chime] (pri 8) as water_shutoff_chime:
    "We should fill every pot and barrel we can find before we run low."
  say [default] (pri 5) as default:
    "Utilities are failing—things are about to get tougher."

flow semantic.world.object.notice
  say [role=tv_reminisce_open] (pri 8) as tv_reminisce_open:
    "Weird seeing a TV still sitting there like the world didn't end."
  say [role=tv_reminisce_reply] (pri 8) as tv_reminisce_reply:
    "Feels like a lifetime ago."
  say [role=tv_power_out_open] (pri 8) as tv_power_out_open:
    "Just dead glass now without power."
  say [role=tv_power_out_reply] (pri 8) as tv_power_out_reply:
    "Yeah, nothing left on the air anyway."
  say [default] (pri 5) as default:
    "Strange reminder of how things used to be."

flow semantic.world.media.broadcast
  # --- AEBS: Air Activity Detected (Chopper Warning) ---
  say [role=aebs_air_activity_open] (pri 12) as aebs_air_activity_open_1:
    "Hold up, {addressee.name}! Did you catch {slot.broadcast.episode} on {slot.broadcast.channel}? Air activity detected means a chopper is coming!"
  say [role=aebs_air_activity_open] (pri 12) as aebs_air_activity_open_2:
    "Listen to {slot.broadcast.channel}, {addressee.name}! Air activity warning. We need a solid roof nearby today."
  say [role=aebs_air_activity_reply] (pri 12) as aebs_air_activity_reply_1:
    "Yeah, I heard it, {addressee.name}. If that helicopter spots us in the open, it'll drag every walker in the county right on top of us."
  say [role=aebs_air_activity_chime] (pri 12) as aebs_air_activity_chime_1:
    "Let's keep our runs short and stay close to buildings until it passes."
  say [role=aebs_air_activity_wrap] (pri 12) as aebs_air_activity_wrap_1:
    "Good thing we had the emergency frequency tuned in. Stay sharp."

  # --- AEBS: Power Grid Warning ---
  say [role=aebs_power_warning_open] (pri 12) as aebs_power_warning_open_1:
    "Bad news on {slot.broadcast.channel}, {addressee.name}. {slot.broadcast.episode} says the power grid is starting to fail."
  say [role=aebs_power_warning_reply] (pri 12) as aebs_power_warning_reply_1:
    "Means the lights and fridges are on borrowed time, {addressee.name}. We should cook perishables and hunt for a generator."
  say [role=aebs_power_warning_chime] (pri 12) as aebs_power_warning_chime_1:
    "Don't forget fuel cans and a manual if we find one. Dark nights are gonna get a lot rougher."
  say [role=aebs_power_warning_wrap] (pri 12) as aebs_power_warning_wrap_1:
    "At least we got a heads-up before everything went dark."

  # --- AEBS: Weather Forecast ---
  say [role=aebs_weather_warning_open] (pri 11) as aebs_weather_warning_open_1:
    "Catch that on {slot.broadcast.channel}, {addressee.name}? {slot.broadcast.episode} says rough weather is heading our way."
  say [role=aebs_weather_warning_reply] (pri 11) as aebs_weather_warning_reply_1:
    "Appreciate the warning, {addressee.name}. Let's pack warm layers and plan a dry place to hole up."
  say [role=aebs_weather_warning_chime] (pri 11) as aebs_weather_warning_chime_1:
    "Fighting the dead in a storm is miserable. Better to be ready early."
  say [role=aebs_weather_warning_wrap] (pri 11) as aebs_weather_warning_wrap_1:
    "Keep that emergency channel handy, it's the only honest forecast left."

  # --- Military Frequency (Classified M1A1) ---
  say [role=military_comms_open] (pri 11) as military_comms_open_1:
    "Shh, {addressee.name}, listen to {slot.broadcast.channel}. That's military traffic, and it doesn't sound like they're holding."
  say [role=military_comms_reply] (pri 11) as military_comms_reply_1:
    "If the army's falling back on {slot.broadcast.channel}, {addressee.name}, nobody's coming to rescue us."
  say [role=military_comms_chime] (pri 11) as military_comms_chime_1:
    "At least now we know the truth instead of waiting for an evacuation that's never coming."
  say [role=military_comms_wrap] (pri 11) as military_comms_wrap_1:
    "We rely on ourselves from here on out."

  # --- Amateur / Survivor Radio ---
  say [role=survivor_radio_open] (pri 11) as survivor_radio_open_1:
    "Wait, {addressee.name}! Someone's talking on {slot.broadcast.channel}. There are still other people out there."
  say [role=survivor_radio_reply] (pri 11) as survivor_radio_reply_1:
    "Hard to tell how far away they are, {addressee.name}, or whether they're friendly."
  say [role=survivor_radio_chime] (pri 11) as survivor_radio_chime_1:
    "Still... feels a little less lonely hearing live voices on the air."
  say [role=survivor_radio_wrap] (pri 11) as survivor_radio_wrap_1:
    "Keep listening, we might learn which roads are still clear."

  # --- Outbreak News (Triple-N, WBLN, GBC, LBMW, NNR, KnoxTalk) ---
  say [role=news_outbreak_open] (pri 11) as news_outbreak_open_1:
    "Look at {slot.broadcast.channel}, {addressee.name}. Hearing {slot.broadcast.topic} makes it feel all too real."
  say [role=news_outbreak_open] (pri 11) as news_outbreak_open_2:
    "Did you hear what {slot.broadcast.channel} just reported about {slot.broadcast.topic}, {addressee.name}? Things are falling apart fast."
  say [role=news_outbreak_reply] (pri 11) as news_outbreak_reply_1:
    "Half of what they're saying on {slot.broadcast.channel} is already behind what we've seen on the streets, {addressee.name}."
  say [role=news_outbreak_chime] (pri 11) as news_outbreak_chime_1:
    "Still worth watching while the signal lasts. Any clue about what's happening outside Knox helps."
  say [role=news_outbreak_wrap] (pri 11) as news_outbreak_wrap_1:
    "Yeah. Let's stay focused on surviving right here."

  # --- General News ---
  say [role=news_general_open] (pri 10) as news_general_open_1:
    "Still getting a signal from {slot.broadcast.channel}, {addressee.name}. Let's see what they're saying."
  say [role=news_general_reply] (pri 10) as news_general_reply_1:
    "Good call, {addressee.name}. Never know when something actually useful slips through."
  say [role=news_general_chime] (pri 10) as news_general_chime_1:
    "Just keep the volume reasonable so we don't draw company."
  say [role=news_general_wrap] (pri 10) as news_general_wrap_1:
    "Fair point. Ears open."

  # --- Skill Shows & Life and Living / Skill VHS ---
  say [role=tv_watching_life_and_living_open] (pri 10) as tv_watching_life_and_living_open:
    "Catching {slot.show.name} on {slot.broadcast.channel}, {addressee.name}. Might actually pick up something useful."
  say [role=tv_watching_life_and_living_reply] (pri 10) as tv_watching_life_and_living_reply:
    "Smart move, {addressee.name}. {slot.show.name} always has practical tips we can use out here."
  say [role=tv_watching_life_and_living_chime] (pri 10) as tv_watching_life_and_living_chime:
    "Take notes while we still have power. Half of survival is knowing how to fix and build things."
  say [role=tv_watching_life_and_living_wrap] (pri 10) as tv_watching_life_and_living_wrap:
    "Beats learning the hard way, that's for sure."

  # --- Home VHS ---
  say [role=home_vhs_open] (pri 10) as home_vhs_open_1:
    "Whoa... {slot.show.name} is somebody's home tape, {addressee.name}. Feels strange peeking into their old life."
  say [role=home_vhs_reply] (pri 10) as home_vhs_reply_1:
    "Yeah, {addressee.name}. Makes you wonder if they made it out alright."
  say [role=home_vhs_chime] (pri 10) as home_vhs_chime_1:
    "Hard to believe how normal everything looked just weeks ago."
  say [role=home_vhs_wrap] (pri 10) as home_vhs_wrap_1:
    "Let's keep moving when we're done. Don't want to get lost in the past."

  # --- Music Radio / Music TV / CDs ---
  say [role=music_radio_open] (pri 10) as music_radio_open_1:
    "Hey, {slot.show.name} is playing, {addressee.name}. Forgot how good a little music feels."
  say [role=music_radio_reply] (pri 10) as music_radio_reply_1:
    "No kidding, {addressee.name}. Beats listening to groaning walkers all day."
  say [role=music_radio_chime] (pri 10) as music_radio_chime_1:
    "Just don't crank it so loud the whole neighborhood dances over here."
  say [role=music_radio_wrap] (pri 10) as music_radio_wrap_1:
    "Hah, deal. Low volume, high morale."

  # --- Entertainment TV / Movies / Sports / Cartoons ---
  say [role=tv_watching_show_open] (pri 9) as tv_watching_show_open:
    "Keeping an eye on {slot.show.name}, {addressee.name}. Feels surreal watching TV like nothing happened."
  say [role=tv_watching_show_reply] (pri 9) as tv_watching_show_reply:
    "Honestly, {addressee.name}, five minutes of {slot.show.name} is a nice break from reality."
  say [role=tv_watching_show_chime] (pri 9) as tv_watching_show_chime:
    "Enjoy it while the signal holds. Won't last forever."
  say [role=tv_watching_show_wrap] (pri 9) as tv_watching_show_wrap:
    "True enough. Let's catch our breath and stay ready."

  # --- Open World Band: Looter Trap Warning ---
  say [role=open_band_looter_trap_open] (pri 12) as ob_looter_open_1:
    "Don't buy a word of that broadcast, {addressee.name}. Free supplies and 'come alone' screams ambush."
  say [role=open_band_looter_trap_reply] (pri 12) as ob_looter_reply_1:
    "Yeah, {addressee.name}, nobody hands out free food to strangers out here unless they're setting a trap."
  say [role=open_band_looter_trap_chime] (pri 12) as ob_looter_chime_1:
    "If we ever go near them, we go armed and we don't walk in blind."
  say [role=open_band_looter_trap_wrap] (pri 12) as ob_looter_wrap_1:
    "Agreed. Keep our distance unless we're ready for a fight."

  # --- Open World Band: Trader Caravan ---
  say [role=open_band_trader_open] (pri 12) as ob_trader_open_1:
    "Did you hear that on {slot.broadcast.channel}, {addressee.name}? Sounds like a trader caravan is passing through."
  say [role=open_band_trader_reply] (pri 12) as ob_trader_reply_1:
    "Could be worth checking out, {addressee.name}. Extra tools, batteries, or medicine are hard to come by."
  say [role=open_band_trader_chime] (pri 12) as ob_trader_chime_1:
    "Let's check what we can spare to barter before we head their way."
  say [role=open_band_trader_wrap] (pri 12) as ob_trader_wrap_1:
    "Good call. Keep weapons slung, stay polite, and watch their hands."

  # --- Open World Band: Refugee Mayday ---
  say [role=open_band_refugee_open] (pri 12) as ob_refugee_open_1:
    "Rough call on {slot.broadcast.channel}, {addressee.name}. Sounds like a group of wounded refugees asking for help."
  say [role=open_band_refugee_reply] (pri 12) as ob_refugee_reply_1:
    "Hate hearing families stuck out there like that, {addressee.name}. If we can spare medicine, maybe we should look for them."
  say [role=open_band_refugee_chime] (pri 12) as ob_refugee_chime_1:
    "Just be careful if we go. Desperate people can still get spooked easily."
  say [role=open_band_refugee_wrap] (pri 12) as ob_refugee_wrap_1:
    "Fair point. If we help them, we approach slow and announce ourselves."

  # --- Open World Band: Settlement Enclave ---
  say [role=open_band_settlement_open] (pri 12) as ob_settle_open_1:
    "Whoa, listen to {slot.broadcast.channel}, {addressee.name}. Sounds like a real settlement with a working perimeter."
  say [role=open_band_settlement_reply] (pri 12) as ob_settle_reply_1:
    "They sounded serious about identifying ourselves on approach, {addressee.name}. At least they're organized."
  say [role=open_band_settlement_chime] (pri 12) as ob_settle_chime_1:
    "Knowing there's an enclave holding out nearby gives us options if we need allies."
  say [role=open_band_settlement_wrap] (pri 12) as ob_settle_wrap_1:
    "Let's remember where they're broadcasting from. Could come in handy."

  # --- Open World Band: On-Air Argument / Faction Conflict ---
  say [role=open_band_conflict_open] (pri 11) as ob_conflict_open_1:
    "Hah, listen to them going at each other on {slot.broadcast.channel}, {addressee.name}. Even the apocalypse doesn't stop people from bickering."
  say [role=open_band_conflict_reply] (pri 11) as ob_conflict_reply_1:
    "Sounds like rival groups fighting over supplies, {addressee.name}. Better them than us."
  say [role=open_band_conflict_chime] (pri 11) as ob_conflict_chime_1:
    "At least they're broadcasting their drama so we know who to steer clear of."
  say [role=open_band_conflict_wrap] (pri 11) as ob_conflict_wrap_1:
    "Yeah. Let's stay out of their crossfire."

  # --- Vanilla Hidden Arc: Classified M1A1 Numbers Station ---
  say [role=numbers_station_open] (pri 12) as num_stat_open_1:
    "What the hell is that on {slot.broadcast.channel}, {addressee.name}? Just numbers and callsigns repeating..."
  say [role=numbers_station_reply] (pri 12) as num_stat_reply_1:
    "Gives me the creeps, {addressee.name}. Either it's an automated military loop or somebody's still sending coded orders."
  say [role=numbers_station_chime] (pri 12) as num_stat_chime_1:
    "Whatever it is, it's not meant for regular folks like us."
  say [role=numbers_station_wrap] (pri 12) as num_stat_wrap_1:
    "Yeah, let's tune past it before it gets in my head."

  # --- Vanilla Hidden Arc: Civilian Radio Cannibals ---
  say [role=cannibal_radio_open] (pri 12) as cann_rad_open_1:
    "Turn that down, {addressee.name}... did you hear how they were talking about people on {slot.broadcast.channel}?"
  say [role=cannibal_radio_reply] (pri 12) as cann_rad_reply_1:
    "That made my stomach turn, {addressee.name}. Some folks lost their humanity way faster than the dead did."
  say [role=cannibal_radio_chime] (pri 12) as cann_rad_chime_1:
    "We ever run into people like that, we don't hesitate. Keep our guard up."
  say [role=cannibal_radio_wrap] (pri 12) as cann_rad_wrap_1:
    "Stay close to each other. The dead aren't the only monsters out here."

  # --- Vanilla Hidden Arc: NNR Radio Doomsday Pastor ---
  say [role=pastor_radio_open] (pri 11) as past_rad_open_1:
    "Listen to that preacher on {slot.broadcast.channel}, {addressee.name}. Guy's still broadcasting sermons into the void."
  say [role=pastor_radio_reply] (pri 11) as past_rad_reply_1:
    "Can't blame people for looking for meaning when the whole world collapses, {addressee.name}."
  say [role=pastor_radio_chime] (pri 11) as past_rad_chime_1:
    "Faith is fine, just as long as we keep our blades sharp too."
  say [role=pastor_radio_wrap] (pri 11) as past_rad_wrap_1:
    "Amen to that. Let's stay practical."

  say [default] (pri 5) as default:
    "Still catching a signal on that broadcast."

flow semantic.progression.level_up
  # --- Level-Up via TV / VHS Broadcast ---
  say [role=tv_broadcast_open] (pri 12) as tv_lvl_open_1:
    "Hey {addressee.name}, watching {slot.show.name} actually clicked! I feel like I finally get {slot.skill.name} now."
  say [role=tv_broadcast_open] (pri 12) as tv_lvl_open_2:
    "Didn't expect {slot.show.name} to teach me this much, {addressee.name}. My {slot.skill.name} just jumped up a notch."
  say [role=tv_broadcast_reply] (pri 12) as tv_lvl_reply_1:
    "Nice work, {addressee.name}! Good thing we caught that episode while the signal lasted."
  say [role=tv_broadcast_chime] (pri 12) as tv_lvl_chime_1:
    "Keep watching whenever we get the chance. Every bit of {slot.skill.name} helps the whole crew."

  # --- Level-Up via Combat ---
  say [role=combat_open] (pri 12) as combat_lvl_open_1:
    "Getting a much better feel for {slot.skill.name}, {addressee.name}. Those fights are sharpening my instincts."
  say [role=combat_open] (pri 12) as combat_lvl_open_2:
    "That last scrap taught me a thing or two about {slot.skill.name}, {addressee.name}. Feeling steadier already."
  say [role=combat_reply] (pri 12) as combat_lvl_reply_1:
    "I noticed, {addressee.name}. You're handling yourself way cleaner out there."
  say [role=combat_chime] (pri 12) as combat_lvl_chime_1:
    "Good to hear. Stronger hands in a fight keep all of us breathing."

  # --- Level-Up via Building / Crafting ---
  say [role=building_open] (pri 12) as build_lvl_open_1:
    "Hah, check that out, {addressee.name}! All this hands-on work is really paying off with my {slot.skill.name}."
  say [role=building_open] (pri 12) as build_lvl_open_2:
    "Finally getting the hang of {slot.skill.name}, {addressee.name}. My joints and cuts are coming together way cleaner."
  say [role=building_reply] (pri 12) as build_lvl_reply_1:
    "Looking solid, {addressee.name}. Having someone good at {slot.skill.name} is huge for our camp."
  say [role=building_chime] (pri 12) as build_lvl_chime_1:
    "Keep at it. Better walls and gear mean safer nights."

  # --- Level-Up via Exercise / Conditioning ---
  say [role=exercise_open] (pri 12) as ex_lvl_open_1:
    "Whew... pushing myself is finally paying off, {addressee.name}. My {slot.skill.name} feels noticeably stronger."
  say [role=exercise_open] (pri 12) as ex_lvl_open_2:
    "All that training is starting to show, {addressee.name}. Definitely leveled up my {slot.skill.name}."
  say [role=exercise_reply] (pri 12) as ex_lvl_reply_1:
    "Way to stick with it, {addressee.name}. Outrunning a horde is half the battle."
  say [role=exercise_chime] (pri 12) as ex_lvl_chime_1:
    "Might have to join your routine before I fall behind."

  # --- Level-Up via Cooking ---
  say [role=cooking_open] (pri 12) as cook_lvl_open_1:
    "I'm getting the hang of {slot.skill.name}, {addressee.name}. Can actually make scavenged food taste decent now."
  say [role=cooking_reply] (pri 12) as cook_lvl_reply_1:
    "Now that's the best news I've heard all week, {addressee.name}."
  say [role=cooking_chime] (pri 12) as cook_lvl_chime_1:
    "A hot meal does wonders for morale out here."

  # --- Level-Up via Medical / First Aid ---
  say [role=medical_open] (pri 12) as med_lvl_open_1:
    "My hands are getting steadier with {slot.skill.name}, {addressee.name}. Patching wounds feels second nature now."
  say [role=medical_reply] (pri 12) as med_lvl_reply_1:
    "Glad to have you on our side, {addressee.name}. Good medical hands save lives."
  say [role=medical_chime] (pri 12) as med_lvl_chime_1:
    "Hopefully we won't need it often, but it's reassuring knowing you've got us covered."

  # --- Level-Up via Survival / Farming / Fishing / Mechanics ---
  say [role=survival_open] (pri 12) as surv_lvl_open_1:
    "Starting to get a real knack for {slot.skill.name}, {addressee.name}. Practical experience beats everything."
  say [role=survival_reply] (pri 12) as surv_lvl_reply_1:
    "Nice, {addressee.name}. That's going to keep us self-sufficient out here."
  say [role=survival_chime] (pri 12) as surv_lvl_chime_1:
    "Every new trick we learn buys us another week."

  # --- Level-Up via Reading ---
  say [role=reading_open] (pri 12) as read_lvl_open_1:
    "That book actually made {slot.skill.name} click, {addressee.name}. Makes way more sense now."
  say [role=reading_reply] (pri 12) as read_lvl_reply_1:
    "Good stuff, {addressee.name}. Knowledge doesn't weigh down a backpack."
  say [role=reading_chime] (pri 12) as read_lvl_chime_1:
    "Let's grab any more manuals we spot on supply runs."

  # --- General Level-Up Fallback ---
  say [role=general_open] (pri 10) as gen_lvl_open_1:
    "I think I'm really improving at {slot.skill.name}, {addressee.name}. Practice is paying off."
  say [role=general_reply] (pri 10) as gen_lvl_reply_1:
    "Good job, {addressee.name}. Every bit of skill counts out here."
  say [role=general_chime] (pri 10) as gen_lvl_chime_1:
    "Keep it up, we're getting stronger as a group."

  say [default] (pri 5) as default:
    "Feels like I'm getting better at {slot.skill.name} every day."

flow semantic.world.weather.rain
  say [role=weather_rain_open] (pri 8) as weather_rain_open:
    "Rain's picking up, {addressee.name}. {?clause.rain_note}"
  say [role=weather_rain_reply] (pri 8) as weather_rain_reply:
    "Yeah, {addressee.name}, let's keep dry and watch our footing."
  say [role=weather_rain_chime] (pri 8) as weather_rain_chime:
    "At least it keeps the dust down—just stay close so we don't lose sight of each other."
  say [default] (pri 5) as default:
    "Wet weather out here—stay alert."

flow semantic.world.chronology.milestone
  say [milestone.stage=first_week, actor.social_style=warm|friendly|protective] (pri 10) as first_week_warm:
    "We made it through the first week together, {addressee.name}—glad you're still here."
  say [milestone.stage=first_week, actor.social_style=guarded|withdrawn|hostile] (pri 10) as first_week_guarded:
    "One week down. Don't get comfortable."
  say [milestone.stage=first_week] (pri 8) as first_week_steady:
    "A full week since this started, and we're still standing."
  say [milestone.stage=first_month, actor.social_style=warm|friendly|protective] (pri 10) as first_month_warm:
    "A whole month out here—we've come a long way."
  say [milestone.stage=first_month, actor.social_style=guarded|withdrawn|hostile] (pri 10) as first_month_guarded:
    "A month in and the roads haven't gotten any kinder."
  say [milestone.stage=first_month] (pri 8) as first_month_steady:
    "One month survived. Keep doing what works."
  say [milestone.stage=first_season, actor.social_style=warm|friendly|protective] (pri 10) as first_season_warm:
    "Seasons are turning and we're still kicking."
  say [milestone.stage=first_season, actor.social_style=guarded|withdrawn|hostile] (pri 10) as first_season_guarded:
    "New season means new problems. Stay ready."
  say [milestone.stage=first_season] (pri 8) as first_season_steady:
    "Made it through a whole season out here."
  say [milestone.stage=first_year, actor.social_style=warm|friendly|protective] (pri 10) as first_year_warm:
    "A whole year... I honestly didn't think we'd make it this far."
  say [milestone.stage=first_year, actor.social_style=guarded|withdrawn|hostile] (pri 10) as first_year_guarded:
    "One year alive. Still plenty left that wants us dead."
  say [milestone.stage=first_year] (pri 8) as first_year_steady:
    "A full year since the outbreak. Still standing."
  say [milestone.stage=anniversary, actor.social_style=warm|friendly|protective] (pri 10) as anniversary_warm:
    "Another year under our belts—proud of how far we've come."
  say [milestone.stage=anniversary, actor.social_style=guarded|withdrawn|hostile] (pri 10) as anniversary_guarded:
    "Another year gone. Stay sharp."
  say [milestone.stage=anniversary] (pri 8) as anniversary_steady:
    "Another year survived out here."
  say [role=chronology_anniversary] (pri 6) as anniversary_role_fallback:
    "Another year survived out here."
  say [role=chronology_milestone] (pri 5) as survival_role_fallback:
    "Still standing after all this time."
  say [default] (pri 4) as default:
    "Hard to believe how long we've kept going."

flow semantic.world.event.food_crisis
  say [role=world_event_reply] (pri 12) as reply:
    "Yeah, we'll need to stretch every ration until supplies pick back up."
  say [epistemic.provenance=experienced|witnessed] (pri 10) as experienced:
    "I've seen the shelves myself—food's running dangerously low around here."
  say [epistemic.provenance=uncertain] (pri 9) as uncertain:
    "Not totally sure how bad it is, but people say food is getting scarce."
  say [epistemic.provenance=rumor|told|public] (pri 8) as rumor:
    "Word going around is food's getting tight everywhere."
  say [default] (pri 5) as default:
    "Sounds like food is getting harder to come by."

flow semantic.world.event.raider_surge
  say [role=world_event_reply] (pri 12) as reply:
    "Agreed—we keep our weapons close and watch the perimeter."
  say [epistemic.provenance=experienced] (pri 10) as experienced:
    "Ran into raiders myself recently—they're getting bolder out there."
  say [epistemic.provenance=witnessed] (pri 10) as witnessed:
    "I've spotted raider groups moving along the {noun.road}. Stay alert."
  say [epistemic.provenance=uncertain] (pri 9) as uncertain:
    "Can't confirm it firsthand, but there's talk of more raiders lately."
  say [epistemic.provenance=rumor|told|public] (pri 8) as rumor:
    "Word is raiders have been hitting camps around the area."
  say [default] (pri 5) as default:
    "Keep your head down—raiders have been active."

flow semantic.world.event.surplus
  say [role=world_event_reply] (pri 12) as reply:
    "Good to hear—let's stock up while we have the chance."
  say [epistemic.provenance=experienced|witnessed] (pri 10) as experienced:
    "Supplies are looking solid right now—saw plenty stocked up."
  say [epistemic.provenance=uncertain] (pri 9) as uncertain:
    "Heard supplies might be easing up a bit, though I haven't seen it myself."
  say [epistemic.provenance=rumor|told|public] (pri 8) as rumor:

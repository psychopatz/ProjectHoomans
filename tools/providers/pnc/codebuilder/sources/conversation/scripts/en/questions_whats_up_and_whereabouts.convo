# General check-in ("what's up?") and community-role whereabouts pools.
lang EN
namespace hoomans

flow semantic.question.whats_up
  say [subject=CONVERSATION_TOPIC, npc.fed_up] (pri 11) as fed_up:
    "Nothing's changed since you just asked!"
  say [subject=CONVERSATION_TOPIC, mood.bored] (pri 9) as bored:
    "Not much—honestly bored out of my mind. {?clause.world_pressure}"
  say [subject=CONVERSATION_TOPIC, env.raining] (pri 8) as weather:
    "The weather is the main thing on my mind right now. {?clause.rain_note}"
  say [subject=CONVERSATION_TOPIC, actor.activity=traveling] (pri 8) as traveling:
    "I'm keeping moving and watching what is ahead. {?clause.night_warning}"
  say [subject=CONVERSATION_TOPIC, actor.busy] (pri 8) as busy:
    "I'm keeping busy and trying to stay useful. {?clause.world_pressure}"
  say [subject=CONVERSATION_TOPIC] (pri 6) as default:
    "Not much. I'm just trying to keep things together. {?mood.tail} {?clause.world_pressure}"
  say [subject=CONVERSATION_TOPIC] (pri 6) as default_alt:
    "Same as ever. Staying alive and watching the {noun.road}. {?clause.world_pressure}"

flow semantic.question.community_role_whereabouts.unknown
  say [default] (pri 6) as default:
    "I don't know where our %15 is."

flow semantic.question.community_role_whereabouts.home
  say [default] (pri 6) as default:
    "Our %15 is here."

flow semantic.question.community_role_whereabouts.preparing
  say [default] (pri 6) as default:
    "Our %15 is preparing to leave."

flow semantic.question.community_role_whereabouts.away
  say [default] (pri 6) as default:
    "Our %15 is away right now."

flow semantic.question.community_role_whereabouts.returning
  say [default] (pri 6) as default:
    "Our %15 is on the way home."

flow semantic.question.community_role_whereabouts.visiting
  say [default] (pri 6) as default:
    "Our %15 is at %16, %17 of here."

flow semantic.question.community_role_whereabouts.visiting_eta
  say [default] (pri 6) as default:
    "Our %15 is at %16, %17 of here. They should be back %18."

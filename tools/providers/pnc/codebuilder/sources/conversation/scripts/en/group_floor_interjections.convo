# Multi-party ("V" group talk & NPC-to-NPC) shared-floor interjections.
lang EN
namespace hoomans

flow group.interjection
  say [floor.interjection_kind=calm_down, floor.speaker_annoyed] (pri 12) as calm_down:
    "Easy, {floor.speaker_name}—take a breath, no need to snap."
  say [floor.interjection_kind=back_up, floor.side_with_speaker] (pri 11) as back_up:
    "I'm with {floor.speaker_name} on this—give us a second."
  say [floor.interjection_kind=concern, floor.speaker_injured] (pri 11) as concern_injured:
    "Hey, {floor.speaker_name}, you look rough—let's get you patched up first."
  say [floor.interjection_kind=concern] (pri 10) as concern_general:
    "Hang in there, {floor.speaker_name}—we've got your back."
  say [floor.interjection_kind=disagree, !floor.side_with_speaker] (pri 10) as disagree:
    "Speak for yourself, {floor.speaker_name}."
  say [floor.interjection_kind=chime_in, group.broadcast] (pri 9) as chime_in_broadcast:
    "Count me in too—right behind {floor.speaker_name}{end}"
  say [floor.interjection_kind=chime_in] (pri 8) as chime_in:
    "Yeah, what {floor.speaker_name} said{end}"
  say [default] (pri 5) as fallback:
    "I hear you, {floor.speaker_name}{end}"

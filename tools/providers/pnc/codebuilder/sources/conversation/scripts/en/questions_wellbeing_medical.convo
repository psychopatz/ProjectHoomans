# Wellbeing status, grounded injury reports, and medical bite status pools.
lang EN
namespace hoomans

flow semantic.question.wellbeing
  say [npc.fed_up] (pri 12) as fed_up:
    "Same as two minutes ago! You don't need to keep asking."
  say [emotion.type=panic, emotion.urgency=critical|emergency] (pri 10) as panic:
    "I'm pretty shaken up right now{end}"
  say [emotion.type=stress, emotion.urgency=critical|emergency] (pri 9) as stress:
    "I'm tense, but I can keep going."
  say [need.type=thirst, need.urgency=moderate|severe|emergency|critical] (pri 9) as thirst:
    "I'm pretty thirsty. Could you spare some water?"
  say [need.type=thirst, need.urgency=moderate|severe|emergency|critical] (pri 9) as thirst_alt:
    "I could really use a drink. Do you have any water?"
  say [need.type=hunger, need.urgency=moderate|severe|emergency|critical] (pri 8) as hunger:
    "I'm pretty hungry, if I'm honest. Do you have anything to eat?"
  say [need.type=hunger, need.urgency=moderate|severe|emergency|critical] (pri 8) as hunger_alt:
    "I'm getting hungry. Could you spare something to eat?"
  say [need.type=fatigue, need.urgency=moderate|severe|emergency|critical] (pri 8) as fatigue:
    "I'm worn out, but I can still manage."
  say [need.type=fatigue, need.urgency=moderate|severe|emergency|critical] (pri 8) as fatigue_alt:
    "I'm tired. A little rest would help."
  say [actor.health=injured|wounded|critical] (pri 8) as injured:
    "A little banged up, but I'll manage."
  say [mood.cheerful] (pri 7) as cheerful:
    "Doing pretty well, all things considered! How about you?"
  say [default] (pri 5) as default:
    "I'm okay. How about you?"

flow semantic.question.medical_bite.positive
  say [default] (pri 6) as default:
    "Yes, I've been bitten."

flow semantic.question.medical_bite.negative
  say [default] (pri 6) as default:
    "No, I don't have a recorded bite."

flow semantic.question.medical_bite.unknown
  say [default] (pri 6) as default:
    "I can't confirm whether I've been bitten."

flow semantic.question.wellbeing.grounded
  say [actor.health=injured|wounded|critical, actor.social_style=friendly|protective] (pri 9) as friendly:
    "I took a {adj.hit} hit, but I'm steady enough to keep moving. Thanks for checking in."
  say [actor.health=injured|wounded|critical, actor.social_style=withdrawn] (pri 9) as withdrawn:
    "I'm hurt, but I'm managing. I'd rather not make a big thing of it."
  say [default] (pri 5) as default:
    "I took a hit, but I'm holding together."

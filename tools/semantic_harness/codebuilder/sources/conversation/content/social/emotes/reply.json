        ],
        "warm": [
          {
            "translations": {
              "EN": "You're lucky I know you.",
              "TL": "Suwerte ka dahil kilala kita."
            }
          },
          {
            "translations": {
              "EN": "Very funny. Don't make a habit of it.",
              "TL": "Nakakatawa. Huwag mong gagawing bisyo 'yan."

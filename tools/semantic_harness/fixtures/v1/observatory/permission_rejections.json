{
  "schema": "pnc.semantic-test.v1",
  "suite": "observatory.permission_rejections",
  "cases": [
    {
      "id": "observatory.permissions.follow_rejected.en",
      "tags": ["observatory", "permissions", "rejected", "follow"],
      "scenario": {
        "runtime": {
          "commandResponses": {
            "follow": {
              "accepted": false,
              "reason": "permission_denied"
            }
          }
        }
      },
      "turns": [
        {
          "text": "follow me",
          "language": "EN",
          "expect": {
            "ir.action": "FOLLOW",
            "actionResult.accepted": false,
            "actionResult.status": "rejected",
            "actionResult.reason": "permission_denied"
          }
        }
      ]
    },

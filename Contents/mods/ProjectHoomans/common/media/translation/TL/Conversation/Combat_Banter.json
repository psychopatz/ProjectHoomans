{
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.01": "Biyak na biyak ang bulok na ulo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.02": "Bumaon nang malalim ang palakol sa bungo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.03": "Biyak sa dalawa. Manatili ka sa lupa.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.04": "Ibaon ang palakol sa gitna ng tenga nito.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.05": "Mabigat na hataw. Tapos magpakailanman.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.06": "Durog ang tuktok sa isang taga.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.07": "Walang laban ang bungong 'yon.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.08": "Bumasag diretso sa buto.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.09": "Biyak hanggang leeg.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.10": "Isang malakas na taga at tapos na.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.01": "Tanggal ang ulo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.02": "Biyak ang bungo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.03": "Naputol ang gulugod. Tapos.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.04": "Walang tatayo kapag walang ulo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.05": "Bumaon diretso sa bulok na buto.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.06": "Putol ang leeg. Diyan ka lang.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.07": "Hiniwa hanggang bumagsak sa lupa.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.08": "Dire-diretso ang talim.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.09": "Wala nang ulo. Hindi na tatayo 'yan.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.10": "Malinis na pugot. Tuloy lang.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.01": "Ramdam ko ang pag-crack no'n.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.02": "Durog ang bungo sa pira-piraso.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.03": "Pinitpit ang ulo na parang pakwan.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.04": "Walang tatayo pagkatapos ng gano'ng hampas.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.05": "Basag ang bawat buto sa mukha.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.06": "Ramdam hanggang braso ang impact.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.07": "Lubog ang bulok na bungo papasok.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.08": "Mabigat na tama. Huwag ka nang babangon.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.09": "Ibinagsak sa sahig sa lakas ng palo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.10": "Basag nang todo. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.01": "Tuwid pa ring bumaril itong {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.02": "Walang tatalo sa {combatWeaponDisplayName} na 'to kapag kailangan.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.03": "Maaasahang {combatWeaponDisplayName}. Hindi ako binibigo.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.04": "Sabi ko sa'yo may lakas pumigil itong {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.05": "Ibinagsak agad ng {combatWeaponDisplayName} sa lupa.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.06": "Malinis na trabaho gamit ang {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.07": "Tumagos agad itong {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.08": "Mabuti na lang at handa itong {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.09": "Isang bala lang mula sa {combatWeaponDisplayName} na 'to, sapat na.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.10": "Winasak ng {combatWeaponDisplayName} ang bungo nito.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.01": "Eksakto sa gusto ko. Bagsak.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.02": "Bumagsak sa isang putok. Ayos.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.03": "Sa pagitan mismo ng mga mata. Sapul.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.04": "Ganyan magpabagsak ng isa.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.05": "Tigok agad. Ayos.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.06": "Sapul na sapul ang isang 'yon.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.07": "Nakakita ng butas at tinamaan agad.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.08": "Bumagsak na parang bato.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.09": "Bagsak ang target. Sino susunod?",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.10": "Ipinasok ang tingga sa dapat kalagyan.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.01": "Kaya gusto ko ang abot nito.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.02": "Tumagos sa butas ng mata.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.03": "Dumistansya at itinarak pabagsak.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.04": "Sibat sa utak. Tapos.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.05": "Itinarak bago pa ako mahawakan.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.06": "Diretsong saksak. Bagsak agad.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.07": "Bumutas sa bungo nang malinis.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.08": "Tinuhog at ibinagsak. Susunod na target.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.09": "Laging panalo ang mahabang abot.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.10": "Tuhog sa noo. Tapos.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.01": "Isang taga. Tapos.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.02": "Mabigat na taga. Sulong sa unahan.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.03": "Nabasag ang gulugod sa isang palo. Kilos.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.04": "Biyak ang bungo. Banta nawala na.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.05": "Solido ang tama. Susunod na target.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.06": "Bagsak agad. Tuloy ang lakad.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.07": "Nagawa ng palakol ang trabaho. Abante.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.08": "Malinis na bumaon sa buto. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.09": "Tapos na ang isang 'yon. Hakbang pasulong.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.10": "Tiyak na tama. Huwag hihinto ngayon.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.01": "Malinis na hiwa. Sunod.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.02": "Pugot ang ulo. Sulong.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.03": "Tumama nang tumpak ang talim. Hawakan ang linya.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.04": "Isang hampas. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.05": "Bumagsak nang hindi nahihinto ang hakbang.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.06": "Napugutan. Linisin ang daan.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.07": "Banta bagsak na. Manatiling alerto.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.08": "Matatag na hampas. Pasulong.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.09": "Ulo nawasak. Huwag magtagal.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.10": "Mabilis na hiwa. Tuloy-tuloy tayo.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.01": "Gitnang-gitna. Tuloy lang.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.02": "Malinis na tama. Sulong.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.03": "Bagsak. Sinusuri ang susunod na parte.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.04": "Isang putok, isang bagsak. Panatilihin ang bilis.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.05": "Target naalis. Ayusin ang pwesto.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.06": "Eksaktong putok. Lusot tayo.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.07": "Banta nawala na. Tumingin sa unahan.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.08": "Kumpirmadong patay. Abante.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.09": "Naasikaso na. Bantayan ang agwat.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.10": "Gitna muna bago ulo. Tapos.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.01": "Napanatili ko siya sa tamang distansya.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.02": "Diretsong ulos. Bagsak ang target.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.03": "Distansya nahawakan, patay kumpirmado.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.04": "Tumagos ang sibat. Abante.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.05": "Itinarak at tinapos. Kilos.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.06": "Malinis na tama mula sa ligtas na layo.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.07": "Naitumba mula sa malayo. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.08": "Walang peligrong kinuha. Lusot.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.09": "Tinuhog. Malinis ang daan.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.10": "Matatag na saksak sa bungo. Tapos.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.01": "Nawasak ang ulo. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.02": "Nahiwa sa leeg. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.03": "Winasak ang ulo nang buo.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.04": "Tumigil ang galaw. Sunod.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.05": "Basag ang bungo. Pasulong.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.06": "Wala nang buhay. Malinis.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.07": "Hiwa ang leeg. Tapos.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.08": "Walang natitirang kilos. Abante.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.09": "Biyak ang ulo. Magpatuloy.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.10": "Kumpirmadong napugutan.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.01": "Malinis na tira.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.02": "Patay ang target. Kilos.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.03": "Walang aksaya. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.04": "Bumaon ang bala sa utak. Sunod.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.05": "Bumagsak nang walang aberya.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.06": "Banta tinapos na.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.07": "Simpleng asinta.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.08": "Nabawasan ng isang sagabal.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.09": "Patay agad.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.10": "Bukas na ang daan.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.01": "Dinurog.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.02": "Basag ang istruktura ng bungo. Tapos.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.03": "Durog na. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.04": "Sapat ang lakas ng tama. Sunod.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.05": "Tumigil ang lahat ng galaw.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.06": "Pinitpit.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.07": "Nabasag ang mga buto. Malinis.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.08": "Naitama ang bigat. Tapos.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.09": "Winasak. Abante.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.10": "Lumalubog ang bungo sa lakas.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.01": "Maganda ang abot. Panatilihin ang linya.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.02": "Nanatili sa ligtas na layo. Epektibo 'yon.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.03": "Lakas at abot ang tumapos. Sulong.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.04": "Ligtas na distansya napanatili. Sunod.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.05": "Magandang distansya ng sandata. Bantayan ang gilid.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.06": "Malinis na bumaon. Tignan ang hawakan.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.07": "Tinamaan bago makalapit. Ayusin ang hanay.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.08": "Ligtas tayo dahil sa distansya. Magpatuloy.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.09": "Kontroladong engkwentro. Pasulong.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.10": "Nailayo ang mga ngipin dahil sa abot. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.01": "Ginawa ng talim ang trabaho nito. Tuloy.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.02": "Malinis na hiwa. Tignan ang talim.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.03": "Bagsak nang hindi gumagawa ng ingay.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.04": "Tahimik na patay. Panatilihing matalas ang mata.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.05": "Hiwa nang malinis. Huwag ibaba ang depensa.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.06": "Isang tahimik na pagbagsak. Tuloy ang hakbang.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.07": "Maayos pa ang talim. Pasulong.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.08": "Tahimik na naitumba ang target. Suriin ang pasilyo.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.09": "Walang balang nasayang. Maganda.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.10": "Tahimik na ibinagsak. Bantayan ang likuran.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.01": "Dinurog. Bantayan ang susunod.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.02": "Basag ang bungo. Tignan ang gasgas ng sandata.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.03": "Mabigat na hampas. Sulong sa unahan.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.04": "Mabisang palo. Patatagin ang tindig.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.05": "Bagsak. Huwag magpakapagod sa paghataw.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.06": "Bumasag nang tuluyan. Suriin ang paligid.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.07": "Mabigat na palo ang tumapos. Abante.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.08": "Naitumba ng lakas ang banta. Tignan ang mga sulok.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.09": "Magandang tama. Tipirin ang lakas.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.10": "Tapos. Hakbangan at magpatuloy sa pagmamasid.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.01": "Maganda ang tama. Suriin ang linya.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.02": "Isang bala ang nagamit. Tignan ang mga sulok.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.03": "Bagsak ang target. Magmasid bago sumulong.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.04": "Malinis na putok. Tandaan ang natitirang bala.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.05": "Bumagsak nang maayos. Mag-ingat sa mga nasa gilid.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.06": "Bagsak. Panatilihing nakataas ang sandata.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.07": "Banta naalis. Bilangin ang bala.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.08": "Solido ang tama. Tuloy sa maingat na pagkilos.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.09": "Bagsak ang target. Suriin ang paligid.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.10": "Tumama nang maayos ang putok. Huwag magmadali.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.01": "Tinamaan. Huwag umasa sa swerte nang dalawang beses.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.02": "Dalawang putok ang kinailangan, pero bagsak na.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.03": "Magulo ang tama, pero nagawa ang trabaho.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.04": "Bagsak. Tignan ang natitirang bala ngayon.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.05": "Nakaaksaya ng bala roon. Pakalmahin ang asinta.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.06": "Nasa sahig na. Mag-reload kung kailangan.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.07": "Tumama rin sa wakas. Manatiling nakatutok.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.08": "Bagsak ang banta. Huwag magpabaya.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.09": "Muntik na 'yon. Ayusin ulit ang pwesto.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.10": "Bagsak. Bantayan ang ingay.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.01": "Bagsak na. Kailangan ko ng sandata.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.02": "Nakaraos nang walang gamit, pero hanapan mo ako ng mahahawakan.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.03": "Masyadong delikado. Kailangan natin ng gamit.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.04": "Naibagsak ko, pero hindi ko kayang ulit-ulitin 'yon.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.05": "Patay na. Maghanap ka ng anumang pamalo sa paligid.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.06": "Tinulak at tinapakan. Bigyan mo ako ng kahit matalim.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.07": "Masyadong delikado. Kailangan ng maayos na gamit.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.08": "Naitumba nang walang armas. Huwag umasang mauulit ang swerte.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.09": "Gumabana ang mga kamay nang minsan. Maghanap ng sandata ngayon.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.10": "Pasa ang kamao ko, pero patay na. Mag-armas tayo.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.01": "Nahati.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.02": "Pugot.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.03": "Bagsak.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.04": "Tapos.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.05": "Malinis.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.06": "Yari.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.07": "Tanggal.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.08": "Bumagsak.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.09": "Malinis na tama.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.10": "Lalakad na.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.01": "Tinamaan.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.02": "Bagsak.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.03": "Target bagsak.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.04": "Isang bala.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.05": "Malinis.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.06": "Tanggal.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.07": "Naitumba.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.08": "Tumama ang putok.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.09": "Naalis.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.10": "Tapos.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.01": "Diyos ko... may dugo kahit saan.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.02": "Pira-piraso na... kailangan ko ng saglit.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.03": "Ang amoy... Diyos ko, masusuka yata ako.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.04": "Ramdam ko pa rin ang lagutok...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.05": "Diretso sa akin... kailangan kong hiwain.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.06": "Ayaw tumigil ng panginginig ng mga kamay ko...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.07": "Patay na ba talaga? Tingnan mo...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.08": "Kakila-kilabot 'yon... pero tapos na.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.09": "Diyos ko, ayaw na ayaw kong ginagawa 'to...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.10": "Wala nang ulo... umatras muna tayo.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.01": "Diyos ko... tinamaan ko talaga.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.02": "Nanginginig ang mga kamay ko... pero bagsak na.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.03": "Napatay ko ba? Diyos ko, sa tingin ko patay na.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.04": "Masyadong malapit 'yon...",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.05": "Nag-panic ako at bumaril... salamat sa Diyos.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.06": "Patay na ba? Sabihin mo sa akin kung patay na.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.07": "Lulukso ang puso ko sa kaba...",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.08": "Hindi ko akalaing tatama ang putok na 'yon.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.09": "Bagsak na... huwag mong hayaang may makalapit pang iba.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.10": "Diyos ko... ang tunog na 'yon... tahimik na rin sa wakas.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.01": "Diyos ko. Kamay ko lang ang ginamit ko.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.02": "Kinailangan kong itulak pabagsak... mga kamay ko lang.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.03": "Halos makagat ako. Tingnan mo ang nanginginig kong braso.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.04": "Kailangan ko ng sandata. Hindi ko na mauulit 'yon.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.05": "Naramdaman ko ang ngipin nito malapit sa jacket ko.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.06": "Tinapakan ko ang ulo... patawarin ako ng Diyos.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.07": "Dala lang 'yon ng matinding takot.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.08": "Pasa-pasa ang mga kamay ko... pero buhay pa ako.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.09": "Ayoko nang mapalapit nang gano'n kailanman.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.10": "Patay na... itinulak ko at tinapakan.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.01": "Nakuha ko. Ayos ka?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.02": "Bagsak ang banta. Tignan mo sarili mo.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.03": "Ibinagsak ko ang isa. Hawak ko ang likod mo.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.04": "Malinis! May tama ka ba kahit saan?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.05": "Nailayo ko sa atin. Dumikit ka.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.06": "Bagsak na 'yon. Manatiling gising ang mata.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.07": "Inasikaso ko na. Ayos ka lang?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.08": "Tumama ang putok. Ligtas ka?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.09": "Bagsak ang target. Sinasalag kita.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.10": "Tapos na ang isang 'yon. Bantayan ang gilid.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.01": "Bagsak na. Dumikit ka lang.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.02": "Nailayo ko sa'yo. Ayos ka lang?",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.03": "Ibinagsak ko na. Tignan ang sulok mo.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.04": "Nandito lang ako kasama mo. Patay na.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.05": "Dinurog bago pa makalapit.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.06": "Manatili sa likod ko. Tapos na 'yon.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.07": "Ibinagsak ko na. Huminga ka muna.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.08": "Patay sa sahig. Nakakayanan mo pa?",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.09": "Hawak ko ang linyang 'to. Bantayan ang likod.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.10": "Tapos na ang isang 'yon. Ayos lang tayo."
}

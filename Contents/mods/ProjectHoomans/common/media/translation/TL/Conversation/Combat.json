{
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.01": "Malaking pagkakamali ang ginawa mo.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.02": "Sige. Gusto mo ng laban, makukuha mo.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.03": "Sinaktan mo ako? Pagsisisihan mo 'yan.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.04": "Ulitin mo pa at tignan natin ang mangyayari.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.05": "Maling tao ang binangga mo.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.06": "Gusto mo pala ng gulo?! Halika rito!",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.07": "Huling libreng tira mo na 'yon.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.08": "Ililibing kita sa ginawa mo.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.09": "Hinataw mo ako? Malaking mali.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.10": "Gusto mo talagang gawin 'to? Tara.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.01": "Tama na. Tapos ka na.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.02": "Maling desisyon. Ipagtanggol mo ang sarili mo.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.03": "Hindi mo dapat ginawa 'yon.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.04": "Binigyan kita ng puwang. Ipagtanggol mo sarili mo ngayon.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.05": "Diyan na nagtatapos 'to.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.06": "Pumili ka na ng kahihinatnan mo.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.07": "Hindi kita hahayaang saktan ako. Sumuko ka o lumaban.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.08": "Hindi katanggap-tanggap. Ibaba mo ang sandata mo.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.09": "Lumagpas ka sa linya.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.10": "Tumigil ka ngayon din, o tatapusin ko 'to.",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.01": "Bakit mo ginawa iyon?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.02": "Ano bang problema mo?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.03": "Hoy! Tingnan mo ang ginagawa mo!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.04": "Hinataw mo ba ako?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.05": "Gusto mo ba akong patayin?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.06": "Ano bang iniisip mo?! Tigil!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.07": "Teka! Atras!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.08": "Huwag mo akong saktan! Ano bang nangyayari sa'yo?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.09": "Huwag mo akong pagbantaan!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.10": "Umatras ka palayo sa akin!",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.01": "Lumayo ka. Ngayon na.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.02": "Tama na. Lumayo ka sa akin.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.03": "Umatras ka.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.04": "Huwag mong uulitin 'yon.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.05": "Huwag mo akong hahawakan.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.06": "Huling babala.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.07": "Diyan ka lang sa malayo.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.08": "Ibaba mo 'yan.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.09": "Dumistansya ka.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.10": "Isang hakbang pabalik. Ngayon na.",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.01": "Ano ba?! Lumayo ka!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.02": "Bakit mo ako inaatake?! Lumayo ka!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.03": "Tigil! Ano bang ginagawa mo?!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.04": "Huwag mo akong hawakan! Nababaliw ka na ba?!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.05": "Umalis ka sa harap ko ngayon din!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.06": "Diyos ko, atras! Ibaba mo 'yan!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.07": "Bakit mo ako sinaktan?! Lumayo ka!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.08": "Lumayo ka sa akin! Huwag mong gawin 'to!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.09": "Nawawala ka na ba sa sarili mo?! Tigil!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.10": "Atras! Huwag kang lalapit pa!"
}

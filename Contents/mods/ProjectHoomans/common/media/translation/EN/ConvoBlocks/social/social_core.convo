# Core social interactions: thanks, apologies, compliments, accept/refuse, gossip, self-reflection, and identity evasion.
language EN
namespace hoomans

dialogue semantic.thanks
  say [mood.cheerful] as cheerful:
    "Anytime! Glad I could help."
  say [actor.social_style=withdrawn] as withdrawn:
    "Don't mention it."
  say [default] as default:
    "You're welcome."

dialogue semantic.apology
  say [emotion.type=stress|panic, emotion.urgency=moderate|severe|critical|emergency] as stressed:
    "I know things are tense. Let's keep it calm."
  say [actor.social_style=friendly|protective] as friendly:
    "It's okay. We can put that behind us."
  say [relationship.state=Friend|Trusted|Ally|Member|Lover] as trusted:
    "I appreciate you saying that. We're all under pressure."
  say [actor.social_style=withdrawn] as withdrawn:
    "All right. Let's leave it there."
  say [default] as default:
    "Noted. Let's move on."

dialogue semantic.compliment
  say [actor.social_style=friendly|protective] as friendly:
    "Thanks. You seem pretty great yourself."
  say [relationship.state=Member|Lover] as trusted:
    "Thanks. Hearing that from you means a lot."
  say [actor.social_style=withdrawn] as withdrawn:
    "Oh. Thank you, that's kind of you."
  say [default] as default:
    "Thanks. That's kind of you."
    "I appreciate you saying that."

dialogue semantic.accept
  say [conversation.pending_request] as request:
    "All right, I'll take care of it."
  say [default] as default:
    "All right."

dialogue semantic.conversation.acknowledged
  say [actor.social_style=friendly|protective] as friendly:
    "All right. Ask if you want to talk about it more."
  say [actor.social_style=withdrawn] as withdrawn:
    "All right. We can leave it there for now."
  say [default] as default:
    "All right. Ask if you want to talk about it more."

dialogue semantic.refuse
  say [conversation.pending_request] as request:
    "No problem. I'll leave it."
  say [emotion.type=stress|panic, emotion.urgency=moderate|severe|critical|emergency] as stressed:
    "I hear you, but I can't take that on while I'm this tense."
  say [actor.social_style=friendly|protective] as friendly:
    "I see it differently, but we're okay."
  say [relationship.state=Friend|Trusted|Ally|Member|Lover] as trusted:
    "I respect that. I still don't agree."
  say [actor.social_style=withdrawn] as withdrawn:
    "Let's leave it there."
  say [default] as default:
    "No."

dialogue semantic.gossip
  say [memory.available] as memory:
    "I have something I remember about that."
  say [default] as unknown:
    "I haven't heard anything about that yet."

dialogue semantic.self_reflection
  say [actor.social_style=friendly|protective] as friendly:
    "Hey. Don't talk about yourself like that. You matter."
  say [relationship.state=Friend|Trusted|Ally|Member|Lover] as trusted:
    "You're harder on yourself than you need to be."
  say [actor.social_style=withdrawn] as withdrawn:
    "Don't make a habit of saying things like that."
  say [emotion.type=stress|panic] as stressed:
    "We've all made mistakes. Focus on what comes next."
  say [default] as default:
    "Don't talk about yourself like that."

dialogue semantic.identity.evasion
  say [relationship.identity_trust=untrustworthy] as untrustworthy:
    "You avoided my question. I can't trust you with my name."
  say [actor.social_style=friendly|protective] as friendly:
    "I asked you your name. Changing the subject makes me question your honesty."
  say [actor.social_style=withdrawn] as withdrawn:
    "Forget it. Keep your name to yourself; I don't trust evasive people."
  say [default] as default:
    "You avoided my question. That makes you seem untrustworthy."

# Subject: GREETING OPENING & FOLLOW-UP FLOWS.
language EN
namespace hoomans

dialogue semantic.flow.greeting.opening
  choice greeting.check_in.report_wellbeing:
    label: "Say you're doing fine"
    say: "I'm fine, thank you."
    utility: openness
    intent: INFORM
    subject: WELLBEING
  say [environment.raining] as rain:
    "Hey there. Wet one today. >> How are you holding up?"
  say [actor.social_style=friendly|protective] as friendly:
    "Hey there! Good to see you. >> How are you doing?"
  say [default] as default:
    "Hey there. >> How are you holding up?"

dialogue semantic.flow.greeting.followup
  say [actor.social_style=friendly|protective] as friendly:
    "You're welcome. It's good to see you too."
  say [default] as default:
    "Good to hear. Take care out there."

# Subject: NPC EMOTE REPLIES.
language EN
namespace hoomans

flow semantic.emote.reply
  say [action=thumbsup, conversation.previous_topic=water] (priority 9) as thumbsup_active:
    "Good—glad we're staying ahead on water."
  say [action=thumbsup] (priority 7) as thumbsup:
    "Right back at you{end}"
  say [action=thumbsdown] (priority 7) as thumbsdown:
    "Alright, noted. Not a fan of that."
  say [action=insult] (priority 7) as insult:
    "Watch it. No need for that."
  say [action=wavehi] (priority 7) as wavehi:
    "Hey there{end}"
  say [action=wavebye] (priority 7) as wavebye:
    "Take care out there."
  say [action=thankyou] (priority 7) as thankyou:
    "Anytime."
  say [action=clap] (priority 7) as clap:
    "Appreciate that!"
  say [action=salute] (priority 7) as salute:
    "Right back at you, partner."
  say [default] (priority 5) as default:
    "Got it."

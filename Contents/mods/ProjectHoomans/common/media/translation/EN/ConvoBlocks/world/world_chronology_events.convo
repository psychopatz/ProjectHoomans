# Subject: WORLD CHRONOLOGY MILESTONES & SCOPED EVENTS.
language EN
namespace hoomans

dialogue semantic.world.chronology.milestone
  say [milestone.stage=first_week, actor.social_style=warm|friendly|protective] as first_week_warm:
    "We made it through the first week together, {addressee.name}—glad you're still here."
  say [milestone.stage=first_week, actor.social_style=guarded|withdrawn|hostile] as first_week_guarded:
    "One week down. Don't get comfortable."
  say [milestone.stage=first_week] as first_week_steady:
    "A full week since this started, and we're still standing."
  say [milestone.stage=first_month, actor.social_style=warm|friendly|protective] as first_month_warm:
    "A whole month out here—we've come a long way."
  say [milestone.stage=first_month, actor.social_style=guarded|withdrawn|hostile] as first_month_guarded:
    "A month in and the roads haven't gotten any kinder."
  say [milestone.stage=first_month] as first_month_steady:
    "One month survived. Keep doing what works."
  say [milestone.stage=first_season, actor.social_style=warm|friendly|protective] as first_season_warm:
    "Seasons are turning and we're still kicking."
  say [milestone.stage=first_season, actor.social_style=guarded|withdrawn|hostile] as first_season_guarded:
    "New season means new problems. Stay ready."
  say [milestone.stage=first_season] as first_season_steady:
    "Made it through a whole season out here."
  say [milestone.stage=first_year, actor.social_style=warm|friendly|protective] as first_year_warm:
    "A whole year... I honestly didn't think we'd make it this far."
  say [milestone.stage=first_year, actor.social_style=guarded|withdrawn|hostile] as first_year_guarded:
    "One year alive. Still plenty left that wants us dead."
  say [milestone.stage=first_year] as first_year_steady:
    "A full year since the outbreak. Still standing."
  say [milestone.stage=anniversary, actor.social_style=warm|friendly|protective] as anniversary_warm:
    "Another year under our belts—proud of how far we've come."
  say [milestone.stage=anniversary, actor.social_style=guarded|withdrawn|hostile] as anniversary_guarded:
    "Another year gone. Stay sharp."
  say [milestone.stage=anniversary] as anniversary_steady:
    "Another year survived out here."
  say [role=chronology_anniversary] as anniversary_role_fallback:
    "Another year survived out here."
  say [role=chronology_milestone] as survival_role_fallback:
    "Still standing after all this time."
  say [default] as default:
    "Hard to believe how long we've kept going."

dialogue semantic.world.event.food_crisis
  say [role=world_event_reply] as reply:
    "Yeah, we'll need to stretch every ration until supplies pick back up."
  say [epistemic.provenance=experienced|witnessed] as experienced:
    "I've seen the shelves myself—food's running dangerously low around here."
  say [epistemic.provenance=uncertain] as uncertain:
    "Not totally sure how bad it is, but people say food is getting scarce."
  say [epistemic.provenance=rumor|told|public] as rumor:
    "Word going around is food's getting tight everywhere."
  say [default] as default:
    "Sounds like food is getting harder to come by."

dialogue semantic.world.event.raider_surge
  say [role=world_event_reply] as reply:
    "Agreed—we keep our weapons close and watch the perimeter."
  say [epistemic.provenance=experienced] as experienced:
    "Ran into raiders myself recently—they're getting bolder out there."
  say [epistemic.provenance=witnessed] as witnessed:
    "I've spotted raider groups moving along the {noun.road}. Stay alert."
  say [epistemic.provenance=uncertain] as uncertain:
    "Can't confirm it firsthand, but there's talk of more raiders lately."
  say [epistemic.provenance=rumor|told|public] as rumor:
    "Word is raiders have been hitting camps around the area."
  say [default] as default:
    "Keep your head down—raiders have been active."

dialogue semantic.world.event.surplus
  say [role=world_event_reply] as reply:
    "Good to hear—let's stock up while we have the chance."
  say [epistemic.provenance=experienced|witnessed] as experienced:
    "Supplies are looking solid right now—saw plenty stocked up."
  say [epistemic.provenance=uncertain] as uncertain:
    "Heard supplies might be easing up a bit, though I haven't seen it myself."
  say [epistemic.provenance=rumor|told|public] as rumor:
    "Word is there's a surplus of supplies making the rounds."
  say [default] as default:
    "Things are looking a little better on supplies right now."

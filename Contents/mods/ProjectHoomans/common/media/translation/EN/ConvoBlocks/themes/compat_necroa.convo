# Mod Compatibility: Necroa.
language EN
namespace hoomans

dialogue semantic.compat.necroa.mask_warning
  choice necroa.what_happened:
    label: "What's wrong with the air?"
    say: "What's wrong with the air?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_WHAT_HAPPENED
  say [social.role=family] as family:
    "Put your mask on, family. I am not losing you to the air."
  say [social.role=colonist] as colonist:
    "Mask up. We keep the camp safe together."
  say [default] as default:
    "Put your mask back on. Knox is airborne."

dialogue semantic.compat.necroa.player_mask_removed
  say [social.role=hostile] as hostile:
    "Put your mask back on before you become a problem."
  say [social.role=lover] as lover:
    "Please put your mask back on, love. This air is not safe."
  say [default] as default:
    "Put your mask back on. The air is not safe."

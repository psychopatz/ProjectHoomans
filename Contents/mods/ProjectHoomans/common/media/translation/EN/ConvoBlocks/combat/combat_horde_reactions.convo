# Subject: HORDE & COMBAT REACTIONS.
language EN
namespace hoomans

dialogue semantic.combat.horde.prompt
  choice semantic.combat.horde.choice.engage:
    label: "Take them."
    say: "Take them."
    utility: directness
    intent: REQUEST
    action: COMBAT_ENGAGE
  choice semantic.combat.horde.choice.avoid:
    label: "Go around."
    say: "Go around."
    utility: caution
    intent: REQUEST
    action: COMBAT_AVOID
  choice semantic.combat.horde.choice.hold:
    label: "Hold for now."
    say: "Hold for now."
    utility: caution
    intent: REQUEST
    action: COMBAT_HOLD
  say [combat.style=aggressive|brave] as eager:
    "That's a hell of a crowd. We taking them?"
  say [combat.style=shaken] as shaken:
    "God... that's a lot. Are we really fighting all of them?"
  say [combat.style=reserved|cold] as reserved:
    "Horde ahead. Engage or go around?"
  say [default] as default:
    "That's a lot of them. We fighting or going around?"

blueprint offer.combat_horde_nudges
  choice combat.horde.what_happened:
    label: "What's out there?"
    say: "What's out there?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_WHAT_HAPPENED
  choice combat.horde.how_many:
    label: "How many?"
    say: "How many are there?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_QUANTITY
  choice semantic.followup.event.location:
    label: "Where are they?"
    say: "Where are they coming from?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_LOCATION

dialogue semantic.combat.horde
  use offer.combat_horde_nudges
  say [event.horde_phase=escalated] as escalated:
    "More are piling in. This is getting bad."
  say [event.horde_phase=deescalated] as deescalated:
    "They're thinning out. Don't relax yet."
  say [event.horde_phase=started] as started:
    "That's a lot of them. Stay sharp."
  say [default] as default:
    "Horde nearby. Keep your eyes up."

dialogue semantic.combat.reaction
  use offer.combat_horde_nudges
  say [event.type=zombie_stamina_retreat] as retreat:
    "I need a moment before I can swing again."
  say [event.type=combat_awareness|zombie_horde_detected] as threat:
    "That threat is down. Stay alert."
  say [default] as default:
    "Good work. Keep watching the area."

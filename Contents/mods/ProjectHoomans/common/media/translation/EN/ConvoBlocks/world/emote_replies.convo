# Subject: NPC EMOTE REPLIES.
language EN
namespace hoomans

dialogue semantic.emote.reply
  say [action=thumbsup, conversation.previous_topic=water] as thumbsup_active:
    "Good—glad we're staying ahead on water."
  say [action=thumbsup] as thumbsup:
    "Right back at you{end}"
  say [action=thumbsdown] as thumbsdown:
    "Alright, noted. Not a fan of that."
  say [action=insult] as insult:
    "Watch it. No need for that."
  say [action=wavehi] as wavehi:
    "Hey there{end}"
  say [action=wavebye] as wavebye:
    "Take care out there."
  say [action=thankyou] as thankyou:
    "Anytime."
  say [action=clap] as clap:
    "Appreciate that!"
  say [action=salute] as salute:
    "Right back at you, partner."
  say [default] as default:
    "Got it."

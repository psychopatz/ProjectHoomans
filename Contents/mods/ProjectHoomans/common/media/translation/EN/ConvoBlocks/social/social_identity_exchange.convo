# Actor-agnostic identity exchange flow & proactive ask-name beat.
language EN
namespace hoomans

dialogue semantic.question.identity
  say [default] as ask_first:
    "Who's asking? Tell me your name first, and maybe I'll tell you mine."
  say [relationship.tier=wary] as ask_first_guarded:
    "Names don't come free out here. Tell me yours first—who am I talking to?"
  say [actor.social_style=friendly] as ask_first_warm:
    "Fair question—how about you go first? What's your name?"
  say [relationship.identity_trust=untrustworthy] as untrustworthy_ask_first:
    "I don't share my name with liars. What's yours, truthfully?"

  choice identity.choice.real_name:
    label: "Say your real name"
    say: "I'm {speaker.name}."
    utility: openness
    intent: INFORM
    subject: IDENTITY
    claim: canonical

  choice identity.choice.refuse_name:
    label: "Don't tell your name"
    say: "Better if we keep names out of it for now."
    utility: caution
    intent: REFUSE
    subject: IDENTITY
    style: rude

  choice identity.choice.lie_name:
    label: "Lie about your name"
    say: "You can call me {speaker.alias}. {clause.wary_tail}"
    utility: deception
    intent: INFORM
    subject: IDENTITY
    claim: generated

dialogue semantic.social.identity.ask_name_proactive
  say [role=ask_name_after_assist, actor.style=supportive] as after_assist_warm:
    "Wait—I didn't even catch your name. Who do I owe a favor to?"
  say [role=ask_name_after_assist, relationship.tier=wary] as after_assist_wary:
    "Before we split up... what do people call you?"
  say [role=ask_name_after_assist] as after_assist_general:
    "{opener.casual|cap}, I never caught your name. Who am I thanking here?"

  # Autonomous colonist responses (actor-agnostic compositional lines)
  say [role=colonist_answer_real_name] as colonist_real_name:
    "Name's {claimed.name}. Good fighting beside you."
  say [role=colonist_answer_lie_name] as colonist_lie_name:
    "You can call me {claimed.name}. {clause.wary_tail}"
  say [role=colonist_answer_refuse_name] as colonist_refuse_name:
    "Better if we keep names out of it for now. {clause.stay_sharp}"

  # Asker reactions to colonist response
  say [role=ask_name_react_real_name] as react_real_name:
    "Good to know, {claimed.name}. I'm {speaker.name}."
  say [role=ask_name_react_lie_name] as react_lie_name:
    "Alright, {claimed.name}. Fair enough—I'm {speaker.name}."
  say [role=ask_name_react_refuse_name] as react_refuse_name:
    "Fair enough, can't blame you for being careful these days."

  # Autonomous NPC-to-NPC stranger introduction (3-stance self-driven exchange)
  say [role=ask_name_meet_stranger, actor.social_style=warm|friendly|protective] as meet_stranger_warm:
    "Hey there—I don't think we've met. I'm {speaker.name}. What do people call you?"
    "Nice to see another friendly face out here. Name's {speaker.name}—and you are?"
  say [role=ask_name_meet_stranger, actor.social_style=hostile|guarded|withdrawn] as meet_stranger_guarded:
    "Hold up, stranger. Don't recognize you—what's your name?"
    "You're not from our crew. I'm {speaker.name}—who are you?"
  say [role=ask_name_meet_stranger] as meet_stranger_default:
    "Hey, don't think I caught your name before. I'm {speaker.name}."
    "Looks like we're sharing the same road—I'm {speaker.name}. What's your name?"

  say [role=answer_meet_real_name, actor.social_style=warm|friendly|protective] as answer_meet_warm:
    "Good to meet you, {addressee.name}—I'm {claimed.name}. Always glad to meet someone still alive."
    "I'm {claimed.name}. Nice meeting you, {addressee.name}—stay safe out here."
  say [role=answer_meet_real_name] as answer_meet_real_default:
    "Name's {claimed.name}. Good to meet you, {addressee.name}."
    "Call me {claimed.name}. Glad you're not one of the dead, {addressee.name}."

  say [role=answer_meet_cautious] as answer_meet_cautious_default:
    "You can call me {claimed.name}. Just passing through, same as everyone else."
    "{claimed.name}. That's all you need to know for now."

  say [role=answer_meet_refuse] as answer_meet_refuse_default:
    "Nothing personal, I don't hand out my name to people I just met."
    "Let's keep names out of it for now. Easier that way."

  say [role=react_meet_real_name, actor.social_style=warm|friendly|protective] as react_meet_warm:
    "Alright, {claimed.name}—good to put a name to a face. Watch your back out there."
    "Pleasure, {claimed.name}. Stick close if things get loud."
  say [role=react_meet_real_name] as react_meet_default:
    "Got it, {claimed.name}. Good to know who's standing next to me."
    "Alright, {claimed.name}. Keep your head on a swivel."

  say [role=react_meet_refuse] as react_meet_refuse_default:
    "Fair enough—smart to be careful these days."
    "Suit yourself. Just don't get in my line of fire."

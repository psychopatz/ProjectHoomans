# Subject: SLEEP (self-contained lexicons, suggestions, acknowledgments, requests).
language EN
namespace hoomans

lexicon sleep.observe
  [actor.social_style=warm|friendly|protective]: "You're barely keeping your eyes open" | "You look like you're about to drop" | "You're swaying on your feet"
  [actor.social_style=hostile|guarded|withdrawn]: "You're nodding off" | "You're half-asleep out here" | "You're dragging"
  [default]: "You look dead tired" | "You're running on empty" | "You look beat"

lexicon sleep.suggest
  [environment.night_or_dusk]: "Let's hole up and get some shut-eye before it gets any darker." | "We need to barricade somewhere and sleep."
  [place.in_settlement]: "Go hit a bunk—I'll hold things down here." | "Head to a bed and get some rest."
  [actor.social_style=hostile|guarded|withdrawn]: "Find a bed before you walk into a bite." | "Crash somewhere safe before you get us killed."
  [default]: "We should find a safe spot to sleep." | "Let's find somewhere to get some sleep." | "You need to get some shut-eye."

lexicon sleep.risk
  [actor.social_style=hostile|guarded|withdrawn]: "I'm not carrying you if you pass out." | "One slip and we're both dead."
  [environment.night_or_dusk]: "Not safe being half-asleep in {noun.dark}." | "Hard enough spotting {noun.zombie|s} when you're wide awake."

lexicon sleep.ack
  [actor.social_style=warm|friendly|protective]: "Rest easy—I'll keep watch while you sleep." | "Get some shut-eye. I've got the door covered."
  [actor.social_style=hostile|guarded|withdrawn]: "Get your sleep. I'll wake you if anything moves." | "Fine. Sleep quick—I'm watching the perimeter."
  [default]: "I'll stand guard while you get some rest." | "Go ahead and sleep. I'll keep an eye out."

lexicon sleep.request_need
  [actor.social_style=warm|friendly|protective]: "I'm barely keeping my eyes open" | "I'm completely worn out" | "My eyes are burning"
  [actor.social_style=hostile|guarded|withdrawn]: "I'm running on fumes" | "I'm about to drop" | "I need rack time"
  [default]: "I'm dead tired" | "I'm wiped out" | "I can barely stay upright"

lexicon sleep.request_ask
  [environment.night_or_dusk]: "Can we hole up and get some sleep before morning?" | "Think we can find a safe spot to crash for the night?"
  [default]: "Mind if I get some sleep for a bit?" | "Can we stop somewhere safe so I can crash?"

extend semantic.companion.moodle_suggest
  say [role=suggest_sleep, need.urgency=critical] as suggest_sleep_critical:
    "{term.address}, you're practically sleepwalking—we have to find a bed right now before you pass out!"
    "Hey {term.address}, your eyes are closing on you! Stop and get some sleep immediately!"
  say [role=suggest_sleep, need.urgency=medium, environment.night_or_dusk] as suggest_sleep_medium_night:
    "{opener.casual}, {term.address}—{sleep.observe}. {sleep.suggest} {?sleep.risk}"
  say [role=suggest_sleep, need.urgency=medium] as suggest_sleep_medium:
    "{sleep.observe}, {term.address}. {sleep.suggest} {?sleep.risk}"
  say [role=suggest_sleep, need.urgency=light] as suggest_sleep_light:
    "Looking a little drowsy, {term.address}. Might want to turn in soon when we find a safe spot."
  say [role=suggest_sleep, environment.night_or_dusk] as suggest_sleep_night:
    "{opener.casual}, {term.address}—{sleep.observe}. {sleep.suggest} {?sleep.risk}"
  say [role=suggest_sleep, place.in_settlement] as suggest_sleep_settlement:
    "{sleep.observe}, {term.address}. {sleep.suggest}"
  say [role=suggest_sleep] as suggest_sleep_composed_a:
    "{sleep.observe}, {term.address}. {sleep.suggest} {?sleep.risk}"
    "{opener.casual} {term.address}, {sleep.observe}. {sleep.suggest}"
  say [role=ack_sleep] as ack_sleep_composed:
    "{sleep.ack}"

extend semantic.companion.need_request
  say [role=request_sleep, need.urgency=critical] as req_sleep_critical:
    "{term.address}, I'm about to pass out on my feet—I can't keep my eyes open! I need to sleep right now!"
    "I'm seeing double from exhaustion, {term.address}—please, we have to stop so I can sleep!"
  say [role=request_sleep, need.urgency=medium, environment.night_or_dusk] as req_sleep_medium_night:
    "{term.address}, {sleep.request_need}. {sleep.request_ask}"
  say [role=request_sleep, need.urgency=medium] as req_sleep_medium:
    "{opener.casual} {term.address}, {sleep.request_need}. {sleep.request_ask}"
  say [role=request_sleep, need.urgency=light] as req_sleep_light:
    "Hey {term.address}, starting to get sleepy. Think we can find somewhere to rest before long?"
  say [role=request_sleep, environment.night_or_dusk] as req_sleep_night:
    "{term.address}, {sleep.request_need}. {sleep.request_ask}"
  say [role=request_sleep] as req_sleep_composed_a:
    "{opener.casual} {term.address}, {sleep.request_need}. {sleep.request_ask}"
    "{sleep.request_need}, {term.address}. {sleep.request_ask}"

  say [role=self_sleep, need.urgency=critical] as self_sleep_critical:
    "My eyes won't stay open... I'm so tired I'm about to drop where I stand..."
    "Everything's blurring together... I can't stay awake much longer..."
  say [role=self_sleep, need.urgency=medium] as self_sleep_medium:
    "Man, I'm wiped out... really need to find a bunk and get some shut-eye soon."
    "Running on fumes here—could really use a few hours of sleep."
  say [role=self_sleep, need.urgency=light] as self_sleep_light:
    "Starting to feel a bit drowsy... could use some sleep before too long."
  say [role=self_sleep] as self_sleep_default:
    "Could really use some sleep soon."

  say [role=reassure_sleep, need.urgency=critical, actor.social_style=warm|friendly|protective] as reassure_sleep_critical_warm:
    "Hang in there, {addressee.name}—we'll find a safe spot for you to crash, I'll keep watch."
  say [role=reassure_sleep, need.urgency=critical, actor.social_style=hostile|guarded|withdrawn] as reassure_sleep_critical_guarded:
    "Stay awake a little longer, {addressee.name}—we'll hole up soon and you can get some shut-eye."
  say [role=reassure_sleep, need.urgency=critical] as reassure_sleep_critical:
    "Hang in there, {addressee.name}—we'll get you somewhere safe to sleep soon."
  say [role=reassure_sleep, need.urgency=medium] as reassure_sleep_medium:
    "Hold on a bit longer, {addressee.name}—we'll turn in as soon as we're somewhere safe."
  say [role=reassure_sleep, need.urgency=light] as reassure_sleep_light:
    "We'll get some rest once things settle down, {addressee.name}."
  say [role=reassure_sleep] as reassure_sleep_default:
    "Hang in there, {addressee.name}—we'll get you some sleep soon."

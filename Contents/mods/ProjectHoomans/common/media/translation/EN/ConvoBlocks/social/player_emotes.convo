# Subject: PLAYER EMOTE SPEECH LINES.
language EN
namespace hoomans

dialogue semantic.emote.player
  say [action=insult] as insult:
    "Back off, {addressee.name}!"
  say [action=thumbsdown] as thumbsdown:
    "No. That's not good enough, {addressee.name}."
  say [action=wavehi] as wavehi:
    "Hey, {addressee.name}!"
  say [action=wavebye] as wavebye:
    "Take care, {addressee.name}."
  say [action=thankyou] as thankyou:
    "Thanks, {addressee.name}."
  say [action=thumbsup] as thumbsup:
    "Good work, {addressee.name}."
  say [action=clap] as clap:
    "Well done, {addressee.name}!"
  say [action=salute] as salute:
    "Respect, {addressee.name}."
  say [action=surrender] as surrender:
    "Hands up, {addressee.name}! Don't shoot!"

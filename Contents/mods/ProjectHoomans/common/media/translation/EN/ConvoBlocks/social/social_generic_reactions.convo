# Subject: GENERIC COMPANION, SOCIAL, SAFETY & CORPSE REACTIONS.
language EN
namespace hoomans

dialogue semantic.companion.reaction
  choice companion.who_chased:
    label: "Who was chasing you?"
    say: "Who was chasing you?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_PURSUER
  say [command.id=camp, event.type=companion_command_rejection] as camp_rejected:
    "I can't find a safe room or campfire nearby."
  say [event.type=follower_abandoned_zombie|follower_abandoned_hostile_npc] as abandonment:
    "Stay with me next time. We watch each other's backs."
  say [default] as default:
    "I heard you. We will handle it together."

dialogue semantic.social.reaction
  say [default] as default:
    "I hear you."

dialogue semantic.conversation.safety
  say [event.type=conversation_safety] as danger:
    "Watch out. We need to move now."
  say [default] as default:
    "Stay alert."

dialogue semantic.corpse.reaction
  say [corpse.revenge] as revenge:
    "Someone is going to answer for this."
  say [default] as default:
    "Someone died here. We should remember that."

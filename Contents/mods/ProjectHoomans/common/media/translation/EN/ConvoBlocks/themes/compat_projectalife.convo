# Mod Compatibility: Project A-Life.
language EN
namespace hoomans

flow semantic.compat.projectalife.meta
  say [alife.kind=gunfire] (priority 9) as gunfire:
    "Someone is shooting nearby. Keep your head down."
  say [alife.kind=heli] (priority 9) as aircraft:
    "Something is flying over us. Keep listening."
  say [alife.kind=military] (priority 9) as military:
    "That aircraft sounds close. Stay sharp."
  say [alife.kind=crash] (priority 9) as crash:
    "That crash sounded close. Keep your eyes open."
  say [alife.kind=ambience] (priority 9) as ambience:
    "I do not like that sound. Stay close."

flow semantic.compat.projectalife.encounter
  say [alife.stance=friendly] (priority 9) as friendly:
    "Those survivors seem friendly. Keep your hands visible."
  say [alife.stance=hostile|careful] (priority 9) as hostile:
    "That group looks hostile. Keep cover between us and them."
  say [alife.stance=unknown|neutral] (priority 6) as unknown:
    "Someone is out there. Let us watch before we approach."

flow semantic.compat.projectalife.faction
  say [event.type=projectalife_faction_stance, alife.stance=hostile|careful] (priority 9) as hostile:
    "That faction may be hostile toward us now. Stay alert."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=incoming] (priority 9) as incoming:
    "They just opened fire on us. Stay close."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=outgoing] (priority 9) as outgoing:
    "We hit them. They may retaliate soon."

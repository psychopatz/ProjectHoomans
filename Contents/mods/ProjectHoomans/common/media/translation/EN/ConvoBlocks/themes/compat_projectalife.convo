# Mod Compatibility: Project A-Life.
language EN
namespace hoomans

dialogue semantic.compat.projectalife.meta
  say [alife.kind=gunfire] as gunfire:
    "Someone is shooting nearby. Keep your head down."
  say [alife.kind=heli] as aircraft:
    "Something is flying over us. Keep listening."
  say [alife.kind=military] as military:
    "That aircraft sounds close. Stay sharp."
  say [alife.kind=crash] as crash:
    "That crash sounded close. Keep your eyes open."
  say [alife.kind=ambience] as ambience:
    "I do not like that sound. Stay close."

dialogue semantic.compat.projectalife.encounter
  say [alife.stance=friendly] as friendly:
    "Those survivors seem friendly. Keep your hands visible."
  say [alife.stance=hostile|careful] as hostile:
    "That group looks hostile. Keep cover between us and them."
  say [alife.stance=unknown|neutral] as unknown:
    "Someone is out there. Let us watch before we approach."

dialogue semantic.compat.projectalife.faction
  say [event.type=projectalife_faction_stance, alife.stance=hostile|careful] as hostile:
    "That faction may be hostile toward us now. Stay alert."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=incoming] as incoming:
    "They just opened fire on us. Stay close."
  say [event.type=projectalife_faction_conflict, alife.conflict_direction=outgoing] as outgoing:
    "We hit them. They may retaliate soon."

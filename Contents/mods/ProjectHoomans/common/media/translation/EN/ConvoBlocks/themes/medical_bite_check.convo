# Subject: MEDICAL BITE CHECK Q&A.
language EN
namespace hoomans

dialogue semantic.question.medical_bite.positive
  say [default] as default:
    "Yes, I've been bitten."

dialogue semantic.question.medical_bite.negative
  say [default] as default:
    "No, I don't have a recorded bite."

dialogue semantic.question.medical_bite.unknown
  say [default] as default:
    "I can't confirm whether I've been bitten."

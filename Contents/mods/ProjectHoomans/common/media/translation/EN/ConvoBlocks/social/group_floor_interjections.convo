# Multi-party ("V" group talk & NPC-to-NPC) shared-floor interjections.
language EN
namespace hoomans

flow group.interjection
  say [floor.interjection_kind=calm_down, floor.speaker_annoyed] (priority 12) as calm_down:
    "Easy, {floor.speaker_name}—take a breath, no need to snap."
  say [floor.interjection_kind=back_up, floor.side_with_speaker] (priority 11) as back_up:
    "I'm with {floor.speaker_name} on this—give us a second."
  say [floor.interjection_kind=concern, floor.speaker_injured] (priority 11) as concern_injured:
    "Hey, {floor.speaker_name}, you look rough—let's get you patched up first."
  say [floor.interjection_kind=concern] (priority 10) as concern_general:
    "Hang in there, {floor.speaker_name}—we've got your back."
  say [floor.interjection_kind=disagree, !floor.side_with_speaker] (priority 10) as disagree:
    "Speak for yourself, {floor.speaker_name}."
  say [floor.interjection_kind=chime_in, group.broadcast] (priority 9) as chime_in_broadcast:
    "Count me in too—right behind {floor.speaker_name}{end}"
  say [floor.interjection_kind=chime_in] (priority 8) as chime_in:
    "Yeah, what {floor.speaker_name} said{end}"
  say [default] (priority 5) as fallback:
    "I hear you, {floor.speaker_name}{end}"

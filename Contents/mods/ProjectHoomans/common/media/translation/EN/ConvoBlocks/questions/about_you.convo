# Subject: ABOUT YOU / PERSONAL BACKGROUND Q&A.
language EN
namespace hoomans

dialogue semantic.question.about_you
  say [actor.social_style=friendly|protective] as warm:
    "Sure thing — what do you want to know about me?"
  say [actor.social_style=withdrawn|guarded|hostile] as guarded:
    "Depends on what you're asking. What about me?"
  say [default] as neutral:
    "What do you want to know about me?"

dialogue semantic.question.about_you.gated
  say [topic=faction, actor.social_style=withdrawn|guarded|hostile] as faction_guarded:
    "I don't hand out who I run with to someone I barely know."
  say [topic=faction] as faction_neutral:
    "We haven't known each other long enough for me to get into who I'm with."
  say [topic=surname, actor.social_style=withdrawn|guarded|hostile] as surname_guarded:
    "First name's enough for now. We're not that close."
  say [topic=surname] as surname_neutral:
    "Let's stick to first names until we know each other a bit better."
  say [actor.social_style=withdrawn|guarded|hostile] as personal_guarded:
    "That's personal. We're not there yet."
  say [default] as personal_neutral:
    "I'm not ready to get into that yet — maybe once we know each other better."

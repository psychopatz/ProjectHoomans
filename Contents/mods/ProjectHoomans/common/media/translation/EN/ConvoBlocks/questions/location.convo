# Subject: CURRENT LOCATION Q&A.
language EN
namespace hoomans

flow semantic.question.current_location
  say [npc.annoyed] (priority 11) as annoyed:
    "We're {location.phrase}. Keep your bearings."
  say [mood.panicked] (priority 11) as panicked:
    "We're {location.phrase}—just keep moving and stay sharp!"
  say [relationship.bond=lover|spouse] (priority 10) as lover:
    "We're {location.phrase}, {?term.address}. Stick close to me."
  say [actor.role=trader] (priority 9) as trader:
    "We're {location.phrase}. Good landmark to keep on your map."
  say [actor.role=looter|bandit] (priority 9) as bandit_looter:
    "You're {location.phrase}. Why do you care?"
  say [default] (priority 6) as default:
    "We're {location.phrase}."
    "Looks like we're {location.phrase}."
    "Right now we're {location.phrase}."

flow semantic.question.current_location.local
  say [relationship.bond=lover|spouse] (priority 10) as lover:
    "I grew up around here, {?term.address}—we're {location.phrase}."
  say [actor.role=trader] (priority 9) as trader:
    "Home turf for me—we're {location.phrase}."
  say [default] (priority 6) as default:
    "I know this area well—we're {location.phrase}."
    "I grew up around here. We're {location.phrase}."
    "Familiar ground—we're {location.phrase}."

flow semantic.question.current_location.unfamiliar_room
  say [default] (priority 6) as default:
    "We're {location.immediate}, though I'm not really familiar with this town."
    "Looks like we're {location.immediate}, but I don't know this area well."

flow semantic.question.current_location.unfamiliar
  say [default] (priority 6) as default:
    "Honestly, I'm not from around here—I don't really know this area."
    "Couldn't tell you for sure. I'm not familiar with this town."

flow semantic.question.current_location.unknown
  say [default] (priority 6) as default:
    "Honestly, I'm not completely sure where we are right now."
    "Hard to tell from here—everything out here starts looking the same."

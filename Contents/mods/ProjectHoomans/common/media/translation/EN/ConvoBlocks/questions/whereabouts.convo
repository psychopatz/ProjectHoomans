# Subject: COMMUNITY ROLE WHEREABOUTS.
language EN
namespace hoomans

dialogue semantic.question.community_role_whereabouts.unknown
  say [default] as default:
    "I don't know where our {role} is."

dialogue semantic.question.community_role_whereabouts.home
  say [default] as default:
    "Our {role} is here."

dialogue semantic.question.community_role_whereabouts.preparing
  say [default] as default:
    "Our {role} is preparing to leave."

dialogue semantic.question.community_role_whereabouts.away
  say [default] as default:
    "Our {role} is away right now."

dialogue semantic.question.community_role_whereabouts.returning
  say [default] as default:
    "Our {role} is on the way home."

dialogue semantic.question.community_role_whereabouts.visiting
  say [default] as default:
    "Our {role} is at {destination}, {direction} of here."

dialogue semantic.question.community_role_whereabouts.visiting_eta
  say [default] as default:
    "Our {role} is at {destination}, {direction} of here. They should be back {eta}."

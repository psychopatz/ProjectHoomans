    "That's kind of you. I appreciate it."
  say [topic=compliment_dataset_means_a_lot] as compliment_dataset_means_a_lot:
    "Aw, thank you. That means a lot."

dialogue flow.weather.raining
  say [topic=flow_weather_raining_dataset_contextual_switch] as flow_weather_raining_dataset_contextual_switch:
    "It is raining right now. We can return to that proposal when you are ready."

dialogue greeting
  say [topic=greeting_dataset_holding_up] as greeting_dataset_holding_up:

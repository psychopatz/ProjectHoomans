# ConvoDSL dialogue pools.
language EN
namespace hoomans

dialogue integration.bandits.hooman_hurt
  say [topic=colonist] as colonist:
    "Bandit fire! Pull back and cover the wounded colonist."
  say [default] as default:
    "Bandit fire! Stay with the wounded survivor and watch the flank."
  say [topic=family] as family:
    "Bandit fire! Stay together and cover the wounded family member."
  say [topic=lover] as lover:
    "Bandit fire. Stay close; I have got you."

dialogue integration.companion_dogs.feed
  say [topic=female] as female:
    "Here you go, good girl."
  say [topic=male] as male:
    "Here you go, good boy."
  say [topic=unknown] as unknown:
    "Here you go, good dog."

dialogue integration.companion_dogs.greeting
  say [topic=female] as female:
    "Who is a good girl?"
  say [topic=male] as male:
    "Who is a good boy?"
  say [topic=unknown] as unknown:
    "Who is a good dog?"

dialogue integration.necroa.mask_warning
  say [topic=colonist] as colonist:
    "Mask up. We keep the camp safe together."
  say [default] as default:
    "Put your mask back on. Knox is airborne."
  say [topic=family] as family:
    "Put your mask on, family. I am not losing you to the air."

dialogue integration.necroa.player_mask_removed
  say [default] as default:
    "Put your mask back on. The air is not safe."
  say [topic=hostile] as hostile:
    "Put your mask back on before you become a problem."
  say [topic=lover] as lover:
    "Please put your mask back on, love. This air is not safe."

dialogue integration.projectalife.encounter
  say [topic=friendly] as friendly:
    "Those survivors seem friendly. Keep your hands visible."
  say [topic=hostile] as hostile:
    "That group looks hostile. Keep cover between us and them."
  say [topic=unknown] as unknown:
    "Someone is out there. Let us watch before we approach."

dialogue integration.projectalife.faction
  say [topic=hostile] as hostile:
    "That faction may be hostile toward us now. Stay alert."
  say [topic=incoming] as incoming:
    "They just opened fire on us. Stay close."
  say [topic=outgoing] as outgoing:
    "We hit them. They may retaliate soon."

dialogue integration.projectalife.meta
  say [topic=aircraft_heli] as aircraft_heli:
    "Something is flying over us. Keep listening."
  say [topic=aircraft_military] as aircraft_military:
    "That aircraft sounds close. Stay sharp."
  say [topic=ambience] as ambience:
    "I do not like that sound. Stay close."
  say [topic=crash] as crash:
    "That crash sounded close. Keep your eyes open."
  say [topic=gunfire] as gunfire:
    "Someone is shooting nearby. Keep your head down."

dialogue conversation.context.replies
  say [default] as neutral:
    "I don't know why that is; I only know what I can confirm."

dialogue flow.greeting.exchange
  say [default] as default:
    "Hello."

dialogue flow.greeting.exchange.friendly
  say [default] as default:
    "Good to see you."

dialogue flow.greeting.exchange.hostile
  say [default] as default:
    "Stay back."

dialogue flow.greeting.followup
  say [topic=friendly] as friendly:
    "You're welcome. It's good to see you too."
  say [default] as default:
    "You're welcome. Take care."

dialogue flow.greeting.opening
  say [default] as default:
    "Hey there. Good to see you."
  say [topic=default_guarded] as default_guarded:
    "State your business. Keep your distance."
  say [topic=default_terse] as default_terse:
    "Hello."
  say [topic=default_warm] as default_warm:
    "Hey! It is good to see you."
  say [topic=friendly] as friendly:
    "Good to see you."
  say [topic=friendly_guarded] as friendly_guarded:
    "Hey. Everything holding together?"
  say [topic=friendly_terse] as friendly_terse:
    "Back again? You holding up?"
  say [topic=friendly_warm] as friendly_warm:
    "There you are! Good to see you."
  say [topic=question_default] as question_default:
    "How have you been?"
  say [topic=question_friendly] as question_friendly:
    "How have you been holding up lately?"

dialogue flow.greeting.opening.rain
  say [default] as neutral:
    "Hey there. Wet one today."

dialogue flow.greeting.responses
  say [default] as neutral:
    "You're welcome. Take care."

dialogue question.whats_up.busy
  say [default] as neutral:
    "I'm keeping busy and trying to stay useful."
  say [topic=guarded] as guarded:
    "Keeping busy. Don't distract me."
  say [topic=terse] as terse:
    "Keeping busy."
  say [topic=warm] as warm:
    "I'm keeping busy and trying to stay useful. There's always something to do."

dialogue question.whats_up.default
  say [default] as neutral:
    "Not much. I'm just trying to keep things together."
  say [topic=guarded] as guarded:
    "Nothing worth discussing. Stay alert."
  say [topic=terse] as terse:
    "Just getting by."
  say [topic=warm] as warm:
    "Not much. I'm just trying to keep things together. Good to see you, though."

dialogue question.whats_up.default_alt
  say [default] as neutral:
    "Same as ever. Staying alive and watching the road."
  say [topic=guarded] as guarded:
    "Staying alive. Keep your eyes open."
  say [topic=terse] as terse:
    "Staying alive."
  say [topic=warm] as warm:
    "Same as ever. Staying alive and watching the road. What about you?"

dialogue question.whats_up.traveling
  say [default] as neutral:
    "I'm keeping moving and watching what is ahead."
  say [topic=guarded] as guarded:
    "Keeping moving. Don't slow me down."
  say [topic=terse] as terse:
    "Keeping moving."
  say [topic=warm] as warm:
    "I'm keeping moving and watching what is ahead. Come along if you want."

dialogue question.whats_up.weather
  say [default] as neutral:
    "The weather is the main thing on my mind right now."
  say [topic=guarded] as guarded:
    "Watching the weather. Stay focused."
  say [topic=terse] as terse:
    "Watching the weather."
  say [topic=warm] as warm:
    "The weather is the main thing on my mind right now. How are you holding up?"

dialogue question.knowledge_and_bite.responses
  say [default] as neutral:
    "I know about %s."

dialogue accept
  say [topic=accept_dataset_pending_started] as accept_dataset_pending_started:
    "Okay, I'll get started."
  say [topic=accept_dataset_pending_care] as accept_dataset_pending_care:
    "All right. I can take care of that."

dialogue compliment

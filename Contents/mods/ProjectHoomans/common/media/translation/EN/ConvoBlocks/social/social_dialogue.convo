dialogue medical.distress
  say [default] as default:
    "I need help with this wound."
  say [topic=mercy] as mercy:
    "Please. I need help with this wound, don't let me die."
  say [topic=urgent] as urgent:
    "I am hurt! I need help now!"

dialogue medical.distress.call
  say [topic=bandage] as bandage:
    "I'm hurt and down! Need a bandage over here!"
  say [topic=bleedout] as bleedout:
    "I'm bleeding out! I need a tourniquet or bandage now!"
  say [default] as default:
    "I'm down! I need help over here!"
  say [topic=dehydration] as dehydration:
    "So thirsty... I need water before I pass out."
  say [topic=exhaustion] as exhaustion:
    "Pushed too far. I can't lift my arms."
  say [topic=mercy] as mercy:
    "I'm down! Please, don't kill me!"
  say [topic=rescue] as rescue:
    "I'm trapped here! I need help over here!"
  say [topic=starvation] as starvation:
    "Haven't eaten in days... I'm starving to death."

dialogue medical.distress.repeat
  say [topic=bandage] as bandage:
    "I still need these wounds patched! Hurry!"
  say [topic=bleedout] as bleedout:
    "I am still losing blood! Please, help me!"
  say [default] as default:
    "I'm not up yet. Please help me."
  say [topic=dehydration] as dehydration:
    "I still need water to recover. My throat is on fire."
  say [topic=exhaustion] as exhaustion:
    "I still need a little more time to recover."
  say [topic=mercy] as mercy:
    "I am still asking you to spare me. Please."
  say [topic=rescue] as rescue:
    "I am still down here! Do not leave me!"
  say [topic=starvation] as starvation:
    "I still need something to eat. I'm fading fast."

dialogue medical.distress.teammate
  say [default] as default:
    "They are hurt! Stay with them while I cover you."
  say [topic=found] as found:
    "I found a bandage for them. Hold still while I patch them up."
  say [topic=missing] as missing:
    "I am out of bandages! Can someone spare one for them?"

dialogue medical.distress.update
  say [topic=bandage] as bandage:
    "I am still down and waiting for a patch."
  say [topic=bleedout] as bleedout:
    "The bleeding has not stopped. I still need a bandage."
  say [default] as default:
    "I am still down. I still need help."
  say [topic=dehydration] as dehydration:
    "I still need water before I can move."
  say [topic=exhaustion] as exhaustion:
    "I still need time to recover my strength."
  say [topic=mercy] as mercy:
    "I am still down. Please do not finish me."
  say [topic=rescue] as rescue:
    "I am still here. Please come back for me."
  say [topic=starvation] as starvation:
    "I still need food before I can get up."

dialogue medical.distress.treatment
  say [topic=bandage] as bandage:
    "The wound is treated. I can move when you are ready."
  say [default] as default:
    "Thank you. That treatment helped."


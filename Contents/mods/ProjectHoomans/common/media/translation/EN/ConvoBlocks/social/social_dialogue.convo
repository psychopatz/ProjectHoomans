  say [topic=question_activity_dataset_bit_of_everything] as question_activity_dataset_bit_of_everything:
    "A little bit of everything."
  say [topic=question_activity_dataset_taking_care] as question_activity_dataset_taking_care:
    "Just taking care of what needs doing."

dialogue question.backstory.ambiguous
  say [topic=question_backstory_ambiguous_authored] as question_backstory_ambiguous_authored:
    "Which part of my past do you mean?"

dialogue question.backstory.follow_up.location
  say [topic=question_backstory_follow_up_location_authored] as question_backstory_follow_up_location_authored:
    "I remember that part of my life, but I don't have more detail about where it was."

dialogue question.backstory.follow_up.miss
  say [topic=question_backstory_follow_up_miss_authored] as question_backstory_follow_up_miss_authored:
    "Sometimes. I still think about that part of my life."

dialogue question.backstory.refusal
  say [topic=question_backstory_refusal_authored] as question_backstory_refusal_authored:
    "I'm not ready to talk about that yet."

dialogue question.backstory.suspected
  say [topic=question_backstory_suspected_authored] as question_backstory_suspected_authored:
    "I think it was %1, but I could be mistaken."

dialogue question.wellbeing
  say [topic=question_wellbeing_dataset_hanging_in] as question_wellbeing_dataset_hanging_in:
    "I'm hanging in there. Thanks for asking."
  say [topic=question_wellbeing_dataset_all_things_considered] as question_wellbeing_dataset_all_things_considered:
    "Doing okay, all things considered."
  say [topic=question_wellbeing_dataset_getting_by] as question_wellbeing_dataset_getting_by:
    "I'm getting by, one day at a time. How about you?"
  say [topic=question_wellbeing_dataset_hungry] as question_wellbeing_dataset_hungry:
    "I'm hungry, but I'll manage. If you have food to spare, I'd appreciate it."
  say [topic=question_wellbeing_dataset_thirsty] as question_wellbeing_dataset_thirsty:
    "I'm pretty thirsty. If you have water, could you spare some?"
  say [topic=question_wellbeing_dataset_tired] as question_wellbeing_dataset_tired:
    "I'm tired, though I can manage for now."

dialogue question.wellbeing.unknown
  say [topic=question_wellbeing_unknown_dataset_causal_followup] as question_wellbeing_unknown_dataset_causal_followup:
    "I can tell something is off, but I do not know what caused it yet."

dialogue refuse
  say [topic=refuse_dataset_pending_unavailable] as refuse_dataset_pending_unavailable:
    "I can't take that on right now."
  say [topic=refuse_dataset_pending_enough] as refuse_dataset_pending_enough:
    "Not this time. I have enough to manage."

dialogue response_pool.question.identity
  say [topic=question_identity_dataset_stranger_alt_1] as question_identity_dataset_stranger_alt_1:
    "I keep my name to myself until I know someone better. What should I call you?"
  say [topic=question_identity_dataset_stranger_alt_2] as question_identity_dataset_stranger_alt_2:
    "Let's get to know each other first. What do people call you?"
  say [topic=question_identity_dataset_wary_alt_1] as question_identity_dataset_wary_alt_1:
    "I don't trust you enough to share my name. Who are you, really?"
  say [topic=question_identity_dataset_wary_alt_2] as question_identity_dataset_wary_alt_2:
    "After that lie, I'm not telling you my name. Tell me the truth about yours."

dialogue thanks
  say [topic=thanks_dataset_no_problem] as thanks_dataset_no_problem:
    "No problem at all."
  say [topic=thanks_dataset_anytime] as thanks_dataset_anytime:
    "Anytime."
  say [topic=thanks_dataset_glady] as thanks_dataset_glady:
    "Glad I could help."

dialogue corpse.reaction.default
  say [default] as neutral:
    "Someone died here. We should remember that."

dialogue corpse.reaction.revenge
  say [default] as neutral:
    "Someone is going to answer for this."

dialogue social.farewell.depart
  say [default] as default:
    "Take care."
  say [topic=friendly] as friendly:
    "Take care, {addressee.name}. I will see you soon."
  say [topic=hostile] as hostile:
    "Get out of my sight."
  say [topic=wary] as wary:
    "Keep your distance out there."
  say [topic=colonist] as colonist:
    "Watch your perimeter out there, {addressee.name}."
  say [topic=friend] as friend:
    "Stay safe out there, {addressee.name}. Come back in one piece."
  say [topic=family] as family:
    "Be careful out there. You know how much you mean to me."
  say [topic=lover] as lover:
    "Come back to me safely, {addressee.name}. Please don't stay gone long."
  say [topic=player_default] as player_default:
    "Stay safe out there."
  say [topic=player_hostile] as player_hostile:
    "We're done talking."
  say [topic=player_wary] as player_wary:
    "I'm heading out. Stay sharp."
  say [topic=player_colonist] as player_colonist:
    "Keep holding the line, {addressee.name}. I'll check back soon."
  say [topic=player_friend] as player_friend:
    "Take care of yourself, {addressee.name}. Talk soon."
  say [topic=player_family] as player_family:
    "Be safe while I'm out, {addressee.name}. I'll be right back."
  say [topic=player_lover] as player_lover:
    "Stay safe for me. I'll come right back to you."


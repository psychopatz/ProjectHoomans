# Core English nouns, descriptors, openers, and persona address lexicons.
language EN
namespace hoomans

lexicon noun.zombie
  [actor.style=tactical]:   "hostile" | "infected" | "dead"
  [actor.style=shaken]:     "thing" | "dead" | "biter"
  [actor.style=aggressive]: "rotter" | "biter" | "walker"
  [default]:                        "walker" | "dead" | "biter"

lexicon noun.pack
  [actor.style=tactical]:   "cluster" | "pack" | "group"
  [default]:                        "pack" | "swarm" | "mob" | "bunch"

lexicon noun.group
  [actor.style=tactical]:   "squad" | "unit" | "team"
  [default]:                        "crew" | "group" | "folks" | "outfit"

lexicon noun.dark
  [default]: "the dark" | "nightfall" | "the shadows" | "this dim light"

lexicon noun.road
  [default]: "road" | "street" | "block" | "stretch"

lexicon adj.fight
  [actor.style=aggressive]: "brutal" | "bloody" | "vicious"
  [actor.style=shaken]:     "awful" | "ugly" | "terrifying"
  [default]:                        "rough" | "ugly" | "nasty" | "close"

lexicon adj.hit
  [default]: "rough" | "nasty" | "bad" | "heavy"

lexicon adv.fast
  [default]: "fast" | "quick" | "in a hurry" | "out of nowhere"

lexicon adv.barely
  [default]: "barely" | "just barely" | "by the skin of my teeth"

lexicon opener.relief
  [actor.style=shaken]:     "Christ" | "Thank God" | "Jesus"
  [actor.style=brave]:      "Whew" | "Hell" | "Alright"
  [actor.style=aggressive]: "Damn right" | "Hell yeah" | "About time"
  [actor.style=cold]:       "Good" | "Well" | "Alright"
  [default]:                        "Whew" | "Man" | "Hey"

lexicon opener.casual
  [default]: "Hey" | "Look" | "Listen" | "Alright"

lexicon opener.wary
  [default]: "Easy" | "Hold on" | "Look" | "Alright"

# Orthogonal persona-address & role-flavor lexicons
lexicon term.address
  [relationship.bond=lover|spouse]:   "love" | "babe" | "sweetheart" | "{addressee.name}"
  [relationship.bond=parent]:         "{rel.kin_title}" | "{addressee.name}"
  [relationship.bond=child]:          "kiddo" | "kid" | "{addressee.name}"
  [relationship.bond=sibling|family]: "{addressee.name}" | "fam"
  [actor.role=looter|bandit]: "pal" | "tough guy" | "stranger"
  [actor.role=trader]:        "traveler" | "friend" | "{addressee.name}"
  [actor.age_band=elder]:     "kiddo" | "youngster" | "{addressee.name}"
  [relationship.tier=ally|trusted]:    "partner" | "{addressee.name}"
  [default]:                          "{addressee.name}"

lexicon role.greeting_tail
  [actor.role=trader]:                "Looking to buy or sell?" | "Got fresh stock if you're trading."
  [actor.role=looter|bandit]:         "Make it quick. What do you want?" | "Keep your hands where I can see them."
  [actor.role=colonist, state.working]: "Busy {state.job} here at {place.name}." | "Just wrapping up {state.job}."
  [actor.role=colonist, state.sitting]: "Just catching a breather here." | "Taking the weight off my feet for a minute."
  [actor.role=colonist]:               "Everything holding steady around camp?" | "What do you need?"
  [actor.role=companion]:              "Right with you—what's the call?" | "Watching your back. Need something?"
  [actor.role=guard]:                  "Perimeter's quiet so far." | "Eyes are on the road. What's up?"
  [default]:                                   "What's on your mind?" | "Need something?"

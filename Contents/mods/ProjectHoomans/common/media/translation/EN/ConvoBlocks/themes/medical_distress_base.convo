# Subject: MEDICAL DISTRESS BASE POOL.
language EN
namespace hoomans

dialogue semantic.medical.distress
  say [downed.audience=hostile, downed.need=mercy] as mercy:
    "Please. I need help with this wound, don't let me die."
  say [downed.need=bleedout|rescue] as urgent:
    "I am hurt! I need help now!"
  say [default] as default:
    "I need help with this wound."

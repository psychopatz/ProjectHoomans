# Subject: MEDICAL DISTRESS BASE POOL.
language EN
namespace hoomans

flow semantic.medical.distress
  say [downed.audience=hostile, downed.need=mercy] (priority 10) as mercy:
    "Please. I need help with this wound, don't let me die."
  say [downed.need=bleedout|rescue] (priority 9) as urgent:
    "I am hurt! I need help now!"
  say [default] (priority 5) as default:
    "I need help with this wound."

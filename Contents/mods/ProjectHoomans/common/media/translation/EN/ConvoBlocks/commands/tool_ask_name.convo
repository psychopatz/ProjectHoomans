# Subject: TOOL REPLIES — ASK NAME.
language EN
namespace hoomans

dialogue semantic.tool_reply.ask_name.named
  say [default] as 1:
    "Understood."
    "Understood."
    "Understood."

dialogue semantic.tool_reply.ask_name.prompt
  say [default] as prompt:
    "I'll tell you my name once we've established some trust. What's your name?"

dialogue semantic.tool_reply.ask_name.rejected
  say [default] as 1:
    "Understood."
    "Understood."

dialogue semantic.tool_reply.ask_name.unnamed
  say [default] as 1:
    "Understood."
    "Understood."

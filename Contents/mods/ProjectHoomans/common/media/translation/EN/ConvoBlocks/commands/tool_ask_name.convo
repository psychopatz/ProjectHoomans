# Subject: TOOL ASK NAME REPLIES.
language EN
namespace hoomans

dialogue semantic.tool_reply.ask_name.named
  say [default] as 1:
    "I'm %1."
    "The name's %1."
    "You can call me %1."

dialogue semantic.tool_reply.ask_name.prompt
  say [default] as prompt:
    "I'll tell you my name once we've established some trust. What's your name?"

dialogue semantic.tool_reply.ask_name.rejected
  say [default] as 1:
    "I'm not giving you my name right now."
    "Let's keep names out of this for now."

dialogue semantic.tool_reply.ask_name.unnamed
  say [default] as 1:
    "I'd rather not say my name right now."
    "Just call me whatever works."

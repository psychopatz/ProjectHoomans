# Ambient immersion overhead beats: rain shelter arrival/departure,
# live world-event reactions (gunshots, screams, chopper, road stories),
# and player-proximity first-sight awareness.
language EN
namespace hoomans

beat semantic.ambient.rain_shelter.enter
  say [role=open] (priority 8) as open:
    "Glad we got under a roof before that downpour soaked us through."
    "Let's wait out this rain inside—no sense catching a chill out there."
  say [role=reply] (priority 8) as reply:
    "Good call. Better dry in here than trudging through mud."
    "Agreed. Let's catch our breath until it lets up."
  say [default] (priority 5) as default:
    "Good to be out of the rain for a bit."

beat semantic.ambient.rain_shelter.clear
  say [role=open] (priority 8) as open:
    "Rain's letting up. Let's get moving again."
    "Looks clear enough out there now—time to hit the road."
  say [role=reply] (priority 8) as reply:
    "Right behind you. Let's keep our eyes open."
    "About time. Let's go."
  say [default] (priority 5) as default:
    "Weather's clearing up—time to move."

beat semantic.ambient.chopper_shelter.enter
  say [role=open] (priority 8) as open:
    "Good—we're under a roof. Stay away from the windows till that chopper passes."
    "Made it inside just in time. Keep quiet and let those rotors pass overhead."
    "Out of sight in here. Let's hold tight until that helicopter moves on."
  say [role=reply] (priority 8) as reply:
    "Smart call. Better cramped in here than spotted out on the street."
    "Listening at the door—if anything bangs on it, we're ready."
  say [default] (priority 5) as default:
    "Hunkering down inside until that chopper leaves."

beat semantic.ambient.chopper_shelter.clear
  say [role=open] (priority 8) as open:
    "Chopper's gone. Let's ease back outside and watch for stragglers."
    "Sounds quiet overhead now—time to move, weapons ready."
  say [role=reply] (priority 8) as reply:
    "Right behind you. Keep an eye on the corners."
    "Let's go—don't want to get trapped in here either."
  say [default] (priority 5) as default:
    "Chopper passed—heading back out carefully."

beat semantic.ambient.world_event.react
  say [topic=meta_gunshot, role=open] (priority 10) as gunshot_open:
    "Hold up—did you hear those shots?"
  say [topic=meta_gunshot, role=reply] (priority 10) as gunshot_reply:
    "Yeah, not far off either. Stay sharp."
  say [topic=meta_scream, role=open] (priority 10) as scream_open:
    "That scream… somebody's in real trouble over there."
  say [topic=meta_scream, role=reply] (priority 10) as scream_reply:
    "Nothing we can do if they're already surrounded. Keep moving."
  say [topic=helicopter_event, role=open] (priority 10) as chopper_open:
    "Chopper overhead! That noise is going to drag every dead one this way."
  say [topic=helicopter_event, role=reply] (priority 10) as chopper_reply:
    "Keep low and get near cover—don't get caught in the open."
  say [topic=medical_wreck, role=open] (priority 9) as med_open:
    "Crashed ambulance… might still be supplies inside if it's clear."
  say [topic=police_blockade, role=open] (priority 9) as police_open:
    "Police blockade ahead. Looks like things fell apart fast here."
  say [topic=bandit_activity, role=open] (priority 9) as bandit_open:
    "Looks like an ambush site. Keep your weapon ready."
  say [role=reply] (priority 6) as reply_default:
    "I see it. Let's stay alert."
  say [default] (priority 5) as default:
    "Something's going on nearby—stay sharp."

beat semantic.ambient.player_sight
  say [topic=armed, actor.social_style=guarded|withdrawn|hostile] (priority 11) as armed_guarded:
    "Easy there—keep that weapon pointed somewhere else."
  say [topic=armed] (priority 10) as armed_default:
    "Whoa, easy with that weapon. We're not looking for trouble."
  say [topic=reunion, actor.social_style=friendly|protective] (priority 11) as reunion_warm:
    "Hey, {addressee.name}! Good to see you're still in one piece."
  say [topic=reunion] (priority 10) as reunion_default:
    "Hey, {addressee.name}. Crossing paths again."
  say [topic=unarmed, actor.social_style=friendly|protective] (priority 9) as unarmed_friendly:
    "Hey there—roads been quiet your way?"
  say [topic=unarmed, actor.social_style=guarded|withdrawn] (priority 9) as unarmed_guarded:
    "Keep your distance and we'll get along fine."
  say [default] (priority 5) as default:
    "Stay safe out there."

# Subject: GROUP BANTER — POST_SURVIVOR_RADIO.
language EN
namespace hoomans

extend semantic.banter.group
  say [topic=post_survivor_radio, role=open] (priority 12) as post_surv_open:
    "Still wondering about those folks we heard on {slot.broadcast.channel}, {addressee.name}."
  say [topic=post_survivor_radio, role=reply] (priority 12) as post_surv_reply:
    "Me too, {addressee.name}. Hope whoever sent {slot.broadcast.topic} made it somewhere safe."
  say [topic=post_survivor_radio, role=chime] (priority 12) as post_surv_chime:
    "Good reminder we're not the last ones left out here."
  say [topic=post_survivor_radio, role=wrap] (priority 12) as post_surv_wrap:
    "Keep the radio handy, never know who else might call in."

# Subject: FAREWELL DEPARTURE.
language EN
namespace hoomans

dialogue semantic.social.farewell.depart
  say [social.farewell_speaker=player, social.role=hostile] as player_hostile:
    "We're done talking."
  say [social.farewell_speaker=player, social.role=wary] as player_wary:
    "I'm heading out. Stay sharp."
  say [social.farewell_speaker=player, social.role=lover] as player_lover:
    "Stay safe for me. I'll come right back to you."
  say [social.farewell_speaker=player, social.role=family] as player_family:
    "Be safe while I'm out, {addressee.name}. I'll be right back."
  say [social.farewell_speaker=player, social.role=friend] as player_friend:
    "Take care of yourself, {addressee.name}. Talk soon."
  say [social.farewell_speaker=player, social.role=colonist] as player_colonist:
    "Keep holding the line, {addressee.name}. I'll check back soon."
  say [social.farewell_speaker=player] as player_default:
    "Stay safe out there."
  say [social.role=hostile] as hostile:
    "Get out of my sight."
  say [social.role=wary] as wary:
    "Keep your distance out there."
  say [social.role=lover] as lover:
    "Come back to me safely, {addressee.name}. Please don't stay gone long."
  say [social.role=family] as family:
    "Be careful out there. You know how much you mean to me."
  say [social.role=friend] as friend:
    "Stay safe out there, {addressee.name}. Come back in one piece."
  say [social.role=colonist] as colonist:
    "Watch your perimeter out there, {addressee.name}."
  say [actor.social_style=friendly|protective] as friendly:
    "Take care, {addressee.name}. I will see you soon."
  say [default] as default:
    "Take care."

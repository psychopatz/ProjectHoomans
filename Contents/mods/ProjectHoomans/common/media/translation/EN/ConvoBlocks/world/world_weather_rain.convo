# Subject: RAIN & STORM ONSET BEATS.
language EN
namespace hoomans

dialogue semantic.world.weather.rain
  say [role=weather_rain_open] as weather_rain_open:
    "Rain's picking up, {addressee.name}. {?clause.rain_note}"
    "Great, it's coming down now, {addressee.name}. Let's not linger out in the open."
  say [role=weather_rain_reply] as weather_rain_reply:
    "Yeah, {addressee.name}, let's keep dry and watch our footing."
    "Agreed—visibility drops fast in this rain, stay sharp."
  say [role=weather_rain_chime] as weather_rain_chime:
    "At least it masks our footsteps—just stay close so we don't lose sight of each other."
    "Keep your pack sealed if you can, wet gear weighs a ton."
  say [role=weather_storm_open] as weather_storm_open:
    "This isn't just rain, {addressee.name}—it's a full-blown storm! We need cover!"
    "Sky's tearing open out here, {addressee.name}! Let's get off the street!"
  say [role=weather_storm_reply] as weather_storm_reply:
    "Right behind you, {addressee.name}—can't hear a thing over this downpour!"
    "Yeah, let's duck into the nearest building before this gets worse!"
  say [role=weather_storm_chime] as weather_storm_chime:
    "Watch the corners—walkers could be ten feet away and we wouldn't hear them in this!"
  say [default] as default:
    "Wet weather out here—stay alert."

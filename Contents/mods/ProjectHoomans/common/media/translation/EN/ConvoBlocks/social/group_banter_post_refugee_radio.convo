# Subject: GROUP BANTER — POST_REFUGEE_RADIO.
language EN
namespace hoomans

extend semantic.banter.group
  say [topic=post_refugee_radio, role=open] (priority 12) as post_refugee_open:
    "Still thinking about {slot.broadcast.topic} we heard earlier, {addressee.name}. Hope those folks are holding on."
  say [topic=post_refugee_radio, role=reply] (priority 12) as post_refugee_reply:
    "Me too, {addressee.name}. It's rough enough out here with a solid crew."
  say [topic=post_refugee_radio, role=chime] (priority 12) as post_refugee_chime:
    "If we cross paths with them, maybe we can lend a hand."
  say [topic=post_refugee_radio, role=wrap] (priority 12) as post_refugee_wrap:
    "Yeah. Let's keep our eyes open for them."

dialogue semantic.combat.ally_warn.reply.engaging
  say [role=wingman, combat.style=shaken] as wingman_shaken:
    "Oh shit, there's more? Stay close, {addressee.name}!"
  say [role=wingman, combat.style=brave] as wingman_brave:
    "I'm ready too, {addressee.name}. Let's finish them."
  say [role=wingman, combat.style=aggressive] as wingman_aggressive:
    "Save one for me, {addressee.name}!"
  say [role=anchor, combat.style=tactical] as anchor_tactical:
    "Rear guard set, {addressee.name}, push forward!"
  say [role=anchor] as anchor_combat:
    "I've got the rear covered, {addressee.name}!"
  say [role=wingman, combat.style=hostile] as wingman_engaging_hostile:
    "Save some of {target.name} for me, {addressee.name}! Going around!"
  say [role=wingman, combat.style=tactical] as wingman_engaging_tactical:
    "Flanking wide, {addressee.name}, keep {target.name} pinned!"
  say [role=wingman] as wingman_engaging_neutral:
    "Right behind you, {addressee.name}! I'll flank {target.name}!"
  say [combat.style=shaken] as engaging_shaken:
    "Oh shit, {addressee.name}, {target.name}?! Stay right by me!"
  say [combat.style=hostile] as engaging_hostile:
    "Got {target.name} in my sights {scene.location}, {addressee.name}! Finishing this!"
  say [combat.style=aggressive] as engaging_aggressive:
    "Hell yeah, {addressee.name}, save {target.name} for me!"
  say [combat.style=exhausted] as engaging_exhausted:
    "I'm beat, {addressee.name}, but I'll still watch your flank."
  say [combat.style=brave] as engaging_brave:
    "I'm ready, {addressee.name}. Let's drop {target.name}."
  say [combat.style=supportive] as engaging_supportive:
    "Stay behind me if it gets ugly, {addressee.name}!"
  say [combat.style=tactical] as engaging_tactical:
    "Visual confirmed on {target.name} {scene.location}, {addressee.name}, engaging!"
  say [default] as engaging_neutral:
    "I see {target.name} {scene.location}, {addressee.name}! Moving in!"

dialogue semantic.combat.ally_warn.reply.alerted
  say [role=wingman, combat.style=shaken] as wingman_shaken:
    "Oh shit, there's more? Stay close, {addressee.name}!"
  say [role=wingman, combat.style=brave] as wingman_brave:
    "I'm ready too, {addressee.name}. Let's finish them."
  say [role=wingman, combat.style=aggressive] as wingman_aggressive:
    "Save one for me, {addressee.name}!"
  say [role=anchor, combat.style=tactical] as anchor_tactical:
    "Rear guard set, {addressee.name}, push forward!"
  say [role=anchor] as anchor_combat:
    "I've got the rear covered, {addressee.name}!"
  say [role=wingman, combat.style=tactical] as wingman_alerted_tactical:
    "Covering your six, {addressee.name}, scanning for {target.name}!"
  say [role=wingman] as wingman_alerted_neutral:
    "Moving up behind you, {addressee.name}! Watching for {target.name}!"
  say [combat.style=shaken] as engaging_shaken:
    "Oh shit, {addressee.name}, {target.name}?! Stay right by me!"
  say [combat.style=hostile] as alerted_hostile:
    "Keep {target.name} busy {scene.location}, {addressee.name}! Coming over now!"
  say [combat.style=aggressive] as engaging_aggressive:
    "Hell yeah, {addressee.name}, save {target.name} for me!"
  say [combat.style=exhausted] as engaging_exhausted:
    "I'm beat, {addressee.name}, but I'll still watch your flank."
  say [combat.style=brave] as engaging_brave:
    "I'm ready, {addressee.name}. Let's drop {target.name}."
  say [combat.style=supportive] as engaging_supportive:
    "Stay behind me if it gets ugly, {addressee.name}!"
  say [combat.style=tactical] as alerted_tactical:
    "Copy contact, {addressee.name}! Scanning for {target.name} {scene.location}!"
  say [default] as alerted_neutral:
    "Heard you, {addressee.name}! Looking for {target.name} {scene.location} now!"

dialogue semantic.combat.ally_warn.reply.defensive
  say [role=blindside_reply] as blindside_reply:
    "Whoa, good catch, {addressee.name}! I'm on it!"
  say [role=swarm_help_reply] as swarm_help_reply:
    "Hang on, {addressee.name}, I'm coming to pull 'em off!"
    "Hold 'em off, {addressee.name}—I'm on my way!"
    "Shit, hold tight {addressee.name}, I've got your back!"
  say [role=swarm_bystander_help_reply] as swarm_bystander_help_reply:
    "Alright, alright, {addressee.name}—I'm moving in!"
    "Shit, sorry {addressee.name}, coming to help right now!"
    "I'm on it, {addressee.name}! Hold tight!"
  say [role=reloading_cover_reply] as reloading_cover_reply:
    "Got you covered, {addressee.name}! Load it up!"
    "Take your time, {addressee.name}, I'll keep 'em off you!"
    "Covering you, {addressee.name}—hurry up with that mag!"
  say [role=last_one_reply] as last_one_reply:
    "Finish it off, {addressee.name}, I've got your back!"
  say [role=cover_bandage] as cover_bandage_reply:
    "I've got you covered, {addressee.name}! Take your time!"
  say [role=injured_has_bandage] as injured_has_bandage_reply:
    "I'm bleeding a bit, {addressee.name}, got bandages on me so I'll patch it up."
  say [role=injured_no_bandage] as injured_no_bandage_reply:
    "I'm bleeding, {addressee.name}, and I'm out of bandages!"
  say [role=medic_has_bandage] as medic_has_bandage_reply:
    "Hang on, {addressee.name}, I've got a spare bandage! Hold still!"
  say [role=medic_no_bandage] as medic_no_bandage_reply:
    "I'm out too, {addressee.name}! Keep pressure on it while we look for bandages!"
  say [role=checkin_ok] as checkin_ok_reply:
    "All good here, {addressee.name}, barely broke a sweat."
  say [role=weather_rain_reply] as weather_rain_reply:
    "Tell me about it, {addressee.name}. Keep your eyes peeled, rain hides their footsteps."
  say [role=cover_winded] as cover_winded:
    "I've got you covered, {addressee.name}! Catch your breath!"
  say [role=wingman] as wingman_defensive:
    "You handle {target.name}, {addressee.name}! I'm staying clear!"
  say [combat.style=shaken] as defensive_shaken:
    "Be careful with {target.name} {scene.location}, {addressee.name}, I'm staying back!"
  say [default] as defensive_neutral:
    "Whoa, {addressee.name}, keeping clear of {target.name} {scene.location}!"

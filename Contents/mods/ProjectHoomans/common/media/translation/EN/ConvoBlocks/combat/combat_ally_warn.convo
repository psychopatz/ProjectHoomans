# Ally combat threat warnings and tactical replies.
language EN
namespace hoomans

dialogue semantic.combat.ally_warn.callout.zombie
  say [role=crawler] as crawler:
    "Watch your feet! Got {target.name} dragging {scene.location}!"
  say [role=blindside] as blindside:
    "Look out, {addressee.name}! Got {target.name} right behind you!"
  say [role=swarm_overwhelmed, combat.style=shaken] as swarm_overwhelmed_shaken:
    "Shit! Shit, {addressee.name}, they're all over me! Help me!"
    "Oh fuck, {addressee.name}, I can't hold 'em! Get these bastards off me!"
    "Goddammit, {addressee.name}, I'm getting torn apart over here!"
  say [role=swarm_overwhelmed, combat.style=hostile] as swarm_overwhelmed_hostile:
    "Fuck! {addressee.name}, get over here! I'm buried in these sons of bitches!"
    "Damn it, {addressee.name}, pull 'em off me before they drag me down!"
  say [role=swarm_overwhelmed, combat.style=tactical] as swarm_overwhelmed_tactical:
    "Damn it, {addressee.name}, position overrun—need immediate backup on me!"
    "{addressee.name}, I'm pinned down by a whole pack! Pull aggro now!"
  say [role=swarm_overwhelmed] as swarm_overwhelmed_default:
    "Shit, {addressee.name}, I'm completely swarmed! Help me out!"
    "Fuck, {addressee.name}, too many on me! Get 'em off!"
    "Damn it, {addressee.name}, I can't shake this swarm—need you right now!"
  say [role=swarm_help, combat.style=shaken] as swarm_help_shaken:
    "Shit, {addressee.name}, there's a pack on me! Give me a hand!"
    "Oh crap, {addressee.name}, I'm getting swarmed here! Help!"
    "{addressee.name}! Too many of 'em—pull a couple off me!"
  say [role=swarm_help, combat.style=hostile] as swarm_help_hostile:
    "Damn it, {addressee.name}, quit standing there and help me clear this pack!"
    "Hell, {addressee.name}, got a whole swarm on my ass—lend a hand!"
  say [role=swarm_help, combat.style=aggressive] as swarm_help_aggressive:
    "Shit, {addressee.name}, these fuckers are piling on me! Come smash a few!"
    "Hey {addressee.name}, got a swarm crowding me—help me thin 'em out!"
  say [role=swarm_help, combat.style=tactical] as swarm_help_tactical:
    "{addressee.name}, I've got a swarm on my position—need flank support!"
    "Getting boxed in here, {addressee.name}, draw a few off me!"
  say [role=swarm_help] as swarm_help_default:
    "Shit, {addressee.name}, I'm swarmed! Need a hand over here!"
    "Damn it, {addressee.name}, got a pack on me—help me clear 'em!"
    "{addressee.name}, I'm getting surrounded! Pull some of 'em off me!"
  say [role=swarm_bystander_help, combat.style=shaken] as swarm_bystander_help_shaken:
    "Hey {addressee.name}, don't just stand there! Help us!!"
    "{addressee.name}, please—don't just watch! Give us a hand!"
    "Shit, {addressee.name}, we're fighting for our lives here—help us!"
  say [role=swarm_bystander_help, combat.style=hostile] as swarm_bystander_help_hostile:
    "Hey {addressee.name}, what the hell are you doing?! Don't just stand there—help us!!"
    "Quit watching, {addressee.name}! Grab a weapon and get your ass in here!"
    "Damn it, {addressee.name}, stop standing around and help us fight!"
  say [role=swarm_bystander_help, combat.style=aggressive] as swarm_bystander_help_aggressive:
    "Hey {addressee.name}! Quit watching the show and help us smash these fuckers!"
    "Seriously, {addressee.name}?! Don't just stand there—jump in!"
  say [role=swarm_bystander_help, combat.style=tactical] as swarm_bystander_help_tactical:
    "{addressee.name}, we're engaged here—get in the fight and cover our flank!"
    "Hey {addressee.name}, don't hang back—we need your weapon in this fight!"
  say [role=swarm_bystander_help] as swarm_bystander_help_default:
    "Hey {addressee.name}, don't just stand there! Help us!!"
    "{addressee.name}! Quit watching and help us out here!"
    "Damn it, {addressee.name}, we could really use a hand right now—jump in!"
  say [role=swarm_rescue_thanks] as swarm_rescue_thanks:
    "Damn, thanks {addressee.name}—thought they had me for a second!"
    "Appreciate the save, {addressee.name}! Owe you one!"
    "Whew—good timing, {addressee.name}, thanks for pulling 'em off!"
  say [role=reloading_panic, combat.style=shaken] as reloading_panic_shaken:
    "Fuckk, get in there dammit! Reloading—{addressee.name}, cover me!"
    "Shit, shit—come on, load already! Keep 'em off me, {addressee.name}!"
    "Oh goddammit, mag won't seat! Cover me, {addressee.name}!"
  say [role=reloading_panic, combat.style=hostile] as reloading_panic_hostile:
    "Fuck, get inserted dammit! {addressee.name}, keep these bastards back while I reload!"
    "Goddammit, I'm dry! Cover my ass, {addressee.name}!"
  say [role=reloading_panic, combat.style=aggressive] as reloading_panic_aggressive:
    "Shit, ran dry! Get in there, you piece of crap—cover me, {addressee.name}!"
    "Fuckk, reloading right in their faces—{addressee.name}, smash 'em back!"
  say [role=reloading_panic, combat.style=tactical] as reloading_panic_tactical:
    "Damn it, mag's dry under pressure! {addressee.name}, suppress 'em while I reload!"
    "Reloading hot—{addressee.name}, hold that lane!"
  say [role=reloading_panic] as reloading_panic_default:
    "Fuckk, get inserted dammit! Reloading, {addressee.name}, cover me!"
    "Shit—come on, come on! {addressee.name}, keep 'em off me while I load!"
    "Damn it, I'm dry right here! Cover me, {addressee.name}!"
  say [role=reloading_cover, combat.style=tactical] as reloading_cover_tactical:
    "Reloading! {addressee.name}, cover my sector!"
    "Mag out, reloading—watch my front, {addressee.name}!"
  say [role=reloading_cover] as reloading_cover_default:
    "Reloading! Cover me, {addressee.name}!"
    "I'm dry—swapping mags, {addressee.name}, watch my back!"
    "Reloading here, {addressee.name}, give me a second!"
  say [role=last_one] as last_one:
    "Just this last one left! Put {target.name} down!"
  say [role=bandaging_self] as bandaging_self:
    "Cover me, {addressee.name}, I'm bandaging up!"
  say [role=bandaging_ally] as bandaging_ally:
    "Cover us {scene.location}, {addressee.name}, I'm bandaging {target.name}!"
  say [role=checkin_injured] as checkin_injured:
    "All clear! Are you okay, {addressee.name}?"
  say [role=checkin_clear] as checkin_clear:
    "That's the last of them, {addressee.name}. Everybody good?"
  say [role=weather_rain_open] as weather_rain_open:
    "Great, it's starting to pour, {addressee.name}. We might want some cover soon."
  say [role=stamina_winded] as stamina_winded:
    "Whoa, {addressee.name}, give me a second to catch my breath."
  say [role=stamina_exhausted] as stamina_exhausted:
    "I'm completely gassed, {addressee.name}! Cover me while I catch my breath!"
  say [combat.style=hostile] as hostile:
    "Drop {target.pronoun}, {addressee.name}! Got {target.name} prowling {scene.location}!"
  say [combat.style=tactical] as tactical:
    "Contact {scene.location}, {addressee.name}, got {target.name}, weapons up!"
  say [default] as neutral:
    "Heads up, {addressee.name}, {target.name} moving {scene.location}!"
    "Watch out, {addressee.name}, {target.name} right {scene.location}!"


# Mod Compatibility: Bandits.
language EN
namespace hoomans

dialogue semantic.compat.bandits.hooman_hurt
  choice bandits.what_happened:
    label: "What happened?"
    say: "What happened?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_WHAT_HAPPENED
  choice bandits.who_attacked:
    label: "Who attacked?"
    say: "Who attacked us?"
    utility: directness
    intent: QUESTION
    subject: CONTEXT_REFERENCE
    reference: EVENT_ATTACKER
  say [social.role=colonist] as colonist:
    "Bandit fire! Pull back and cover the wounded colonist."
  say [social.role=lover] as lover:
    "Bandit fire. Stay close; I have got you."
  say [social.role=family] as family:
    "Bandit fire! Stay together and cover the wounded family member."
  say [default] as default:
    "Bandit fire! Stay with the wounded survivor and watch the flank."

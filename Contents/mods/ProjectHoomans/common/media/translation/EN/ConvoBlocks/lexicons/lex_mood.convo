# Discourse connectors and mood-colored micro-clause lexicons.
language EN
namespace hoomans

lexicon glue.continue
  [default]: "Also," | "On top of that," | "And by the way,"

lexicon glue.shift
  [default]: "Anyway," | "Changing subjects—" | "Moving on,"

lexicon glue.pushback_rude
  [player.shouting]: "Easy, no need to yell—" | "Lower your voice—"
  [player.rude]:     "Watch the tone—" | "No need to snap—" | "Hey, take it easy—"

lexicon glue.followup
  [default]: "Well," | "Like I said," | "Thing is,"

lexicon mood.opener
  [mood.panicked]: "Oh god—" | "Wait—hold on—" | "Keep it quick—"
  [mood.in_pain]:  "Ngh—" | "Ugh, hold on—" | "Easy, it hurts—"
  [npc.fed_up]:     "Seriously—" | "Come on—" | "Look, I already said—"
  [mood.stressed]:  "Look, I'm on edge—" | "Make it quick—"
  [mood.tired]:     "Ugh..." | "Man, I'm beat—"
  [mood.unhappy]:   "Sigh..." | "Whatever..."
  [mood.bored]:     "Finally, something to talk about—" | "Well..."
  [mood.cheerful]:  "Hey!" | "Sure thing!" | "Glad you asked—"

lexicon mood.tail
  [mood.hungry]:    "Could really use some food though." | "Stomach's been growling nonstop."
  [mood.tired]:     "Need some rest before I drop." | "Running on fumes here."
  [mood.stressed]:  "Nerves are shot right now." | "Hard to stay calm out here."
  [mood.bored]:     "Honestly bored out of my mind." | "Nothing much happening around here."
  [mood.unhappy]:   "Just trying to get through the day." | "Not my best day."
  [mood.cheerful]:  "Feeling pretty good today, all things considered."

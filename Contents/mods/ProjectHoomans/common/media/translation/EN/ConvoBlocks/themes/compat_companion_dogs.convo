# Mod Compatibility: Companion Dogs.
language EN
namespace hoomans

flow semantic.compat.companion_dogs.greeting
  say [dog.sex=male] (priority 8) as male:
    "Who is a good boy?"
  say [dog.sex=female] (priority 8) as female:
    "Who is a good girl?"
  say [dog.sex=unknown] (priority 8) as unknown:
    "Who is a good dog?"

flow semantic.compat.companion_dogs.feed
  say [dog.sex=male] (priority 8) as male:
    "Here you go, good boy."
  say [dog.sex=female] (priority 8) as female:
    "Here you go, good girl."
  say [dog.sex=unknown] (priority 8) as unknown:
    "Here you go, good dog."

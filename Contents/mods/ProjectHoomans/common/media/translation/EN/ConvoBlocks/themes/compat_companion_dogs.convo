# Mod Compatibility: Companion Dogs.
language EN
namespace hoomans

dialogue semantic.compat.companion_dogs.greeting
  say [dog.sex=male] as male:
    "Who is a good boy?"
  say [dog.sex=female] as female:
    "Who is a good girl?"
  say [dog.sex=unknown] as unknown:
    "Who is a good dog?"

dialogue semantic.compat.companion_dogs.feed
  say [dog.sex=male] as male:
    "Here you go, good boy."
  say [dog.sex=female] as female:
    "Here you go, good girl."
  say [dog.sex=unknown] as unknown:
    "Here you go, good dog."

{
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.01": "You just made a big mistake.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.02": "All right. You want a fight, you've got one.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.03": "You hit me? You're going to regret that.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.04": "Try that again and see what happens.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.05": "Wrong person to mess with.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.06": "You want some of this?! Come on then!",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.07": "That was your last free shot.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.08": "I'll put you in the ground for that.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.09": "You swung at me? Big mistake.",
  "conversation.content.semantic.combat.player_assaulted.aggressive.neutral.10": "You really want to do this? Let's go.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.01": "That's it. You're done.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.02": "Bad choice. Defend yourself.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.03": "You shouldn't have done that.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.04": "I gave you space. Now defend yourself.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.05": "That's where this ends.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.06": "You made your choice.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.07": "I won't let you hurt me. Stand down or fight.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.08": "Unacceptable. Drop your weapon.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.09": "You crossed the line.",
  "conversation.content.semantic.combat.player_assaulted.brave.neutral.10": "Stand down right now, or I finish this.",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.01": "Why did you do that?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.02": "What the hell is wrong with you?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.03": "Hey! Watch what you're doing!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.04": "Did you just swing at me?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.05": "Are you trying to kill me?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.06": "What are you thinking?! Stop it!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.07": "Whoa! Back off!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.08": "Don't hit me! What's wrong with you?!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.09": "Stop swinging at me!",
  "conversation.content.semantic.combat.player_assaulted.default.neutral.10": "Back away from me!",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.01": "Back off. Now.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.02": "Enough. Stay away from me.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.03": "Step back.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.04": "Do not do that again.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.05": "Don't touch me.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.06": "Last warning.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.07": "Stay back.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.08": "Drop it.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.09": "Keep your distance.",
  "conversation.content.semantic.combat.player_assaulted.reserved.neutral.10": "One step back. Right now.",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.01": "What the hell?! Stay back!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.02": "Why are you attacking me?! Get back!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.03": "Stop! What are you doing?!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.04": "Don't touch me! Are you crazy?!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.05": "Get away from me right now!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.06": "Jesus, back off! Put that away!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.07": "Why would you hit me?! Get back!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.08": "Stay away from me! Don't do this!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.09": "Are you out of your mind?! Stop!",
  "conversation.content.semantic.combat.player_assaulted.shaken.neutral.10": "Back off! Don't come any closer!"
}

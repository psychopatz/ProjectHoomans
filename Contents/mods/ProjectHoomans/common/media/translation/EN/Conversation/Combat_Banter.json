  "UI_PNC_Conversation_Content_SemanticCombatKillKillerReservedFirearm01Neutral09": "Neutralized.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerReservedFirearm01Neutral10": "Done.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral01": "Oh God... there's blood everywhere.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral02": "It's in pieces... I need a second.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral03": "The smell... God, I think I'm gonna be sick.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral04": "I can still feel the crunch...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral05": "It came right at me... had to cut it.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral06": "Hands won't stop trembling...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral07": "Is it really dead? Look at it...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral08": "That was horrible... but it's over.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral09": "God, I hate doing this...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenBladeHead01Neutral10": "Head's gone... let's just step back.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral01": "Jesus... I actually hit it.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral02": "My hands are shaking... but it's down.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral03": "Did I get it? God, I think it's dead.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral04": "That was way too close...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral05": "I panicked and fired... thank God.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral06": "Is it dead? Please tell me it's dead.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral07": "Heart's beating out of my chest...",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral08": "I didn't think that shot would land.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral09": "It's down... don't let another one get close.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenFirearmLow01Neutral10": "God... that sound... it's finally quiet.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral01": "Oh God. I did that with my hands.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral02": "I had to shove it down... my bare hands.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral03": "It almost bit me. Look at my arms shaking.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral04": "I need a weapon. I can't do that again.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral05": "I felt its teeth scrape near my jacket.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral06": "Stomped on its head... God forgive me.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral07": "That was pure desperation.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral08": "My hands are bruised... but I'm alive.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral09": "Never want to be that close again.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerShakenUnarmed01Neutral10": "It's dead... I pushed it off and stomped.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral01": "Got it. You good?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral02": "Threat's down. Check yourself.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral03": "Downed that one. I've got your back.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral04": "Clear! You hurt anywhere?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral05": "Got him off us. Stay close.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral06": "Dropped that one. Keep your eyes open.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral07": "Took care of it. Are you alright?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral08": "Shot landed. You safe?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral09": "Target down. Covering you.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveFirearm01Neutral10": "That one's finished. Watch the flanks.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral01": "It's down. Keep close.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral02": "Got it off you. You alright?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral03": "Downed it. Check your corners.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral04": "I'm right here with you. It's dead.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral05": "Crushed it before it got close.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral06": "Stay behind me. That one's done.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral07": "Took it down. Catch your breath.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral08": "Dead on the floor. You holding up?",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral09": "I've got this line. Watch behind us.",
  "UI_PNC_Conversation_Content_SemanticCombatKillKillerSupportiveMelee01Neutral10": "It's over for that one. We're okay."
}

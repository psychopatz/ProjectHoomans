{
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.01": "Split that rotten head wide open.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.02": "Axe bit deep right into the skull.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.03": "Cleft in two. Stay in the dirt.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.04": "Buried the axe right between its ears.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.05": "Heavy swing. Done for good.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.06": "Crushed the crown with one chop.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.07": "That skull never stood a chance.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.08": "Broke right through bone.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.09": "Split it down to the neck.",
  "conversation.content.semantic.combat.kill.killer.aggressive.axe_head_01.neutral.10": "One hard chop and it's over.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.01": "Took its head clean off.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.02": "Split the skull wide open.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.03": "Severed the spine. Done.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.04": "Nothing stands up without a head.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.05": "Carved right through rotten bone.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.06": "Off with its neck. Stay down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.07": "Sliced it down to the dirt.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.08": "Blade went straight through.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.09": "Head's gone. That one's not getting up.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blade_head_01.neutral.10": "Clean decapitation. Keep moving.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.01": "Felt that one crack.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.02": "Crushed its skull to pieces.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.03": "Smashed that head like a melon.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.04": "Nothing gets up after a hit like that.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.05": "Broke every bone in its face.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.06": "Felt the impact straight up my arms.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.07": "Caved that rotten skull right in.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.08": "Heavy hit. Stay down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.09": "Pounded that one into the floor.",
  "conversation.content.semantic.combat.kill.killer.aggressive.blunt_01.neutral.10": "Cracked wide open. Moving on.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.01": "This {combatWeaponDisplayName} still shoots straight.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.02": "Nothing beats this {combatWeaponDisplayName} when it counts.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.03": "Good old {combatWeaponDisplayName}. Never lets me down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.04": "Told you this {combatWeaponDisplayName} has stopping power.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.05": "That {combatWeaponDisplayName} put it right in the dirt.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.06": "Clean work with the {combatWeaponDisplayName}.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.07": "This {combatWeaponDisplayName} punched right through.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.08": "Glad I had this {combatWeaponDisplayName} ready.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.09": "One round from this {combatWeaponDisplayName} is all it takes.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_01.neutral.10": "The {combatWeaponDisplayName} tore right through its skull.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.01": "Right where I wanted it. Down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.02": "Dropped it in one shot. Beautiful.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.03": "Right between the eyes. Got him.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.04": "That's how you put one down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.05": "Dead on arrival. Love it.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.06": "Drilled that one clean.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.07": "Saw the opening and took it.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.08": "Dropped like a stone.",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.09": "Target down. Who's next?",
  "conversation.content.semantic.combat.kill.killer.aggressive.firearm_high_named_02.neutral.10": "Put that lead right where it hurts.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.01": "That's why I like the reach.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.02": "Punched right through the eye socket.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.03": "Kept my distance and pinned it down.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.04": "Spear through the brain. Done.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.05": "Stuck it before it could touch me.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.06": "Straight thrust. Dropped immediately.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.07": "Punctured the skull cleanly.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.08": "Pinned and dropped. Next target.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.09": "Reach wins every time.",
  "conversation.content.semantic.combat.kill.killer.aggressive.spear_01.neutral.10": "Skewer through the forehead. Over.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.01": "One chop. Done.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.02": "Heavy cleave. Push forward.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.03": "Broke the spine in one stroke. Move.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.04": "Split the skull. Threat eliminated.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.05": "Solid strike. Next target.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.06": "Downed instantly. Keep moving.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.07": "Axe did its work. Advance.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.08": "Clean breach through bone. Proceed.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.09": "That one's finished. Step forward.",
  "conversation.content.semantic.combat.kill.killer.brave.axe_01.neutral.10": "Decisive hit. Don't stop now.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.01": "Clean cut. Next.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.02": "Head severed. Move up.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.03": "Blade struck true. Keep the line.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.04": "One strike. Proceed.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.05": "Downed without breaking stride.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.06": "Decapitated. Clear the path.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.07": "Threat down. Maintain vigilance.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.08": "Firm strike. Moving ahead.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.09": "Head neutralized. Don't linger.",
  "conversation.content.semantic.combat.kill.killer.brave.blade_head_01.neutral.10": "Swift cut. Let's keep moving.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.01": "Dead center. Keep moving.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.02": "Clean hit. Advance.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.03": "Downed. Scanning the next sector.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.04": "One shot, one down. Keep pace.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.05": "Target eliminated. Form up.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.06": "Precise shot. Push through.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.07": "Threat neutralized. Eyes ahead.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.08": "Confirmed kill. Move forward.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.09": "Handled. Watch your spacing.",
  "conversation.content.semantic.combat.kill.killer.brave.firearm_high_01.neutral.10": "Center mass then head. Done.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.01": "Kept it right where I wanted it.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.02": "Direct thrust. Target down.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.03": "Distance held, kill confirmed.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.04": "Spear struck true. Advance.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.05": "Pinned down and finished. Move.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.06": "Clean breach from outside reach.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.07": "Neutralized at range. Proceed.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.08": "No risk taken. Push through.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.09": "Impaled. Path is clear.",
  "conversation.content.semantic.combat.kill.killer.brave.spear_01.neutral.10": "Firm thrust to the skull. Done.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.01": "Head came apart. Moving on.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.02": "Severed at the neck. Proceed.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.03": "Anatomical destruction complete.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.04": "Ceased function. Next.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.05": "Cranium broken. Moving forward.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.06": "Irreversible damage. Clear.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.07": "Neck cleaved. Done.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.08": "No remaining reflex. Move.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.09": "Head split. Continue.",
  "conversation.content.semantic.combat.kill.killer.cold.blade_head_01.neutral.10": "Decapitation verified.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.01": "Clean shot.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.02": "Target expired. Moving.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.03": "Zero waste. Proceed.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.04": "Bullet found the brain. Next.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.05": "Dropped efficiently.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.06": "Threat terminated.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.07": "Simple precision.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.08": "One less obstacle.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.09": "Expired instantly.",
  "conversation.content.semantic.combat.kill.killer.cold.firearm_high_01.neutral.10": "Path opened.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.01": "Crushed it.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.02": "Structural skull collapse. Done.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.03": "Pulverized. Moving on.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.04": "Impact sufficient. Next.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.05": "Ceased all motor function.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.06": "Crushed flat.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.07": "Bones splintered. Clear.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.08": "Force delivered. Finished.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.09": "Obliterated. Advance.",
  "conversation.content.semantic.combat.kill.killer.cold.heavy_melee_01.neutral.10": "Skull collapsed inward.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.01": "Good reach. Keep the line.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.02": "Kept our distance. That worked.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.03": "Leverage did the work. Push ahead.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.04": "Safe distance maintained. Next.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.05": "Good weapon range. Watch the side.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.06": "Clean penetration. Check haft condition.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.07": "Hit before it closed in. Form up.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.08": "Distance kept us safe. Continue.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.09": "Controlled engagement. Move forward.",
  "conversation.content.semantic.combat.kill.killer.practical.axe_spear_01.neutral.10": "Reach kept teeth off us. Proceed.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.01": "Blade did its job. Keep moving.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.02": "Clean cut. Check blade edge.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.03": "Down without wasting noise.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.04": "Quiet kill. Keep your eyes sharp.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.05": "Severed cleanly. Don't let your guard down.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.06": "One silent drop. Keep the pace.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.07": "Edge held up fine. Move ahead.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.08": "Target down quietly. Scan the hall.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.09": "No ammo burned. Good.",
  "conversation.content.semantic.combat.kill.killer.practical.blade_01.neutral.10": "Dropped it silently. Watch the rear.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.01": "Crushed it. Watch the next one.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.02": "Broke the skull. Check weapon wear.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.03": "Solid blunt trauma. Move ahead.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.04": "Effective hit. Keep your footing solid.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.05": "Downed. Don't exhaust yourself swinging.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.06": "Cracked through. Scan the surroundings.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.07": "Heavy strike finished it. Advance.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.08": "Impact neutralized the threat. Check corners.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.09": "Good hit. Conserve stamina.",
  "conversation.content.semantic.combat.kill.killer.practical.blunt_01.neutral.10": "Done. Step over and keep scanning.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.01": "Good shot placement. Check the lane.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.02": "One round spent. Check your corners.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.03": "Target down. Scan before advancing.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.04": "Clean shot. Keep ammunition in mind.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.05": "Dropped it cleanly. Watch for flankers.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.06": "Down. Keep your weapon raised.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.07": "Threat eliminated. Count your rounds.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.08": "Solid hit. Keep moving methodically.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.09": "Target neutralized. Check the perimeter.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_high_01.neutral.10": "Shot connected well. Don't rush ahead.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.01": "Hit it. Don't count on luck twice.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.02": "Took two shots, but it's down.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.03": "Messy hit, but it did the job.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.04": "Downed. Check remaining ammo now.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.05": "Wasted a round there. Settle your aim.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.06": "It's on the floor. Reload if needed.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.07": "Hit the mark eventually. Stay focused.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.08": "Threat down. Don't get sloppy.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.09": "Barely got that in time. Reset.",
  "conversation.content.semantic.combat.kill.killer.practical.firearm_low_01.neutral.10": "Downed. Watch the noise level.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.01": "It's down. I need a weapon.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.02": "Managed that barehanded, but find me something to swing.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.03": "Too close for comfort. We need gear.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.04": "Took it down, but I can't keep doing that.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.05": "It's dead. Look around for any weapon.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.06": "Shoved and stomped. Get me something sharp.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.07": "Risky move. Need proper tools.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.08": "Downed it without gear. Won't get lucky twice.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.09": "Bare hands worked once. Find weapons now.",
  "conversation.content.semantic.combat.kill.killer.practical.unarmed_01.neutral.10": "Bruised knuckles, but it's dead. Gear up.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.01": "Cut down.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.02": "Head severed.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.03": "Down.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.04": "Done.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.05": "Clear.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.06": "Finished.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.07": "Eliminated.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.08": "Fell.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.09": "Clean strike.",
  "conversation.content.semantic.combat.kill.killer.reserved.blade_01.neutral.10": "Moving.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.01": "Hit.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.02": "Down.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.03": "Target neutral.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.04": "One round.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.05": "Clear.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.06": "Eliminated.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.07": "Dropped.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.08": "Shot connected.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.09": "Neutralized.",
  "conversation.content.semantic.combat.kill.killer.reserved.firearm_01.neutral.10": "Done.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.01": "Oh God... there's blood everywhere.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.02": "It's in pieces... I need a second.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.03": "The smell... God, I think I'm gonna be sick.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.04": "I can still feel the crunch...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.05": "It came right at me... had to cut it.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.06": "Hands won't stop trembling...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.07": "Is it really dead? Look at it...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.08": "That was horrible... but it's over.",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.09": "God, I hate doing this...",
  "conversation.content.semantic.combat.kill.killer.shaken.blade_head_01.neutral.10": "Head's gone... let's just step back.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.01": "Jesus... I actually hit it.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.02": "My hands are shaking... but it's down.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.03": "Did I get it? God, I think it's dead.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.04": "That was way too close...",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.05": "I panicked and fired... thank God.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.06": "Is it dead? Please tell me it's dead.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.07": "Heart's beating out of my chest...",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.08": "I didn't think that shot would land.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.09": "It's down... don't let another one get close.",
  "conversation.content.semantic.combat.kill.killer.shaken.firearm_low_01.neutral.10": "God... that sound... it's finally quiet.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.01": "Oh God. I did that with my hands.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.02": "I had to shove it down... my bare hands.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.03": "It almost bit me. Look at my arms shaking.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.04": "I need a weapon. I can't do that again.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.05": "I felt its teeth scrape near my jacket.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.06": "Stomped on its head... God forgive me.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.07": "That was pure desperation.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.08": "My hands are bruised... but I'm alive.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.09": "Never want to be that close again.",
  "conversation.content.semantic.combat.kill.killer.shaken.unarmed_01.neutral.10": "It's dead... I pushed it off and stomped.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.01": "Got it. You good?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.02": "Threat's down. Check yourself.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.03": "Downed that one. I've got your back.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.04": "Clear! You hurt anywhere?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.05": "Got him off us. Stay close.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.06": "Dropped that one. Keep your eyes open.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.07": "Took care of it. Are you alright?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.08": "Shot landed. You safe?",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.09": "Target down. Covering you.",
  "conversation.content.semantic.combat.kill.killer.supportive.firearm_01.neutral.10": "That one's finished. Watch the flanks.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.01": "It's down. Keep close.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.02": "Got it off you. You alright?",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.03": "Downed it. Check your corners.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.04": "I'm right here with you. It's dead.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.05": "Crushed it before it got close.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.06": "Stay behind me. That one's done.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.07": "Took it down. Catch your breath.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.08": "Dead on the floor. You holding up?",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.09": "I've got this line. Watch behind us.",
  "conversation.content.semantic.combat.kill.killer.supportive.melee_01.neutral.10": "It's over for that one. We're okay."
}
